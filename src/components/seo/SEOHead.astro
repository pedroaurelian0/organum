---
/**
 * SEOHead.astro
 * Gerencia todas as meta tags, OG, Twitter Card e links de performance.
 * Incluir dentro do <head> via layouts.
 */

interface Props {
  /** Título da página — não incluir sufixo "| Organum", o componente adiciona */
  title: string;
  /** Meta description — máx 160 chars */
  description: string;
  /** URL canônica — default: URL atual */
  canonical?: string;
  /** Open Graph type */
  ogType?: 'website' | 'article' | 'profile';
  /** URL absoluta da imagem OG (1200×630) */
  ogImage?: string;
  /** Alt text da imagem OG */
  ogImageAlt?: string;
  /** ISO date — somente para ogType === 'article' */
  articlePublishedTime?: string;
  /** ISO date — somente para ogType === 'article' */
  articleModifiedTime?: string;
  /** Nome do autor — somente para ogType === 'article' */
  articleAuthor?: string;
  /** Se true, adiciona noindex à meta robots */
  noindex?: boolean;
  /** Se true, adiciona nofollow à meta robots */
  nofollow?: boolean;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogType = 'website',
  ogImage = 'https://organum.com.br/images/og-default.jpg',
  ogImageAlt = 'Organum — Agência de SEO orgânico B2B',
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor = 'Pedro Aureliano',
  noindex = false,
  nofollow = false,
} = Astro.props;

const pageTitle = title.includes('Organum') ? title : `${title} | Organum`;
const robotsContent = [
  noindex ? 'noindex' : 'index',
  nofollow ? 'nofollow' : 'follow',
].join(', ');
---

<!-- Charset e viewport -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<!-- Title e description -->
<title>{pageTitle}</title>
<meta name="description" content={description} />

<!-- Robots -->
<meta name="robots" content={robotsContent} />

<!-- Canonical -->
<link rel="canonical" href={canonical} />

<!-- Open Graph -->
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="Organum" />
<meta property="og:locale" content="pt_BR" />

<!-- Article-specific OG tags -->
{ogType === 'article' && articlePublishedTime && (
  <meta property="article:published_time" content={articlePublishedTime} />
)}
{ogType === 'article' && articleModifiedTime && (
  <meta property="article:modified_time" content={articleModifiedTime} />
)}
{ogType === 'article' && (
  <meta property="article:author" content={articleAuthor} />
)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Performance: preconnect + fontes não-bloqueantes -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="preload"
  as="style"
  href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,400;1,700&family=DM+Sans:wght@400;500;600&display=swap"
/>
<link
  href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,400;1,700&family=DM+Sans:wght@400;500;600&display=swap"
  rel="stylesheet"
  media="print"
  onload="this.media='all'"
/>
<noscript>
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,400;1,700&family=DM+Sans:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
</noscript>

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Generator tag (Astro) -->
<meta name="generator" content={Astro.generator} />
