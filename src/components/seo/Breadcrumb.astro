---
import SchemaOrg from './SchemaOrg.astro';

interface BreadcrumbItem {
  name: string;
  url: string;
}
interface Props {
  items: BreadcrumbItem[];
}
const { items } = Astro.props;
const BASE = 'https://organum.com.br';
const allItems: BreadcrumbItem[] = [{ name: 'Home', url: `${BASE}/` }, ...items];

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: allItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: item.url.startsWith('http') ? item.url : `${BASE}${item.url}`,
  })),
};
---

<SchemaOrg schema={breadcrumbSchema} />

<nav aria-label="Breadcrumb">
  <ol style="display:flex;flex-wrap:wrap;align-items:center;gap:.375rem;list-style:none;padding:0;margin:0;">
    {allItems.map((item, index) => {
      const isLast = index === allItems.length - 1;
      return (
        <li style="display:flex;align-items:center;gap:.375rem;">
          {isLast ? (
            <span style="font-size:.75rem;font-weight:600;color:var(--n600);" aria-current="page">
              {item.name}
            </span>
          ) : (
            <>
              <a href={item.url} style="font-size:.75rem;font-weight:500;color:var(--n400);text-decoration:none;transition:color .15s;" onmouseover="this.style.color='var(--n700)'" onmouseout="this.style.color='var(--n400)'">
                {item.name}
              </a>
              <span style="font-size:.65rem;color:var(--n300);user-select:none;" aria-hidden="true">/</span>
            </>
          )}
        </li>
      );
    })}
  </ol>
</nav>
