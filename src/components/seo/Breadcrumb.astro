---
/**
 * Breadcrumb.astro
 * Renderiza navegação de breadcrumb acessível + BreadcrumbList Schema.
 * O item "Home" é adicionado automaticamente como primeiro item.
 */
import SchemaOrg from './SchemaOrg.astro';

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

const BASE = 'https://organum.com.br';

// Prepend Home automaticamente
const allItems: BreadcrumbItem[] = [
  { name: 'Home', url: `${BASE}/` },
  ...items,
];

// Montar BreadcrumbList Schema
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: allItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: item.url.startsWith('http') ? item.url : `${BASE}${item.url}`,
  })),
};
---

<SchemaOrg schema={breadcrumbSchema} />

<nav aria-label="Breadcrumb" class="py-3">
  <ol class="flex flex-wrap items-center gap-1.5 text-sm text-ink-400">
    {allItems.map((item, index) => {
      const isLast = index === allItems.length - 1;
      return (
        <li class="flex items-center gap-1.5">
          {isLast ? (
            <span class="text-ink-600 font-medium" aria-current="page">
              {item.name}
            </span>
          ) : (
            <>
              <a
                href={item.url}
                class="hover:text-brand-600 transition-colors no-underline"
              >
                {item.name}
              </a>
              <span aria-hidden="true" class="text-ink-200 select-none">
                /
              </span>
            </>
          )}
        </li>
      );
    })}
  </ol>
</nav>
