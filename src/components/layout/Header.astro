---
const navLinks = [
  { label: 'Método',   href: '/metodo' },
  { label: 'Serviços', href: '/servicos' },
  { label: 'Cases',    href: '/cases' },
  { label: 'Blog',     href: '/blog' },
  { label: 'Sobre',    href: '/sobre' },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap" style="display:flex;align-items:center;justify-content:space-between;height:64px;gap:2rem;">

    <a href="/" style="display:flex;align-items:baseline;gap:.625rem;text-decoration:none;flex-shrink:0;">
      <span style="font-family:var(--font-serif);font-size:1.375rem;font-weight:700;color:var(--color-n-950);letter-spacing:-.02em;">Organum</span>
      <span style="font-size:.6rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--color-g-600);border:1px solid var(--color-g-200);padding:.2rem .5rem;background:var(--color-g-50);line-height:1;">SEO B2B</span>
    </a>

    <nav id="desktop-nav" style="display:flex;align-items:center;gap:0;flex:1;justify-content:center;">
      {navLinks.map((link) => {
        const active = path.startsWith(link.href);
        return (
          <a
            href={link.href}
            style={`display:block;padding:.5rem 1rem;font-size:.8125rem;font-weight:500;color:${active?'var(--color-n-950)':'var(--color-n-400)'};text-decoration:none;transition:color .15s;position:relative;`}
            class={active ? 'nav-active' : 'nav-item'}
          >
            {link.label}
            {active && <span style="position:absolute;bottom:-1px;left:1rem;right:1rem;height:1px;background:var(--color-n-950);"></span>}
          </a>
        );
      })}
    </nav>

    <div style="display:flex;align-items:center;gap:.75rem;flex-shrink:0;">
      <a href="/auditoria-gratuita" class="btn btn-dark header-cta" style="padding:.6rem 1.125rem;font-size:.75rem;white-space:nowrap;">
        Auditoria gratuita
      </a>
      <button id="burger" aria-label="Menu" style="display:none;background:none;border:none;cursor:pointer;padding:.35rem;color:var(--color-n-700);">
        <svg width="22" height="16" viewBox="0 0 22 16" fill="none">
          <rect y="0"  width="22" height="1.5" rx=".75" fill="currentColor"/>
          <rect y="7"  width="22" height="1.5" rx=".75" fill="currentColor"/>
          <rect y="14" width="22" height="1.5" rx=".75" fill="currentColor"/>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" style="display:none;border-top:1px solid var(--color-n-100);">
    <div style="padding:1rem clamp(1rem,4vw,3rem) 1.5rem;display:flex;flex-direction:column;gap:.125rem;">
      {navLinks.map((link) => (
        <a href={link.href} style="padding:.75rem 0;font-size:.9375rem;color:var(--color-n-700);border-bottom:1px solid var(--color-n-100);display:block;">
          {link.label}
        </a>
      ))}
      <a href="/auditoria-gratuita" class="btn btn-dark" style="margin-top:1rem;justify-content:center;text-align:center;">
        Auditoria gratuita
      </a>
    </div>
  </div>
</header>

<style>
.nav-item:hover { color: var(--color-n-700) !important; }
@media (max-width: 768px) {
  #desktop-nav { display: none !important; }
  #burger { display: block !important; }
  .header-cta { display: none !important; }
}
</style>

<script>
document.getElementById('burger')?.addEventListener('click', () => {
  const m = document.getElementById('mobile-nav');
  if (m) m.style.display = m.style.display === 'block' ? 'none' : 'block';
});
</script>
