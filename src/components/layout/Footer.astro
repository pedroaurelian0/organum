---
const year = new Date().getFullYear();

const footerLinks = {
  Serviços: [
    { label: 'SEO Técnico', href: '/servicos/seo-tecnico' },
    { label: 'GEO + AEO', href: '/servicos/geo-aeo' },
    { label: 'Conteúdo de Autoridade', href: '/servicos/conteudo' },
    { label: 'Link Building', href: '/servicos/link-building' },
    { label: 'SEO B2B', href: '/servicos/seo-b2b' },
    { label: 'SEO E-commerce', href: '/servicos/seo-ecommerce' },
  ],
  Método: [
    { label: 'Visão geral', href: '/metodo' },
    { label: '01 Fundação técnica', href: '/metodo/fundacao' },
    { label: '02 Identidade de entidade', href: '/metodo/entidade' },
    { label: '03 Conteúdo de autoridade', href: '/metodo/conteudo' },
    { label: '04 GEO + AEO', href: '/metodo/geo-aeo' },
    { label: '05 Digital PR', href: '/metodo/digital-pr' },
  ],
  Empresa: [
    { label: 'Sobre a Organum', href: '/sobre' },
    { label: 'Pedro Aureliano', href: '/sobre/pedro-aureliano' },
    { label: 'Cases', href: '/cases' },
    { label: 'Blog', href: '/blog' },
    { label: 'Auditoria gratuita', href: '/auditoria-gratuita' },
    { label: 'Contato', href: '/contato' },
  ],
};
---

<footer class="bg-ink-950 text-ink-300 mt-24">
  <div class="container-page pt-16 pb-10">

    <!-- Top: logo + descrição + links -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">

      <!-- Coluna 1: marca -->
      <div class="lg:col-span-1">
        <a href="/" class="inline-block text-2xl font-bold text-white no-underline mb-4">
          Organum
        </a>
        <p class="text-sm text-ink-400 leading-relaxed mb-5">
          Agência de SEO orgânico B2B especializada no Método ORGANUM — as 5 camadas que levam empresas do zero técnico à citação por IA.
        </p>
        <p class="text-xs text-ink-500">
          Recife, PE — atendimento nacional e internacional
        </p>
      </div>

      <!-- Colunas 2–4: links -->
      {Object.entries(footerLinks).map(([category, links]) => (
        <div>
          <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">
            {category}
          </h3>
          <ul class="space-y-2.5">
            {links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-ink-400 hover:text-white transition-colors no-underline"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- CTA banner -->
    <div class="border border-ink-800 rounded-xl p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-10">
      <div>
        <p class="text-white font-semibold">Pronto para parar de depender de tráfego pago?</p>
        <p class="text-sm text-ink-400 mt-1">Solicite uma auditoria gratuita e receba o diagnóstico técnico em 48 horas.</p>
      </div>
      <a href="/auditoria-gratuita" class="btn-primary whitespace-nowrap flex-shrink-0 text-sm">
        Auditoria gratuita
      </a>
    </div>

    <!-- Bottom: copyright e legais -->
    <div class="border-t border-ink-800 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-ink-500">
      <p>© {year} Organum. Todos os direitos reservados.</p>
      <div class="flex gap-5">
        <a href="/privacidade" class="hover:text-ink-300 transition-colors no-underline">Privacidade</a>
        <a href="/termos" class="hover:text-ink-300 transition-colors no-underline">Termos de uso</a>
      </div>
    </div>

  </div>
</footer>
