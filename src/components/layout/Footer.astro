---
const year = new Date().getFullYear();
const cols = {
  'Serviços': [
    ['SEO Técnico',      '/servicos/seo-tecnico'],
    ['GEO + AEO',        '/servicos/geo-aeo'],
    ['Conteúdo',         '/servicos/conteudo'],
    ['Link Building',    '/servicos/link-building'],
    ['SEO B2B',          '/servicos/seo-b2b'],
    ['SEO E-commerce',   '/servicos/seo-ecommerce'],
  ],
  'Método': [
    ['Visão geral',              '/metodo'],
    ['01 Fundação técnica',      '/metodo/fundacao'],
    ['02 Identidade de entidade','/metodo/entidade'],
    ['03 Conteúdo de autoridade','/metodo/conteudo'],
    ['04 GEO + AEO',             '/metodo/geo-aeo'],
    ['05 Digital PR',            '/metodo/digital-pr'],
  ],
  'Empresa': [
    ['Sobre a Organum',     '/sobre'],
    ['Pedro Aureliano',     '/sobre/pedro-aureliano'],
    ['Cases',               '/cases'],
    ['Blog',                '/blog'],
    ['Auditoria gratuita',  '/auditoria-gratuita'],
  ],
};
---

<footer class="site-footer">
  <div class="wrap">

    <!-- Top -->
    <div style="display:grid;grid-template-columns:1.5fr repeat(3,1fr);gap:3rem;padding-bottom:3rem;border-bottom:1px solid rgba(255,255,255,.08);"
         class="footer-grid">
      <div>
        <div class="footer-logo">Organum</div>
        <p style="margin-top:1rem;font-size:.875rem;line-height:1.7;color:rgba(255,255,255,.4);max-width:26ch;">
          As 5 camadas que levam empresas B2B do zero técnico à citação por IA.
        </p>
        <p style="margin-top:1rem;font-size:.75rem;color:rgba(255,255,255,.25);letter-spacing:.05em;">
          Recife, PE — atendimento nacional e internacional
        </p>
      </div>

      {Object.entries(cols).map(([title, links]) => (
        <div>
          <p class="footer-col-title">{title}</p>
          {links.map(([label, href]) => (
            <a href={href} class="footer-link">{label}</a>
          ))}
        </div>
      ))}
    </div>

    <!-- CTA strip -->
    <div style="padding:2.5rem 0;border-bottom:1px solid rgba(255,255,255,.08);display:flex;align-items:center;justify-content:space-between;gap:2rem;flex-wrap:wrap;">
      <div>
        <p style="font-family:var(--font-serif);font-size:1.375rem;font-weight:700;color:white;line-height:1.2;">
          Pronto para parar de depender de tráfego pago?
        </p>
        <p style="font-size:.875rem;color:rgba(255,255,255,.4);margin-top:.5rem;">
          Diagnóstico técnico gratuito em até 48 horas.
        </p>
      </div>
      <a href="/auditoria-gratuita" class="btn btn-green" style="white-space:nowrap;flex-shrink:0;">
        Auditoria gratuita
      </a>
    </div>

    <!-- Bottom -->
    <div style="padding-top:1.75rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;">
      <p style="font-size:.75rem;color:rgba(255,255,255,.2);">© {year} Organum. Todos os direitos reservados.</p>
      <div style="display:flex;gap:1.5rem;">
        <a href="/privacidade" class="footer-link" style="font-size:.75rem;">Privacidade</a>
        <a href="/termos" class="footer-link" style="font-size:.75rem;">Termos</a>
        <a href="/contato" class="footer-link" style="font-size:.75rem;">Contato</a>
      </div>
    </div>

  </div>
</footer>

<style>
@media (max-width: 768px) {
  .footer-grid { grid-template-columns: 1fr 1fr !important; }
}
@media (max-width: 480px) {
  .footer-grid { grid-template-columns: 1fr !important; }
}
</style>
