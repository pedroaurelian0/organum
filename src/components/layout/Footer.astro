---
const year = new Date().getFullYear();
const cols = {
  'Serviços': [
    ['SEO Técnico',      '/servicos/seo-tecnico'],
    ['GEO + AEO',        '/servicos/geo-aeo'],
    ['Conteúdo',         '/servicos/conteudo'],
    ['Link Building',    '/servicos/link-building'],
    ['SEO B2B',          '/servicos/seo-b2b'],
    ['SEO E-commerce',   '/servicos/seo-ecommerce'],
  ],
  'Método': [
    ['Visão geral',              '/metodo'],
    ['01 Fundação técnica',      '/metodo/fundacao'],
    ['02 Identidade de entidade','/metodo/entidade'],
    ['03 Conteúdo de autoridade','/metodo/conteudo'],
    ['04 GEO + AEO',             '/metodo/geo-aeo'],
    ['05 Digital PR',            '/metodo/digital-pr'],
  ],
  'Empresa': [
    ['Sobre a Organum',     '/sobre'],
    ['Pedro Aureliano',     '/sobre/pedro-aureliano'],
    ['Cases',               '/cases'],
    ['Blog',                '/blog'],
    ['Auditoria gratuita',  '/auditoria-gratuita'],
  ],
};
---

<footer class="site-footer">
  <div class="wrap">

    <div class="footer-top">

      <!-- Coluna brand -->
      <div class="footer-brand-col">
        <a href="/" class="footer-logo">Organum</a>
        <p class="footer-desc">
          As 5 camadas que levam empresas B2B do zero técnico à citação por IA.
        </p>
        <p class="footer-location">Recife, PE — atendimento nacional e internacional</p>
      </div>

      <!-- Colunas de links -->
      {Object.entries(cols).map(([title, links]) => (
        <div class="footer-col">
          <p class="footer-col-title">{title}</p>
          <ul class="footer-links">
            {links.map(([label, href]) => (
              <li><a href={href} class="footer-link">{label}</a></li>
            ))}
          </ul>
        </div>
      ))}

    </div>

    <!-- CTA strip -->
    <div class="footer-cta-strip">
      <div>
        <p class="footer-cta-title">Pronto para parar de depender de tráfego pago?</p>
        <p class="footer-cta-sub">Diagnóstico técnico gratuito em até 48 horas.</p>
      </div>
      <a href="/auditoria-gratuita" class="btn btn-green" style="white-space:nowrap;flex-shrink:0;">
        Auditoria gratuita
      </a>
    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <p class="footer-copy">© {year} Organum. Todos os direitos reservados.</p>
      <nav class="footer-legal">
        <a href="/privacidade" class="footer-link">Privacidade</a>
        <a href="/termos" class="footer-link">Termos</a>
        <a href="/contato" class="footer-link">Contato</a>
      </nav>
    </div>

  </div>
</footer>

<style>
/* ── Footer layout ── */
.site-footer {
  background: var(--n950);
  color: rgba(255,255,255,.4);
  padding-block: clamp(3rem,6vw,5rem);
}

.footer-top {
  display: grid;
  grid-template-columns: 1.75fr 1fr 1fr 1fr;
  gap: 3rem;
  padding-bottom: 3rem;
  border-bottom: 1px solid rgba(255,255,255,.08);
}

.footer-logo {
  font-family: var(--font-serif);
  font-size: 1.25rem;
  font-weight: 700;
  color: #fff;
  letter-spacing: -.02em;
  display: block;
  margin-bottom: 1rem;
  text-decoration: none;
}
.footer-desc {
  font-size: .875rem;
  line-height: 1.7;
  color: rgba(255,255,255,.4);
  max-width: 26ch;
  margin-bottom: .75rem;
}
.footer-location {
  font-size: .75rem;
  color: rgba(255,255,255,.22);
  letter-spacing: .04em;
}

.footer-col-title {
  font-size: .65rem;
  font-weight: 700;
  letter-spacing: .15em;
  text-transform: uppercase;
  color: rgba(255,255,255,.25);
  margin-bottom: 1.25rem;
}
.footer-links {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: .625rem;
}
.footer-link {
  font-size: .8125rem;
  color: rgba(255,255,255,.4);
  transition: color .15s;
  text-decoration: none;
  display: block;
}
.footer-link:hover { color: rgba(255,255,255,.85); }

/* CTA strip */
.footer-cta-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  flex-wrap: wrap;
  padding-block: 2.5rem;
  border-bottom: 1px solid rgba(255,255,255,.08);
}
.footer-cta-title {
  font-family: var(--font-serif);
  font-size: 1.375rem;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
  margin-bottom: .375rem;
}
.footer-cta-sub {
  font-size: .875rem;
  color: rgba(255,255,255,.4);
}

/* Bottom */
.footer-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1rem;
  padding-top: 1.75rem;
}
.footer-copy { font-size: .75rem; color: rgba(255,255,255,.2); }
.footer-legal { display: flex; gap: 1.5rem; }

/* Responsive */
@media (max-width: 1024px) {
  .footer-top { grid-template-columns: 1fr 1fr 1fr; }
  .footer-brand-col { grid-column: 1 / -1; }
  .footer-top > .footer-brand-col + .footer-col,
  .footer-top > .footer-brand-col + .footer-col + .footer-col,
  .footer-top > .footer-brand-col + .footer-col + .footer-col + .footer-col {
    grid-column: auto;
  }
}
@media (max-width: 768px) {
  .footer-top { grid-template-columns: 1fr 1fr; gap: 2rem; }
  .footer-brand-col { grid-column: 1 / -1; }
}
@media (max-width: 480px) {
  .footer-top { grid-template-columns: 1fr; }
  .footer-cta-strip { flex-direction: column; align-items: flex-start; }
}
</style>
