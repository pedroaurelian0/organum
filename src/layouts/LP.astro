---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  schemaExtra?: Record<string, unknown>[];
}

const { title, description, canonical, ogImage, noindex, schemaExtra } = Astro.props;
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  ogType="website"
  ogImage={ogImage}
  noindex={noindex}
  schemaExtra={schemaExtra}
>
  <!-- Sem Header/Footer: máxima conversão sem distrações -->
  <slot />
</Base>
