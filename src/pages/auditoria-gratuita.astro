---
import Base from '@layouts/Base.astro';
import SchemaOrg from '@components/seo/SchemaOrg.astro';

const schemaService = {
  '@type': 'Service',
  name: 'Auditoria de SEO Gratuita',
  description: 'Análise técnica gratuita de SEO: Core Web Vitals, arquitetura, Schema Markup e potencial de citação por IA. Resposta em até 48 horas.',
  provider: { '@type': 'Organization', '@id': 'https://organum.com.br/#organization' },
  areaServed: { '@type': 'Country', name: 'Brasil' },
};
---

<Base
  title="Auditoria de SEO gratuita para B2B | Resposta em 48 horas — Organum"
  description="Análise técnica gratuita do seu site: Core Web Vitals, Schema Markup, entidade digital e potencial de citação por IA. Pedro Aureliano responde em 48 horas."
  canonical="https://organum.com.br/auditoria-gratuita/"
  schemaExtra={[schemaService]}
>
<SchemaOrg schema={schemaService} />

<header style="background:var(--n950);border-bottom:1px solid rgba(255,255,255,.06);padding:.875rem clamp(1rem,4vw,3rem);position:sticky;top:0;z-index:100;">
  <div style="max-width:1280px;margin-inline:auto;display:flex;align-items:center;justify-content:space-between;">
    <a href="/" style="font-family:var(--serif);font-size:1.25rem;font-weight:700;color:#fff;text-decoration:none;letter-spacing:-.02em;">Organum</a>
    <div style="display:flex;align-items:center;gap:.5rem;">
      <span style="width:7px;height:7px;background:var(--g400);border-radius:50%;animation:pulse-dot 2s ease-in-out infinite;display:inline-block;"></span>
      <span style="font-size:.75rem;font-weight:600;color:rgba(255,255,255,.5);">Auditoria gratuita — sem compromisso</span>
    </div>
  </div>
</header>

<section style="background:var(--n950);padding:clamp(4rem,10vh,7rem) clamp(1rem,4vw,3rem) clamp(3rem,7vh,5rem);overflow:hidden;position:relative;">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.03) 1px,transparent 1px);background-size:60px 60px;pointer-events:none;"></div>
  <div style="position:absolute;top:-20%;left:50%;transform:translateX(-50%);width:800px;height:400px;background:radial-gradient(ellipse at center,rgba(46,145,71,.12) 0%,transparent 70%);pointer-events:none;"></div>
  <div style="max-width:960px;margin-inline:auto;position:relative;z-index:1;text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:.625rem;background:rgba(46,145,71,.12);border:1px solid rgba(76,175,100,.3);padding:.4rem 1.25rem;border-radius:999px;margin-bottom:2rem;">
      <span style="width:6px;height:6px;background:var(--g400);border-radius:50%;animation:pulse-dot 2s ease-in-out infinite;display:inline-block;"></span>
      <span style="font-size:.7rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--g400);">Diagn&#xF3;stico t&#xE9;cnico completo &#x2014; 100% gratuito</span>
    </div>
    <h1 style="font-family:var(--serif);font-size:clamp(2.5rem,6.5vw,5.5rem);font-weight:900;line-height:.93;letter-spacing:-.035em;color:#fff;margin-bottom:1.75rem;">
      Enquanto voc&#xEA; l&#xEA; isso,<br/>
      <em style="color:var(--g400);font-style:italic;">seu concorrente est&#xE1; sendo citado pelo ChatGPT.</em>
    </h1>
    <p style="font-size:clamp(1rem,2vw,1.25rem);color:rgba(255,255,255,.55);line-height:1.7;max-width:54ch;margin-inline:auto;margin-bottom:2.5rem;">
      Em 48 horas voc&#xEA; recebe o diagn&#xF3;stico t&#xE9;cnico completo do seu site &#x2014; de gra&#xE7;a, sem pitch de vendas. Pedro Aureliano analisa pessoalmente e entrega as prioridades.
    </p>
    <a href="#formulario" style="display:inline-flex;align-items:center;gap:.625rem;background:var(--g600);color:#fff;font-family:var(--sans);font-size:.9375rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;padding:1.125rem 2.5rem;border-radius:2px;text-decoration:none;transition:background .2s,transform .2s;box-shadow:0 0 40px rgba(46,145,71,.3);" onmouseover="this.style.background='var(--g700)';this.style.transform='translateY(-2px)'" onmouseout="this.style.background='var(--g600)';this.style.transform='translateY(0)'">
      Quero minha auditoria gratuita <span style="font-size:.875rem;">&#x2193;</span>
    </a>
    <p style="margin-top:1rem;font-size:.75rem;color:rgba(255,255,255,.25);">Sem spam. Sem vendedor. Pedro responde pessoalmente.</p>
    <div style="display:flex;align-items:center;justify-content:center;gap:2rem;flex-wrap:wrap;margin-top:3rem;padding-top:2rem;border-top:1px solid rgba(255,255,255,.07);">
      <div style="text-align:center;"><span style="font-family:var(--serif);font-size:1.75rem;font-weight:700;color:var(--g400);display:block;line-height:1;">60+</span><span style="font-size:.7rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.3);display:block;margin-top:.25rem;">Projetos</span></div>
      <div style="text-align:center;"><span style="font-family:var(--serif);font-size:1.75rem;font-weight:700;color:var(--g400);display:block;line-height:1;">6</span><span style="font-size:.7rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.3);display:block;margin-top:.25rem;">Pa&#xED;ses</span></div>
      <div style="text-align:center;"><span style="font-family:var(--serif);font-size:1.75rem;font-weight:700;color:var(--g400);display:block;line-height:1;">90d</span><span style="font-size:.7rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.3);display:block;margin-top:.25rem;">Para IA</span></div>
      <div style="text-align:center;"><span style="font-family:var(--serif);font-size:1.75rem;font-weight:700;color:var(--g400);display:block;line-height:1;">48h</span><span style="font-size:.7rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.3);display:block;margin-top:.25rem;">Diagn&#xF3;stico</span></div>
    </div>
  </div>
</section>

<section style="padding:clamp(4rem,8vw,6rem) clamp(1rem,4vw,3rem);background:var(--n50);">
  <div style="max-width:960px;margin-inline:auto;">
    <p style="font-size:.65rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--n400);text-align:center;margin-bottom:1rem;">Reconhece alguma dessas situa&#xE7;&#xF5;es?</p>
    <h2 style="font-family:var(--serif);font-size:clamp(1.75rem,4vw,3rem);font-weight:700;letter-spacing:-.025em;line-height:1.05;text-align:center;margin-bottom:3rem;">Se sim, a auditoria vai revelar o porqu&#xEA; &#x2014; e como corrigir.</h2>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;" class="pains-grid">
      <div style="background:var(--n0);border:1px solid var(--n200);padding:2rem;transition:border-color .2s,transform .15s;" onmouseover="this.style.borderColor='var(--g400)';this.style.transform='translateY(-3px)'" onmouseout="this.style.borderColor='var(--n200)';this.style.transform='translateY(0)'"><span style="font-size:1.5rem;display:block;margin-bottom:.875rem;">&#x1F4B8;</span><p style="font-size:.9375rem;font-style:italic;color:var(--n500);line-height:1.6;margin-bottom:.875rem;border-left:2px solid var(--n200);padding-left:.875rem;">"Invisto em ads todo m&#xEA;s mas o pipeline seca quando paro de pagar."</p><p style="font-size:.875rem;color:var(--g700);font-weight:500;line-height:1.65;display:flex;gap:.5rem;align-items:flex-start;"><span style="color:var(--g500);font-weight:700;flex-shrink:0;">&#x2192;</span>A auditoria mostra o potencial de pipeline org&#xE2;nico &#x2014; o que voc&#xEA; poderia ter sem pagar por clique.</p></div>
      <div style="background:var(--n0);border:1px solid var(--n200);padding:2rem;transition:border-color .2s,transform .15s;" onmouseover="this.style.borderColor='var(--g400)';this.style.transform='translateY(-3px)'" onmouseout="this.style.borderColor='var(--n200)';this.style.transform='translateY(0)'"><span style="font-size:1.5rem;display:block;margin-bottom:.875rem;">&#x1F916;</span><p style="font-size:.9375rem;font-style:italic;color:var(--n500);line-height:1.6;margin-bottom:.875rem;border-left:2px solid var(--n200);padding-left:.875rem;">"Meu concorrente aparece no ChatGPT. Eu n&#xE3;o existo para as IAs."</p><p style="font-size:.875rem;color:var(--g700);font-weight:500;line-height:1.65;display:flex;gap:.5rem;align-items:flex-start;"><span style="color:var(--g500);font-weight:700;flex-shrink:0;">&#x2192;</span>Diagnosticamos sua entidade digital e GEO readiness &#x2014; o que falta para ser citado pelas IAs.</p></div>
      <div style="background:var(--n0);border:1px solid var(--n200);padding:2rem;transition:border-color .2s,transform .15s;" onmouseover="this.style.borderColor='var(--g400)';this.style.transform='translateY(-3px)'" onmouseout="this.style.borderColor='var(--n200)';this.style.transform='translateY(0)'"><span style="font-size:1.5rem;display:block;margin-bottom:.875rem;">&#x1F4CA;</span><p style="font-size:.9375rem;font-style:italic;color:var(--n500);line-height:1.6;margin-bottom:.875rem;border-left:2px solid var(--n200);padding-left:.875rem;">"SEO funcionou antes mas o tr&#xE1;fego parou de crescer h&#xE1; meses."</p><p style="font-size:.875rem;color:var(--g700);font-weight:500;line-height:1.65;display:flex;gap:.5rem;align-items:flex-start;"><span style="color:var(--g500);font-weight:700;flex-shrink:0;">&#x2192;</span>Identificamos o bloqueio t&#xE9;cnico exato: Core Web Vitals, crawl budget, silos ou gaps de conte&#xFA;do.</p></div>
      <div style="background:var(--n0);border:1px solid var(--n200);padding:2rem;transition:border-color .2s,transform .15s;" onmouseover="this.style.borderColor='var(--g400)';this.style.transform='translateY(-3px)'" onmouseout="this.style.borderColor='var(--n200)';this.style.transform='translateY(0)'"><span style="font-size:1.5rem;display:block;margin-bottom:.875rem;">&#x1F3D7;&#xFE0F;</span><p style="font-size:.9375rem;font-style:italic;color:var(--n500);line-height:1.6;margin-bottom:.875rem;border-left:2px solid var(--n200);padding-left:.875rem;">"J&#xE1; contratei ag&#xEA;ncia de SEO mas nunca vi resultado em pipeline."</p><p style="font-size:.875rem;color:var(--g700);font-weight:500;line-height:1.65;display:flex;gap:.5rem;align-items:flex-start;"><span style="color:var(--g500);font-weight:700;flex-shrink:0;">&#x2192;</span>A auditoria mostra o que as ag&#xEA;ncias anteriores ignoraram: funda&#xE7;&#xE3;o t&#xE9;cnica e entidade digital.</p></div>
    </div>
  </div>
</section>

<section style="padding:clamp(4rem,8vw,6rem) clamp(1rem,4vw,3rem);background:var(--n950);">
  <div style="max-width:960px;margin-inline:auto;">
    <h2 style="font-family:var(--serif);font-size:clamp(1.75rem,4vw,3rem);font-weight:700;letter-spacing:-.025em;line-height:1.05;text-align:center;color:#fff;margin-bottom:.75rem;">O diagn&#xF3;stico que ag&#xEA;ncias cobram R$3.000.<br/><em style="color:var(--g400);font-style:italic;">Aqui &#xE9; gratuito.</em></h2>
    <p style="font-size:1rem;color:rgba(255,255,255,.4);text-align:center;max-width:44ch;margin-inline:auto;line-height:1.7;margin-bottom:3rem;">N&#xE3;o &#xE9; um relat&#xF3;rio gen&#xE9;rico de ferramenta. Pedro analisa o seu site pessoalmente.</p>
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:1px;background:rgba(255,255,255,.07);" class="coverage-grid">
      <div style="background:var(--n950);padding:2rem;"><span style="font-family:var(--serif);font-size:2rem;font-weight:700;color:rgba(255,255,255,.1);display:block;line-height:1;margin-bottom:.75rem;">01</span><p style="font-family:var(--serif);font-size:1rem;font-weight:700;color:#fff;margin-bottom:.5rem;">Core Web Vitals</p><p style="font-size:.8125rem;color:rgba(255,255,255,.4);line-height:1.65;">LCP, CLS e INP medidos em mobile e desktop. O que est&#xE1; reprovado e como corrigir.</p></div>
      <div style="background:var(--n950);padding:2rem;"><span style="font-family:var(--serif);font-size:2rem;font-weight:700;color:rgba(255,255,255,.1);display:block;line-height:1;margin-bottom:.75rem;">02</span><p style="font-family:var(--serif);font-size:1rem;font-weight:700;color:#fff;margin-bottom:.5rem;">Arquitetura t&#xE9;cnica</p><p style="font-size:.8125rem;color:rgba(255,255,255,.4);line-height:1.65;">Silos, crawl budget, redirecionamentos e erros de indexa&#xE7;&#xE3;o.</p></div>
      <div style="background:var(--n950);padding:2rem;"><span style="font-family:var(--serif);font-size:2rem;font-weight:700;color:rgba(255,255,255,.1);display:block;line-height:1;margin-bottom:.75rem;">03</span><p style="font-family:var(--serif);font-size:1rem;font-weight:700;color:#fff;margin-bottom:.5rem;">Schema Markup</p><p style="font-size:.8125rem;color:rgba(255,255,255,.4);line-height:1.65;">Organization, Person, FAQPage &#x2014; presen&#xE7;a e qualidade dos dados estruturados.</p></div>
      <div style="background:var(--n950);padding:2rem;"><span style="font-family:var(--serif);font-size:2rem;font-weight:700;color:rgba(255,255,255,.1);display:block;line-height:1;margin-bottom:.75rem;">04</span><p style="font-family:var(--serif);font-size:1rem;font-weight:700;color:#fff;margin-bottom:.5rem;">Identidade de entidade</p><p style="font-size:.8125rem;color:rgba(255,255,255,.4);line-height:1.65;">Knowledge Graph, Wikidata, sameAs. Sua empresa existe para o Google e as IAs?</p></div>
      <div style="background:var(--n950);padding:2rem;"><span style="font-family:var(--serif);font-size:2rem;font-weight:700;color:rgba(255,255,255,.1);display:block;line-height:1;margin-bottom:.75rem;">05</span><p style="font-family:var(--serif);font-size:1rem;font-weight:700;color:#fff;margin-bottom:.5rem;">GEO readiness</p><p style="font-size:.8125rem;color:rgba(255,255,255,.4);line-height:1.65;">Potencial de cita&#xE7;&#xE3;o por ChatGPT, Gemini e Perplexity. O que falta para aparecer nas IAs.</p></div>
      <div style="background:var(--n950);padding:2rem;"><span style="font-family:var(--serif);font-size:2rem;font-weight:700;color:rgba(255,255,255,.1);display:block;line-height:1;margin-bottom:.75rem;">06</span><p style="font-family:var(--serif);font-size:1rem;font-weight:700;color:#fff;margin-bottom:.5rem;">Gaps de conte&#xFA;do</p><p style="font-size:.8125rem;color:rgba(255,255,255,.4);line-height:1.65;">Clusters ausentes, keywords do ICP sem cobertura, gaps de E-E-A-T.</p></div>
    </div>
  </div>
</section>

<section style="padding:clamp(4rem,8vw,6rem) clamp(1rem,4vw,3rem);background:var(--n50);">
  <div style="max-width:960px;margin-inline:auto;display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center;" class="who-grid">
    <div>
      <h2 style="font-family:var(--serif);font-size:clamp(1.75rem,3.5vw,2.75rem);font-weight:700;letter-spacing:-.02em;line-height:1.1;margin-bottom:1.25rem;">Pedro Aureliano analisa pessoalmente. N&#xE3;o um estagi&#xE1;rio. N&#xE3;o uma ferramenta autom&#xE1;tica.</h2>
      <p style="font-size:.9375rem;color:var(--n600);line-height:1.8;margin-bottom:1.25rem;">60+ projetos em 6 pa&#xED;ses. MBA Internacional em Marketing. Criador do M&#xE9;todo ORGANUM &#x2014; a &#xFA;nica abordagem brasileira que entrega GEO sistematicamente.</p>
      <div style="display:flex;flex-direction:column;gap:.75rem;">
        <div style="display:flex;align-items:center;gap:.75rem;font-size:.875rem;color:var(--n600);"><span style="color:var(--g500);font-weight:700;flex-shrink:0;">&#x2713;</span>An&#xE1;lise manual &#x2014; n&#xE3;o &#xE9; relat&#xF3;rio de ferramenta</div>
        <div style="display:flex;align-items:center;gap:.75rem;font-size:.875rem;color:var(--n600);"><span style="color:var(--g500);font-weight:700;flex-shrink:0;">&#x2713;</span>Resposta em at&#xE9; 48 horas &#xFA;teis</div>
        <div style="display:flex;align-items:center;gap:.75rem;font-size:.875rem;color:var(--n600);"><span style="color:var(--g500);font-weight:700;flex-shrink:0;">&#x2713;</span>Sem obriga&#xE7;&#xE3;o de contrata&#xE7;&#xE3;o</div>
        <div style="display:flex;align-items:center;gap:.75rem;font-size:.875rem;color:var(--n600);"><span style="color:var(--g500);font-weight:700;flex-shrink:0;">&#x2713;</span>Pedro responde d&#xFA;vidas por e-mail</div>
      </div>
    </div>
    <div style="display:flex;flex-direction:column;gap:1.25rem;">
      <div style="background:var(--n950);border:1px solid rgba(76,175,100,.2);padding:2rem;position:relative;"><span style="font-family:var(--serif);font-size:3.5rem;color:rgba(76,175,100,.15);position:absolute;top:.75rem;left:1.5rem;line-height:1;">"</span><p style="font-family:var(--serif);font-size:1rem;font-weight:600;color:#fff;line-height:1.4;margin-bottom:1rem;position:relative;z-index:1;font-style:italic;">Chegaram leads excelentes esse m&#xEA;s, os melhores com certeza. Me falaram que pesquisaram no ChatGPT.</p><div style="display:flex;align-items:center;gap:.75rem;"><div style="width:36px;height:36px;background:rgba(76,175,100,.15);border:1px solid rgba(76,175,100,.25);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:700;color:var(--g400);">PC</div><div><p style="font-size:.875rem;font-weight:700;color:#fff;">Pedro Capizane</p><p style="font-size:.75rem;color:rgba(255,255,255,.4);">CEO &#x2014; HunterHunter</p></div></div></div>
      <div style="background:var(--n950);border:1px solid rgba(255,255,255,.08);padding:2rem;position:relative;"><span style="font-family:var(--serif);font-size:3.5rem;color:rgba(255,255,255,.06);position:absolute;top:.75rem;left:1.5rem;line-height:1;">"</span><p style="font-family:var(--serif);font-size:1rem;font-weight:600;color:#fff;line-height:1.4;margin-bottom:1rem;position:relative;z-index:1;font-style:italic;">Toda empresa que tenho eu conto com o Pedro para desenvolver a estrutura digital. Sempre muito eficiente.</p><div style="display:flex;align-items:center;gap:.75rem;"><div style="width:36px;height:36px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:700;color:rgba(255,255,255,.5);">EO</div><div><p style="font-size:.875rem;font-weight:700;color:#fff;">Elton Oliveira</p><p style="font-size:.75rem;color:rgba(255,255,255,.4);">Fundador &#x2014; 7+ Vacations</p></div></div></div>
    </div>
  </div>
</section>

<section id="formulario" style="padding:clamp(4rem,8vw,6rem) clamp(1rem,4vw,3rem);background:var(--n950);">
  <div style="max-width:780px;margin-inline:auto;">
    <div style="text-align:center;margin-bottom:3rem;">
      <div style="display:inline-flex;align-items:center;gap:.625rem;background:rgba(220,100,50,.1);border:1px solid rgba(220,100,50,.2);padding:.4rem 1.25rem;border-radius:999px;margin-bottom:1.5rem;">
        <span style="font-size:.7rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:rgba(220,130,80,.9);">&#x23F1; An&#xE1;lise manual &#x2014; vagas limitadas por semana</span>
      </div>
      <h2 style="font-family:var(--serif);font-size:clamp(2rem,5vw,4rem);font-weight:900;line-height:.95;letter-spacing:-.03em;color:#fff;margin-bottom:1rem;">Solicite agora.<br/><em style="color:var(--g400);font-style:italic;">Resposta em at&#xE9; 48 horas.</em></h2>
      <p style="font-size:1rem;color:rgba(255,255,255,.45);max-width:44ch;margin-inline:auto;line-height:1.7;">Preencha abaixo. Pedro analisa pessoalmente e envia o diagn&#xF3;stico. Sem spam, sem CRM autom&#xE1;tico, sem vendedor.</p>
    </div>
    <div style="background:#0e0c0a;border:1px solid rgba(76,175,100,.2);overflow:hidden;box-shadow:...;min-height:660px;">
      <iframe
        src="https://api.ilevex.com.br/widget/form/Gpue5KmcF2LTfDXD1Jcf"
        style="width:100%;height:660px;border:none;display:block;"
        id="inline-auditoria"
        data-layout="{'id':'INLINE'}"
        data-trigger-type="alwaysShow"
        data-trigger-value=""
        data-activation-type="alwaysActivated"
        data-activation-value=""
        data-deactivation-type="neverDeactivate"
        data-deactivation-value=""
        data-form-name="Auditoria Gratuita — Organum"
        data-height="624"
        data-layout-iframe-id="inline-auditoria"
        data-form-id="Gpue5KmcF2LTfDXD1Jcf"
        title="Formul&#xE1;rio de auditoria gratuita &#x2014; Organum"
        loading="lazy"
      ></iframe>
    </div>
    <p style="margin-top:1rem;font-size:.75rem;color:rgba(255,255,255,.2);text-align:center;">Seus dados s&#xE3;o protegidos conforme a LGPD. <a href="/privacidade" style="color:rgba(255,255,255,.3);text-decoration:none;">Ver pol&#xED;tica de privacidade</a></p>
  </div>
</section>

<section style="padding:clamp(4rem,8vw,5rem) clamp(1rem,4vw,3rem);background:var(--n50);">
