---
import { getCollection } from 'astro:content';
import Page from '@layouts/Page.astro';
import { clusterLabels } from '@content/config';

const posts = await getCollection('blog', ({ data }) => !data.draft);
posts.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

// Agrupar por cluster
const byCluster = posts.reduce(
  (acc, post) => {
    const c = post.data.cluster;
    if (!acc[c]) acc[c] = [];
    acc[c].push(post);
    return acc;
  },
  {} as Record<string, typeof posts>,
);

const formatDate = (d: Date) =>
  d.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' });
---

<Page
  title="Blog de SEO orgânico B2B | Organum"
  description="Artigos técnicos sobre SEO B2B, GEO, identidade de entidade, link building e conteúdo de autoridade. Escritos por Pedro Aureliano."
  canonical="https://organum.com.br/blog/"
  breadcrumbItems={[{ name: 'Blog', url: '/blog' }]}
>
  <div class="container-page py-16">
    <div class="max-w-2xl mb-14">
      <h1 class="mb-4">Blog de SEO orgânico B2B</h1>
      <p class="text-xl text-ink-500">
        Conteúdo técnico sobre as 5 camadas do Método ORGANUM. Escrito por Pedro Aureliano com base em dados reais de clientes.
      </p>
    </div>

    {Object.entries(byCluster).map(([cluster, clusterPosts]) => (
      <section class="mb-16" id={cluster}>
        <div class="flex items-center justify-between mb-7">
          <h2 class="text-2xl">{clusterLabels[cluster as keyof typeof clusterLabels]}</h2>
          <a href={`/blog/${cluster}`} class="text-sm font-medium text-brand-600 no-underline hover:underline">
            Ver todos →
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {clusterPosts.map((post) => {
            const slug = post.slug.split('/').pop();
            return (
              <a href={`/blog/${cluster}/${slug}`} class="card no-underline group">
                <div class="badge-brand mb-3 text-xs">{clusterLabels[post.data.cluster]}</div>
                <h3 class="text-lg font-semibold text-ink-900 group-hover:text-brand-600 transition-colors mb-2 leading-snug">
                  {post.data.title}
                </h3>
                <p class="text-sm text-ink-500 mb-4 line-clamp-2">{post.data.description}</p>
                <div class="flex items-center gap-3 text-xs text-ink-400">
                  <span>{post.data.author}</span>
                  <span>·</span>
                  <time datetime={post.data.publishedAt.toISOString()}>
                    {formatDate(post.data.publishedAt)}
                  </time>
                  {post.data.readingTime && <span>· {post.data.readingTime} min</span>}
                </div>
              </a>
            );
          })}
        </div>
      </section>
    ))}

    {posts.length === 0 && (
      <div class="text-center py-20 text-ink-400">
        <p class="text-xl">Em breve os primeiros artigos.</p>
        <p class="mt-2 text-sm">Enquanto isso, solicite uma auditoria gratuita.</p>
        <a href="/auditoria-gratuita" class="btn-primary mt-6 inline-flex">Auditoria gratuita</a>
      </div>
    )}
  </div>
</Page>
