---
import Page from '@layouts/Page.astro';

const personSchema = {
  '@type': 'Person',
  '@id': 'https://organum.com.br/sobre/pedro-aureliano/#person',
  name: 'Pedro Aureliano',
  givenName: 'Pedro',
  familyName: 'Aureliano',
  url: 'https://organum.com.br/sobre/pedro-aureliano/',
  image: {
    '@type': 'ImageObject',
    url: 'https://organum.com.br/images/pedro-aureliano.webp',
    width: 400,
    height: 400,
  },
  jobTitle: 'Fundador e CEO',
  worksFor: {
    '@type': 'Organization',
    '@id': 'https://organum.com.br/#organization',
  },
  description: 'Especialista em SEO orgânico B2B, GEO e construção de entidade digital. Fundador da Organum e CEO da Nexxo Digital. Formado em Marketing Digital pela Unifavip e MBA Internacional em Marketing pela Next University. Mais de 60 projetos em 6 países.',
  knowsAbout: [
    'SEO técnico',
    'Generative Engine Optimization',
    'Identidade de entidade digital',
    'SEO B2B',
    'Digital PR',
    'E-E-A-T',
    'Core Web Vitals',
    'Schema Markup',
    'Marketing Internacional',
  ],
  alumniOf: [
    {
      '@type': 'EducationalOrganization',
      name: 'Unifavip — Centro Universitário Vale do Ipojuca',
      description: 'Graduação em Marketing Digital',
    },
    {
      '@type': 'EducationalOrganization',
      name: 'Next University',
      description: 'MBA Internacional em Marketing',
    },
  ],
  sameAs: [
    'https://www.linkedin.com/in/pedro-aureliano-7a416a226/',
    'https://www.wikidata.org/wiki/Q139816078',
    'https://organum.com.br/sobre/pedro-aureliano/',
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Recife',
    addressRegion: 'PE',
    addressCountry: 'BR',
  },
};

const stats = [
  { num: '60+', label: 'Projetos entregues', detail: 'Brasil, Uruguai, Panamá, EUA, Reino Unido e Dinamarca' },
  { num: '6', label: 'Países atendidos', detail: 'Projetos internacionais com resultados documentados' },
  { num: 'R$6,6M', label: 'Em um único mês', detail: 'Receita gerada para exportadora de commodities' },
  { num: '30+', label: 'Empresas estruturadas', detail: 'Do zero ao digital — estratégia, presença e tráfego' },
];

const credentials = [
  {
    icon: '🎓',
    title: 'Graduação em Marketing Digital',
    org: 'Unifavip — Centro Universitário Vale do Ipojuca',
    desc: 'Formação acadêmica com base em estratégia de marketing, comportamento do consumidor e comunicação digital.',
  },
  {
    icon: '🎓',
    title: 'MBA Internacional em Marketing',
    org: 'Next University',
    desc: 'MBA com foco em marketing internacional, gestão de marcas globais e estratégias de expansão para mercados externos.',
  },
  {
    icon: '🏢',
    title: 'CEO — Nexxo Digital',
    org: 'Desde 2023',
    desc: 'Agência de marketing digital com projetos em 6 países. Especialização em tráfego pago, branding e presença digital.',
  },
  {
    icon: '🌱',
    title: 'Fundador — Organum',
    org: 'Agência de SEO orgânico B2B',
    desc: 'Criador do Método ORGANUM — as 5 camadas que levam empresas do zero técnico à citação por IA e ao pipeline comercial.',
  },
];

const expertise = [
  {
    area: 'SEO Técnico',
    desc: 'Core Web Vitals, arquitetura de silos, Schema Markup completo em JSON-LD, crawl budget. A fundação que tudo depende.',
    icon: '⚙',
  },
  {
    area: 'GEO — Generative Engine Optimization',
    desc: 'Único especialista brasileiro com metodologia sistemática para citação por ChatGPT, Gemini e Perplexity.',
    icon: '◎',
  },
  {
    area: 'Identidade de Entidade Digital',
    desc: 'Construção de presença verificável no Knowledge Graph, Wikidata e sameAs — o que as IAs precisam para recomendar.',
    icon: '◈',
  },
  {
    area: 'SEO B2B Internacional',
    desc: 'Pipeline orgânico para empresas com operação em múltiplos países. Projetos bilíngues PT/EN e multilíngues.',
    icon: '▣',
  },
  {
    area: 'Digital PR e Link Building',
    desc: 'Assessoria de imprensa digital, menções editoriais em portais de nicho e construção de Domain Authority.',
    icon: '◉',
  },
  {
    area: 'Marketing Internacional',
    desc: 'Estratégias de expansão digital para mercados externos. Cases em EUA, Europa e América Latina.',
    icon: '🌎',
  },
];

const projects = [
  {
    result: 'R$ 6,6 milhões',
    period: 'em um único mês',
    desc: 'Campanha de marketing digital para exportadora de commodities brasileira com operação internacional.',
    tags: ['Marketing Internacional', 'Tráfego Pago', 'ROI'],
  },
  {
    result: 'Criativos top ranqueados',
    period: 'internacionalmente',
    desc: 'Campanhas de Ads com criativos entre os melhores ranqueados globalmente nas plataformas Meta e Google.',
    tags: ['Meta Ads', 'Google Ads', 'Criativos'],
  },
  {
    result: '30+ empresas',
    period: 'estruturadas do zero',
    desc: 'Estruturação completa de presença digital — do branding à estratégia de tráfego orgânico e pago.',
    tags: ['Presença Digital', 'Branding', 'SEO'],
  },
  {
    result: '6 países',
    period: 'atendidos',
    desc: 'Projetos com clientes no Brasil, Uruguai, Panamá, EUA, Reino Unido e Dinamarca. Estratégias multilíngues.',
    tags: ['Internacional', 'PT/EN', 'Multi-mercado'],
  },
];
---

<Page
  title="Pedro Aureliano — Especialista em SEO B2B, GEO e Entidade Digital | Organum"
  description="Fundador da Organum e CEO da Nexxo Digital. MBA Internacional em Marketing. 60+ projetos em 6 países. Criador do Método ORGANUM — as 5 camadas do SEO orgânico B2B."
  canonical="https://organum.com.br/sobre/pedro-aureliano/"
  ogType="profile"
  breadcrumbItems={[{ name: 'Sobre', url: '/sobre' }, { name: 'Pedro Aureliano', url: '/sobre/pedro-aureliano' }]}
  schemaExtra={[personSchema]}
>

<!-- ══════════ HERO — identidade visual escura ══════════ -->
<section style="background:var(--n950);padding:clamp(4rem,10vh,7rem) clamp(1rem,4vw,3rem);">
  <div style="max-width:1280px;margin-inline:auto;display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center;" class="hero-grid">

    <!-- Texto -->
    <div>
      <p style="font-size:.65rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:rgba(76,175,100,.7);display:flex;align-items:center;gap:.625rem;margin-bottom:1.25rem;">
        <span style="width:2px;height:18px;background:var(--g500);display:inline-block;"></span>
        Fundador da Organum · CEO da Nexxo Digital
      </p>
      <h1 style="font-family:var(--serif);font-size:clamp(2.5rem,6vw,5rem);font-weight:900;line-height:.93;letter-spacing:-.03em;color:#fff;">
        Pedro<br/>Aureliano
      </h1>
      <p style="margin-top:1.5rem;font-size:1.0625rem;color:rgba(255,255,255,.5);line-height:1.75;max-width:44ch;">
        Especialista em SEO orgânico B2B, GEO e construção de entidade digital. Criador do Método ORGANUM — a única abordagem sistemática que leva empresas brasileiras à citação por IA.
      </p>
      <div style="margin-top:2.5rem;display:flex;flex-wrap:wrap;gap:.75rem;">
        <a href="https://www.linkedin.com/in/pedro-aureliano-7a416a226/" target="_blank" rel="noopener noreferrer"
           style="display:inline-flex;align-items:center;gap:.5rem;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);color:rgba(255,255,255,.7);font-family:var(--sans);font-size:.8125rem;font-weight:600;padding:.75rem 1.5rem;border-radius:2px;text-decoration:none;transition:all .2s;"
           onmouseover="this.style.background='rgba(76,175,100,.12)';this.style.borderColor='rgba(76,175,100,.3)';this.style.color='var(--g400)'"
           onmouseout="this.style.background='rgba(255,255,255,.07)';this.style.borderColor='rgba(255,255,255,.12)';this.style.color='rgba(255,255,255,.7)'">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          LinkedIn
        </a>
        <a href="/auditoria-gratuita"
           style="display:inline-flex;align-items:center;gap:.5rem;background:var(--g600);color:#fff;font-family:var(--sans);font-size:.8125rem;font-weight:600;letter-spacing:.04em;text-transform:uppercase;padding:.75rem 1.5rem;border-radius:2px;text-decoration:none;transition:background .2s;"
           onmouseover="this.style.background='var(--g700)'" onmouseout="this.style.background='var(--g600)'">
          Falar com Pedro
        </a>
      </div>
    </div>

    <!-- Foto / Avatar -->
    <div style="display:flex;justify-content:center;align-items:center;">
      <div style="position:relative;width:clamp(200px,30vw,320px);aspect-ratio:1;">
        <!-- Foto profissional — substituir src quando subir o WebP -->
        <img
          src="/images/pedro-aureliano.webp"
          alt="Pedro Aureliano — Fundador da Organum, especialista em SEO B2B e GEO"
          width="320"
          height="320"
          loading="eager"
          style="width:100%;height:100%;object-fit:cover;border-radius:2px;display:block;"
          onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
        />
        <!-- Fallback avatar enquanto a foto não está disponível -->
        <div style="display:none;width:100%;height:100%;background:rgba(29,122,53,.15);border:2px solid rgba(76,175,100,.3);border-radius:2px;align-items:center;justify-content:center;flex-direction:column;gap:.75rem;" id="avatar-fallback">
          <span style="font-family:var(--serif);font-size:5rem;font-weight:700;color:var(--g400);line-height:1;">PA</span>
          <span style="font-size:.65rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:rgba(76,175,100,.5);">Pedro Aureliano</span>
        </div>
        <!-- Elemento decorativo geométrico -->
        <div style="position:absolute;top:-12px;right:-12px;width:48px;height:48px;border:2px solid rgba(76,175,100,.3);border-radius:2px;pointer-events:none;"></div>
        <div style="position:absolute;bottom:-12px;left:-12px;width:32px;height:32px;background:rgba(76,175,100,.15);border-radius:2px;pointer-events:none;"></div>
      </div>
    </div>
  </div>
</section>

<!-- ══════════ MÉTRICAS ══════════ -->
<div style="background:var(--n950);border-top:1px solid rgba(255,255,255,.06);border-bottom:1px solid rgba(255,255,255,.06);">
  <div style="max-width:1280px;margin-inline:auto;display:grid;grid-template-columns:repeat(4,1fr);" class="stats-grid">
    {stats.map((s, i) => (
      <div style={`padding:2rem 1.5rem;text-align:center;${i < stats.length-1 ? 'border-right:1px solid rgba(255,255,255,.07);' : ''}`}>
        <span style="font-family:var(--serif);font-size:clamp(2rem,4vw,3rem);font-weight:700;color:var(--g400);line-height:1;display:block;">{s.num}</span>
        <span style="font-size:.75rem;font-weight:600;color:#fff;display:block;margin-top:.375rem;">{s.label}</span>
        <span style="font-size:.75rem;color:rgba(255,255,255,.3);display:block;margin-top:.25rem;line-height:1.4;">{s.detail}</span>
      </div>
    ))}
  </div>
</div>

<!-- ══════════ CREDENCIAIS ══════════ -->
<section style="padding:clamp(4rem,8vw,6rem) clamp(1rem,4vw,3rem);background:var(--n50);">
  <div style="max-width:1280px;margin-inline:auto;">
    <p style="font-size:.65rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--n400);display:flex;align-items:center;gap:.625rem;margin-bottom:1rem;">
      <span style="width:2px;height:18px;background:var(--g500);display:inline-block;"></span>
      Formação e trajetória
    </p>
    <h2 style="font-family:var(--serif);font-size:clamp(1.75rem,4vw,2.75rem);font-weight:700;letter-spacing:-.02em;margin-bottom:2.5rem;">
      Credenciais verificáveis
    </h2>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;" class="cred-grid">
      {credentials.map(c => (
        <div style="background:var(--n0);border:1px solid var(--n200);padding:2rem;display:flex;gap:1.25rem;align-items:flex-start;transition:border-color .2s;" onmouseover="this.style.borderColor='var(--g400)'" onmouseout="this.style.borderColor='var(--n200)'">
          <span style="font-size:1.5rem;flex-shrink:0;margin-top:.125rem;">{c.icon}</span>
          <div>
            <p style="font-family:var(--serif);font-size:1.125rem;font-weight:700;color:var(--n900);margin-bottom:.25rem;">{c.title}</p>
            <p style="font-size:.75rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--g600);margin-bottom:.625rem;">{c.org}</p>
            <p style="font-size:.875rem;color:var(--n500);line-height:1.65;">{c.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══════════ ESPECIALIDADES ══════════ -->
<section style="padding:clamp(4rem,8vw,6rem) clamp(1rem,4vw,3rem);">
  <div style="max-width:1280px;margin-inline:auto;">
    <p style="font-size:.65rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--n400);display:flex;align-items:center;gap:.625rem;margin-bottom:1rem;">
      <span style="width:2px;height:18px;background:var(--g500);display:inline-block;"></span>
      Expertise
    </p>
    <h2 style="font-family:var(--serif);font-size:clamp(1.75rem,4vw,2.75rem);font-weight:700;letter-spacing:-.02em;margin-bottom:2.5rem;">
      Áreas de especialidade
    </h2>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;" class="exp-grid">
      {expertise.map(e => (
        <div style="border:1px solid var(--n200);padding:1.75rem;transition:border-color .2s,transform .2s;" onmouseover="this.style.borderColor='var(--g400)';this.style.transform='translateY(-3px)'" onmouseout="this.style.borderColor='var(--n200)';this.style.transform='translateY(0)'">
          <span style="font-size:1.5rem;display:block;margin-bottom:.875rem;">{e.icon}</span>
          <p style="font-family:var(--serif);font-size:1.0625rem;font-weight:700;color:var(--n900);margin-bottom:.5rem;">{e.area}</p>
          <p style="font-size:.875rem;color:var(--n500);line-height:1.65;">{e.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══════════ PROJETOS E RESULTADOS ══════════ -->
<section style="padding:clamp(4rem,8vw,6rem) clamp(1rem,4vw,3rem);background:var(--n950);">
  <div style="max-width:1280px;margin-inline:auto;">
    <p style="font-size:.65rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:rgba(76,175,100,.7);display:flex;align-items:center;gap:.625rem;margin-bottom:1rem;">
      <span style="width:2px;height:18px;background:var(--g500);display:inline-block;"></span>
      Resultados comprovados
    </p>
    <h2 style="font-family:var(--serif);font-size:clamp(1.75rem,4vw,2.75rem);font-weight:700;letter-spacing:-.02em;color:#fff;margin-bottom:2.5rem;">
      Projetos e resultados
    </h2>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1px;background:rgba(255,255,255,.07);" class="proj-grid">
      {projects.map(p => (
        <div style="background:var(--n950);padding:2.5rem;">
          <p style="font-family:var(--serif);font-size:2rem;font-weight:700;color:var(--g400);line-height:1;margin-bottom:.25rem;">{p.result}</p>
          <p style="font-size:.8125rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:rgba(255,255,255,.35);margin-bottom:1rem;">{p.period}</p>
          <p style="font-size:.9375rem;color:rgba(255,255,255,.5);line-height:1.7;margin-bottom:1.25rem;">{p.desc}</p>
          <div style="display:flex;flex-wrap:wrap;gap:.5rem;">
            {p.tags.map(tag => (
              <span style="font-size:.65rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);color:rgba(255,255,255,.4);padding:.25rem .625rem;border-radius:999px;">{tag}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══════════ O MÉTODO ORGANUM ══════════ -->
<section style="padding:clamp(4rem,8vw,6rem) clamp(1rem,4vw,3rem);background:var(--n50);">
  <div style="max-width:960px;margin-inline:auto;display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center;" class="method-grid">
    <div>
      <p style="font-size:.65rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--n400);display:flex;align-items:center;gap:.625rem;margin-bottom:1rem;">
        <span style="width:2px;height:18px;background:var(--g500);display:inline-block;"></span>
        Contribuição original
      </p>
      <h2 style="font-family:var(--serif);font-size:clamp(1.75rem,3.5vw,2.75rem);font-weight:700;letter-spacing:-.02em;line-height:1.1;margin-bottom:1.25rem;">
        Criador do<br/><em style="color:var(--g600);font-style:italic;">Método ORGANUM</em>
      </h2>
      <p style="font-size:.9375rem;color:var(--n600);line-height:1.8;margin-bottom:1.25rem;">
        Após trabalhar com mais de 60 projetos em 6 países e perceber que nenhuma agência brasileira entregava GEO sistematicamente, Pedro desenvolveu o Método ORGANUM — uma abordagem em 5 camadas que integra fundação técnica, identidade de entidade, conteúdo de autoridade, GEO + AEO e Digital PR.
      </p>
      <p style="font-size:.9375rem;color:var(--n600);line-height:1.8;margin-bottom:2rem;">
        O método é a única abordagem documentada no Brasil que entrega citação por IA de forma sistemática para empresas B2B — não como resultado acidental, mas como entrega previsível com timeline definido.
      </p>
      <a href="/metodo" style="display:inline-flex;align-items:center;gap:.5rem;font-size:.75rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--g600);text-decoration:none;">
        Ver o Método ORGANUM →
      </a>
    </div>
    <div style="display:flex;flex-direction:column;gap:0;border:1px solid var(--n200);">
      {[
        { n:'01', name:'Fundação técnica', desc:'Core Web Vitals, silos, Schema Markup' },
        { n:'02', name:'Identidade de entidade', desc:'Knowledge Graph, Wikidata, sameAs' },
        { n:'03', name:'Conteúdo de autoridade', desc:'Clusters, E-E-A-T, fonte para IA' },
        { n:'04', name:'GEO + AEO', desc:'ChatGPT, Gemini, Perplexity' },
        { n:'05', name:'Digital PR', desc:'Link building editorial, DA crescente' },
      ].map((l, i, arr) => (
        <a href={`/metodo/${l.n === '01' ? 'fundacao' : l.n === '02' ? 'entidade' : l.n === '03' ? 'conteudo' : l.n === '04' ? 'geo-aeo' : 'digital-pr'}`}
           style={`display:grid;grid-template-columns:48px 1fr;gap:1rem;padding:1.25rem 1.5rem;text-decoration:none;${i < arr.length-1 ? 'border-bottom:1px solid var(--n200);' : ''}transition:background .2s;`}
           onmouseover="this.style.background='var(--n50)'" onmouseout="this.style.background='transparent'">
          <span style="font-family:var(--serif);font-size:1.75rem;font-weight:700;color:var(--n200);line-height:1;">{l.n}</span>
          <div>
            <p style="font-family:var(--serif);font-size:.9375rem;font-weight:700;color:var(--n900);">{l.name}</p>
            <p style="font-size:.8125rem;color:var(--n400);">{l.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ══════════ ENTIDADE DIGITAL ══════════ -->
<section style="padding:clamp(4rem,8vw,6rem) clamp(1rem,4vw,3rem);background:var(--n950);">
  <div style="max-width:960px;margin-inline:auto;">
    <p style="font-size:.65rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:rgba(76,175,100,.7);display:flex;align-items:center;gap:.625rem;margin-bottom:1rem;">
      <span style="width:2px;height:18px;background:var(--g500);display:inline-block;"></span>
      Entidade verificável
    </p>
    <h2 style="font-family:var(--serif);font-size:clamp(1.75rem,3.5vw,2.5rem);font-weight:700;letter-spacing:-.02em;color:#fff;margin-bottom:1.5rem;">
      Presença digital verificável
    </h2>
    <p style="font-size:.9375rem;color:rgba(255,255,255,.45);line-height:1.8;max-width:56ch;margin-bottom:2.5rem;">
      Uma entidade digital verificável é o pré-requisito para ser recomendado pelas IAs generativas. Aqui estão os perfis que confirmam a identidade de Pedro Aureliano como especialista real e verificável.
    </p>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:rgba(255,255,255,.07);" class="entity-grid">
      {[
        { name: 'LinkedIn', desc: 'Perfil profissional verificado com histórico completo de projetos e formação acadêmica.', url: 'https://www.linkedin.com/in/pedro-aureliano-7a416a226/', cta: 'Ver perfil →' },
        { name: 'Organum', desc: 'Site institucional com Schema Organization e Person completos — entidade verificada pelo Google.', url: 'https://organum.com.br', cta: 'Ver site →' },
        { name: 'Wikidata', desc: 'Perfil verificável no Wikidata — base de dados usada por LLMs para confirmar a existência e autoridade de entidades.', url: 'https://www.wikidata.org/wiki/Q139816078', cta: 'Ver perfil →' },
      ].map(e => (
        <div style="background:var(--n950);padding:2rem;">
