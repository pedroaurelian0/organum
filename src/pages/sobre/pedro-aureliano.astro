          {e.url !== '#' ? (
            <a href={e.url} target="_blank" rel="noopener noreferrer" style="font-size:.65rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--g400);text-decoration:none;">{e.cta}</a>
          ) : (
            <span style="font-size:.65rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.2);">{e.cta}</span>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

