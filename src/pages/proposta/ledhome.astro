window.addEventListener('scroll',()=>nav.classList.toggle('scrolled',scrollY>50),{passive:true});

const io=new IntersectionObserver(entries=>{
  entries.forEach((e,i)=>{
    if(e.isIntersecting){setTimeout(()=>e.target.classList.add('vis'),i*60);io.unobserve(e.target);}
  });
},{threshold:.08,rootMargin:'0px 0px -40px 0px'});
document.querySelectorAll('.rev,.prob').forEach(el=>io.observe(el));

function toggleFaq(id){
  const item=document.getElementById(id);
  const isOpen=item.classList.contains('open');
  document.querySelectorAll('.faq-item').forEach(f=>f.classList.remove('open'));
  if(!isOpen)item.classList.add('open');
}

function animateProjBars(){
  document.querySelectorAll('.pfill-kw,.pfill-vis').forEach(b=>{
    setTimeout(()=>{b.style.width=b.getAttribute('data-w')+'%';},200);
  });
}
const projObs=new IntersectionObserver(entries=>{
  if(entries[0].isIntersecting){animateProjBars();projObs.disconnect();}
},{threshold:.2});
const projEl=document.querySelector('.proj-rows');
if(projEl)projObs.observe(projEl);

function openAccept(){
