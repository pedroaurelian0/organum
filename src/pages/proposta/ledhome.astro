  if(!aceite){alert('Marque o checkbox de aceite para continuar.');return;}
  const btn=document.getElementById('subBtn');
  btn.disabled=true;btn.textContent='Enviando...';
  const sub=encodeURIComponent('[ACEITE] Proposta SEO â€” LedHome');
  const body=encodeURIComponent(
    'ACEITE DE PROPOSTA â€” ORGANUM SEO\n==================================\n'+
    'Data/Hora: '+ts+'\n\n'+
    'Nome: '+nome+'\nE-mail: '+email+'\nTelefone: '+tel+'\nCNPJ: '+cnpj+'\nRazÃ£o Social: '+razao+'\nObservaÃ§Ãµes: '+(obs||'â€”')+'\n\n'+
    'ESCOPO ACEITO\nCliente: LedHome IluminaÃ§Ã£o\n'+
    'Setup SEO: R$2.000 (pagamento Ãºnico â€” mÃªs 1)\n'+
    'Fee mensal a partir do mÃªs 2:\n  GestÃ£o de trÃ¡fego: R$1.500/mÃªs\n  SEO mensal: R$500/mÃªs\n  Total: R$2.000/mÃªs (fatura Ãºnica)'
  );
  window.location.href='mailto:pedro.aureliano95@gmail.com?subject='+sub+'&body='+body;
  setTimeout(()=>{
    document.getElementById('formWrap').style.display='none';
    document.getElementById('successBox').classList.add('on');
  },1500);
}
const cv=document.getElementById('confettiC');
const cx=cv.getContext('2d');
let pts=[],af,run=false;
function startConfetti(){
  cv.width=innerWidth;cv.height=innerHeight;pts=[];
  const cols=['#f59e0b','#d97706','#fbbf24','#ffffff','#fde68a','#4caf64'];
  for(let i=0;i<100;i++)pts.push({x:Math.random()*cv.width,y:-10-Math.random()*180,w:5+Math.random()*7,h:3+Math.random()*4,r:Math.random()*Math.PI*2,rv:(Math.random()-.5)*.14,vy:2+Math.random()*3,vx:(Math.random()-.5)*1.4,c:cols[Math.floor(Math.random()*cols.length)],o:1});
  run=true;tick();
}
function tick(){
  cx.clearRect(0,0,cv.width,cv.height);
  pts.forEach(p=>{p.y+=p.vy;p.x+=p.vx;p.r+=p.rv;if(p.y>cv.height*.65)p.o=Math.max(0,p.o-.025);cx.save();cx.globalAlpha=p.o;cx.translate(p.x,p.y);cx.rotate(p.r);cx.fillStyle=p.c;cx.fillRect(-p.w/2,-p.h/2,p.w,p.h);cx.restore()});
  if(run)af=requestAnimationFrame(tick);
}
function stopConfetti(){run=false;cancelAnimationFrame(af);cx.clearRect(0,0,cv.width,cv.height);}
</script>

