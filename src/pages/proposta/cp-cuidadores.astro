<script is:inline>
/* NAV */
const nav=document.getElementById('nav');
window.addEventListener('scroll',()=>nav.classList.toggle('scrolled',scrollY>50),{passive:true});

/* SCROLL REVEAL */
const io=new IntersectionObserver((entries)=>{
  entries.forEach((e,i)=>{
    if(e.isIntersecting){
      setTimeout(()=>e.target.classList.add('vis'),i*80);
      io.unobserve(e.target);
    }
  });
},{threshold:.06,rootMargin:'0px 0px -40px 0px'});
document.querySelectorAll('.rev').forEach(el=>io.observe(el));

/* CPC CHART — animate bars on first view */
const cpcBars=document.querySelectorAll('.cpc-bar');
const cpcObs=new IntersectionObserver((entries)=>{
  entries.forEach(e=>{
    if(e.isIntersecting){
      cpcBars.forEach(b=>{b.style.height=b.dataset.h+'%'});
      cpcObs.disconnect();
    }
  });
},{threshold:.3});
const chart=document.getElementById('cpcChart');
if(chart)cpcObs.observe(chart);

/* COMPETITOR BARS */
const compObs=new IntersectionObserver((entries)=>{
  entries.forEach(e=>{
    if(e.isIntersecting){
      document.querySelectorAll('.comp-bar-fill').forEach(b=>{b.style.width=(b.dataset.w||0)+'%'});
      compObs.disconnect();
    }
  });
},{threshold:.2});
const compList=document.querySelector('.comp-list');
if(compList)compObs.observe(compList);

/* PROJ BARS */
const projObs=new IntersectionObserver((entries)=>{
  entries.forEach(e=>{
    if(e.isIntersecting){
      document.querySelectorAll('.pm-fill-ads').forEach(b=>{b.style.width=(b.dataset.w||0)+'%'});
      document.querySelectorAll('.pm-fill-org').forEach(b=>{b.style.width=(b.dataset.w||0)+'%'});
      projObs.disconnect();
    }
  });
},{threshold:.1});
const projList=document.querySelector('.proj-months');
if(projList)projObs.observe(projList);

/* TABS */
function switchTab(id){
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  document.querySelectorAll('.tab-panel').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.tab').forEach(t=>{if(t.getAttribute('onclick').includes("'"+id+"'"))t.classList.add('active')});
  const panel=document.getElementById('tp-'+id);
  if(panel)panel.classList.add('active');
  if(id==='cpc')cpcBars.forEach(b=>{b.style.height=b.dataset.h+'%'});
  if(id==='comp')document.querySelectorAll('.comp-bar-fill').forEach(b=>{b.style.width=(b.dataset.w||0)+'%'});
}

/* ACCEPT */
function openAccept(){
  document.getElementById('overlay').classList.add('on');
  document.body.style.overflow='hidden';
  document.getElementById('ts').textContent=new Date().toLocaleString('pt-BR',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit',second:'2-digit'});
  startConfetti();setTimeout(stopConfetti,3800);
}
function closeAccept(){
  document.getElementById('overlay').classList.remove('on');
  document.body.style.overflow='';
}

/* FORM */
function submitForm(){
  const nome=document.getElementById('f_nome').value.trim();
  const email=document.getElementById('f_email').value.trim();
  const tel=document.getElementById('f_tel').value.trim();
  const cnpj=document.getElementById('f_cnpj').value.trim();
  const razao=document.getElementById('f_razao').value.trim();
  const obs=document.getElementById('f_obs').value.trim();
  const aceite=document.getElementById('f_aceite').checked;
  const ts=document.getElementById('ts').textContent;
  if(!nome||!email||!cnpj||!razao){alert('Preencha nome, e-mail, CNPJ e razão social.');return;}
  if(!aceite){alert('Marque o checkbox de aceite para continuar.');return;}
  const btn=document.getElementById('subBtn');
  btn.disabled=true;btn.textContent='Enviando...';
  const sub=encodeURIComponent('[ACEITE] Proposta Nexxo+Organum — CP Cuidadores / CuidaRio');
  const body=encodeURIComponent(
    'ACEITE DE PROPOSTA COMERCIAL\n================================\n'+
    'Data/Hora: '+ts+'\n\n'+
    'Nome: '+nome+'\nE-mail: '+email+'\nTelefone: '+tel+'\nCNPJ: '+cnpj+'\nRazão Social: '+razao+'\nObservações: '+(obs||'—')+'\n\n'+
    'PROPOSTA ACEITA\nCliente: CP Cuidadores / CuidaRio / SIP\nGestão mensal: R$3.000/mês\nSetup Entidade Digital + GEO: R$2.000\nEscopo: Growth (Google Ads 3 contas) + GEO (Wikidata + Schema + Conteúdo)'
  );
  window.location.href='mailto:pedro.aureliano95@gmail.com?subject='+sub+'&body='+body;
  setTimeout(()=>{
    document.getElementById('formWrap').style.display='none';
    document.getElementById('successBox').classList.add('on');
  },1000);
}

/* CONFETTI */
let confettiAF,confettiParts=[];
function startConfetti(){
  const c=document.getElementById('confettiC');
  const ctx=c.getContext('2d');
  c.width=window.innerWidth;c.height=window.innerHeight;
  confettiParts=Array.from({length:120},()=>({
    x:Math.random()*c.width,y:Math.random()*c.height-c.height,
    w:6+Math.random()*6,h:10+Math.random()*6,
    color:['#4caf64','#2e9147','#a8e6b8','#3b82f6','#fff'][Math.floor(Math.random()*5)],
    r:Math.random()*360,dr:(Math.random()-0.5)*6,
    vy:2+Math.random()*4,vx:(Math.random()-0.5)*2
  }));
  (function loop(){
    ctx.clearRect(0,0,c.width,c.height);
    confettiParts.forEach(p=>{
      ctx.save();ctx.translate(p.x+p.w/2,p.y+p.h/2);
      ctx.rotate(p.r*Math.PI/180);ctx.fillStyle=p.color;
      ctx.fillRect(-p.w/2,-p.h/2,p.w,p.h);ctx.restore();
      p.x+=p.vx;p.y+=p.vy;p.r+=p.dr;
      if(p.y>c.height){p.y=-p.h;p.x=Math.random()*c.width;}
    });
    confettiAF=requestAnimationFrame(loop);
  })();
}
function stopConfetti(){
  cancelAnimationFrame(confettiAF);
  const c=document.getElementById('confettiC');
  c.getContext('2d').clearRect(0,0,c.width,c.height);
}
</script>
