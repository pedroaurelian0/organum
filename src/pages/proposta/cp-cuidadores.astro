---
// Proposta comercial — CP Cuidadores / CuidaRio / SIP
// URL: organum.com.br/proposta/cp-cuidadores
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Proposta Growth + GEO — CP Cuidadores × Nexxo + Organum</title>
<meta name="robots" content="noindex,nofollow">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --serif:'Playfair Display',Georgia,serif;
  --sans:'DM Sans',system-ui,sans-serif;
  --g400:#4caf64;--g500:#2e9147;--g600:#1d7a35;
  --b400:#3b82f6;--b600:#1d4ed8;
  --r400:#f87171;--a400:#fbbf24;
  --n950:#0c0a08;--n900:#141210;--n800:#211f1b;--n700:#2f2d28;
  --n600:#4a4741;--n500:#6b6860;--n400:#8c8a83;--n300:#b0ada4;
  --n200:#d4d1c8;--n100:#eceae4;--n50:#f8f6f0;
  --red:#e03c2f;
}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{font-family:var(--sans);background:var(--n950);color:var(--n100);font-size:16px;line-height:1.7;overflow-x:hidden}

/* ── UTILS ── */
.eyebrow{font-size:11px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--g400)}
.display{font-family:var(--serif);font-weight:400;line-height:1.1}
.display em{font-style:italic;color:var(--g400)}
.muted{color:var(--n500)}
.wrap{width:100%;max-width:700px;margin:0 auto;padding:0 20px}
section{padding:72px 0}
.divider{height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.07),transparent)}
.rev{opacity:0;transform:translateY(24px);transition:opacity .65s ease,transform .65s ease}
.rev.vis{opacity:1;transform:none}

/* ── NAV ── */
nav{position:fixed;top:0;left:0;right:0;z-index:200;padding:16px 20px;display:flex;justify-content:space-between;align-items:center;transition:background .4s}
nav.scrolled{background:rgba(12,10,8,.92);backdrop-filter:blur(20px);border-bottom:1px solid rgba(255,255,255,.06)}
.nav-logo{font-family:var(--serif);font-size:16px;color:var(--n100)}
.nav-pill{font-size:12px;font-weight:600;color:var(--g400);padding:8px 16px;border:1px solid rgba(76,175,100,.35);border-radius:100px;text-decoration:none;-webkit-tap-highlight-color:transparent}

/* ── HERO PESSOAL ── */
.hero{
  min-height:100svh;display:flex;flex-direction:column;justify-content:flex-end;
  padding:100px 20px 48px;position:relative;overflow:hidden;
}
.hero-bg{
  position:absolute;inset:0;
  background:
    radial-gradient(ellipse 140% 60% at 50% -5%,rgba(76,175,100,.13) 0%,transparent 60%),
    radial-gradient(ellipse 80% 40% at 80% 100%,rgba(59,130,246,.07) 0%,transparent 60%);
  pointer-events:none;
}
.hero-grain{
  position:absolute;inset:-50%;width:200%;height:200%;opacity:.35;pointer-events:none;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.05'/%3E%3C/svg%3E");
  animation:grain 8s steps(10) infinite;
}
@keyframes grain{0%,100%{transform:translate(0,0)}10%{transform:translate(-2%,-3%)}30%{transform:translate(-1%,4%)}50%{transform:translate(-3%,3%)}70%{transform:translate(-2%,1%)}90%{transform:translate(-1%,2%)}}
.hero-inner{position:relative;z-index:2;max-width:700px;margin:0 auto;width:100%}
.hero-from{font-size:12px;color:var(--n600);letter-spacing:.08em;text-transform:uppercase;margin-bottom:24px;opacity:0;animation:fadeUp .7s ease forwards .1s}
.hero-letter{font-family:var(--serif);font-size:clamp(15px,3.5vw,20px);font-weight:400;line-height:1.9;color:var(--n300);max-width:600px;margin-bottom:40px;opacity:0;animation:fadeUp .7s ease forwards .25s}
.hero-letter strong{color:var(--n100);font-weight:500}
.hero-letter .highlight{color:var(--g400);font-style:italic}
.hero-sig{font-family:var(--serif);font-size:16px;color:var(--n400);font-style:italic;opacity:0;animation:fadeUp .7s ease forwards .5s;margin-bottom:48px}
.hero-kpis{display:grid;grid-template-columns:1fr 1fr;gap:2px;background:rgba(255,255,255,.05);border-radius:14px;overflow:hidden;border:1px solid rgba(255,255,255,.08);opacity:0;animation:fadeUp .7s ease forwards .65s}
.kpi{background:var(--n900);padding:20px 16px;text-align:center}
.kpi-val{font-family:var(--serif);font-size:clamp(22px,5.5vw,32px);font-weight:600;display:block;line-height:1;margin-bottom:5px}
.kv-red{color:var(--r400)}
.kv-zero{color:#f87171;font-size:clamp(28px,7vw,42px)}
.kpi-lbl{font-size:11px;color:var(--n500);letter-spacing:.06em;text-transform:uppercase;line-height:1.4}
.scroll-cue{position:absolute;bottom:24px;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:6px;color:var(--n600);font-size:10px;letter-spacing:.12em;text-transform:uppercase;z-index:2;opacity:0;animation:fadeUp .8s ease forwards 1.1s}
.scroll-line{width:1px;height:28px;background:linear-gradient(to bottom,var(--n600),transparent);animation:pulse 2s ease infinite}

/* ── SECTION HEADER ── */
.sh{margin-bottom:40px}
.sh .eyebrow{margin-bottom:12px}
.sh h2{font-family:var(--serif);font-size:clamp(24px,5vw,40px);font-weight:400;line-height:1.2;margin-bottom:12px}
.sh p{font-size:15px;color:var(--n400);line-height:1.75;max-width:580px}

/* ── ALERTA CRÍTICO ── */
.alert-box{border-radius:14px;overflow:hidden;margin-bottom:32px}
.alert-header{display:flex;align-items:center;gap:12px;padding:16px 20px;background:rgba(224,60,47,.12);border:1px solid rgba(224,60,47,.2);border-bottom:none;border-radius:14px 14px 0 0}
.alert-icon{font-size:18px;flex-shrink:0}
.alert-title{font-size:13px;font-weight:600;color:var(--r400);letter-spacing:.04em}
.alert-body{padding:20px;background:rgba(224,60,47,.06);border:1px solid rgba(224,60,47,.15);border-top:none;border-radius:0 0 14px 14px;font-size:14px;color:var(--n300);line-height:1.75}
.alert-body strong{color:var(--r400)}

/* ── TABS ── */
.tab-bar{display:flex;gap:2px;background:var(--n800);border-radius:10px;padding:4px;margin-bottom:24px;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none}
.tab-bar::-webkit-scrollbar{display:none}
.tab{flex:1;min-width:80px;text-align:center;font-size:12px;font-weight:600;padding:10px 8px;border-radius:7px;cursor:pointer;color:var(--n500);border:none;background:none;font-family:var(--sans);letter-spacing:.02em;white-space:nowrap;transition:all .2s;-webkit-tap-highlight-color:transparent}
.tab.active{background:var(--n950);color:var(--n100);box-shadow:0 1px 4px rgba(0,0,0,.4)}
.tab-panel{display:none}
.tab-panel.active{display:block}

/* ── CPC CHART ── */
.cpc-chart{display:flex;align-items:flex-end;gap:6px;height:140px;padding:0 0 24px;position:relative}
.cpc-chart::after{content:'';position:absolute;bottom:24px;left:0;right:0;height:1px;background:rgba(255,255,255,.06)}
.cpc-bar-wrap{flex:1;display:flex;flex-direction:column;align-items:center;gap:6px}
.cpc-bar{width:100%;border-radius:4px 4px 0 0;background:rgba(248,113,113,.3);border-top:2px solid #f87171;transition:height .8s ease;position:relative;min-height:4px}
.cpc-bar-val{font-size:10px;font-weight:600;color:var(--r400);position:absolute;top:-20px;left:50%;transform:translateX(-50%);white-space:nowrap}
.cpc-month{font-size:10px;color:var(--n600);letter-spacing:.04em;text-transform:uppercase}

/* ── KW TABLE ── */
.kw-list{display:flex;flex-direction:column;gap:8px}
.kw-item{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center;padding:14px 16px;background:var(--n900);border:1px solid rgba(255,255,255,.06);border-radius:10px}
.kw-name{font-size:14px;font-weight:500;color:var(--n100);margin-bottom:3px}
.kw-meta{font-size:12px;color:var(--n500)}
.kw-cost{font-family:var(--serif);font-size:18px;font-weight:600;color:var(--r400);text-align:right;white-space:nowrap}
.kw-conv{font-size:10px;font-weight:600;color:var(--r400);text-align:right;letter-spacing:.06em;text-transform:uppercase}

/* ── TÉCNICO ── */
.tech-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:24px}
.tech-cell{padding:20px 16px;background:var(--n900);border-radius:12px;border:1px solid rgba(255,255,255,.06);text-align:center}
.tech-cell.bad{border-color:rgba(248,113,113,.3);background:rgba(248,113,113,.06)}
.tech-cell.ok{border-color:rgba(76,175,100,.3);background:rgba(76,175,100,.06)}
.tech-cell.warn{border-color:rgba(251,191,36,.3);background:rgba(251,191,36,.06)}
.tech-val{font-family:var(--serif);font-size:clamp(22px,5.5vw,30px);font-weight:600;display:block;line-height:1;margin-bottom:4px}
.tech-cell.bad .tech-val{color:var(--r400)}
.tech-cell.ok .tech-val{color:var(--g400)}
.tech-cell.warn .tech-val{color:var(--a400)}
.tech-lbl{font-size:11px;color:var(--n500);text-transform:uppercase;letter-spacing:.06em}

/* ── COMPETIDORES ── */
.comp-list{display:flex;flex-direction:column;gap:8px}
.comp-item{padding:16px;background:var(--n900);border:1px solid rgba(255,255,255,.06);border-radius:10px}
.comp-item.you{border-color:rgba(76,175,100,.3);background:rgba(76,175,100,.04)}
.comp-row{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px}
.comp-name{font-size:14px;font-weight:600;color:var(--n100)}
.comp-item.you .comp-name{color:var(--g400)}
.comp-share{font-size:12px;color:var(--n500)}
.comp-bar-track{height:6px;background:rgba(255,255,255,.08);border-radius:100px;overflow:hidden}
.comp-bar-fill{height:100%;border-radius:100px;background:rgba(248,113,113,.5);transition:width 1s ease}
.comp-item.you .comp-bar-fill{background:var(--g500)}

/* ── IA PANEL ── */
.ia-panel{border-radius:14px;overflow:hidden;margin:32px 0}
.ia-top{display:flex;align-items:center;gap:10px;padding:14px 16px;background:var(--n800);border:1px solid rgba(255,255,255,.08);border-bottom:none;border-radius:14px 14px 0 0}
.ia-dot{width:8px;height:8px;border-radius:50%;background:var(--g500);flex-shrink:0}
.ia-head{font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--n400)}
.ia-q{padding:14px 16px;font-size:14px;color:var(--n400);font-style:italic;background:rgba(255,255,255,.02);border-left:4px solid rgba(255,255,255,.08);margin:0 16px}
.ia-body{padding:20px 16px;background:rgba(255,255,255,.02);border:1px solid rgba(255,255,255,.06);border-top:none;border-radius:0 0 14px 14px;font-size:14px;color:var(--n300);line-height:1.75}
.ia-miss{display:inline-block;background:rgba(224,60,47,.15);color:var(--r400);border-radius:4px;padding:1px 7px;text-decoration:line-through;font-style:italic}
.ia-pres{color:var(--g400);font-weight:500}
.ia-note{font-size:13px;color:var(--n600);margin-top:12px;padding-top:12px;border-top:1px solid rgba(255,255,255,.06)}
.ia-stat{display:flex;align-items:flex-start;gap:16px;padding:16px 20px;border-radius:10px;border-left:3px solid transparent}
.ia-stat.bad{background:rgba(224,60,47,.07);border-left-color:var(--r400)}
.ia-stat.pos{background:rgba(76,175,100,.07);border-left-color:var(--g400)}
.ia-stat-num{font-family:var(--serif);font-size:28px;font-weight:600;line-height:1;flex-shrink:0;padding-top:2px}
.ia-stat.bad .ia-stat-num{color:var(--r400)}
.ia-stat.pos .ia-stat-num{color:var(--g400)}
.ia-stat-txt{font-size:14px;color:var(--n400);line-height:1.6}

/* ── MÓDULOS ── */
.modulo{margin-bottom:40px}
.modulo-header{display:flex;align-items:flex-start;gap:14px;padding:20px;background:var(--n900);border:1px solid rgba(255,255,255,.07);border-bottom:none;border-radius:12px 12px 0 0}
.modulo-num{width:36px;height:36px;border-radius:50%;background:rgba(76,175,100,.15);border:1px solid rgba(76,175,100,.25);display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-size:14px;font-weight:600;color:var(--g400);flex-shrink:0}
.modulo-title h3{font-size:16px;font-weight:600;color:var(--n100);margin-bottom:3px}
.modulo-title p{font-size:13px;color:var(--n500)}
.modulo-rows{border:1px solid rgba(255,255,255,.07);border-top:none;border-radius:0 0 12px 12px;overflow:hidden}
.mrow{display:grid;grid-template-columns:1fr;padding:14px 16px;border-bottom:1px solid rgba(255,255,255,.04);background:var(--n900)}
.mrow:last-child{border-bottom:none}
.mrow strong{font-size:14px;font-weight:600;color:var(--n100);margin-bottom:4px;display:block}
.mrow span{font-size:13px;color:var(--n500);line-height:1.6}
.mrow-tag{font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:2px 8px;border-radius:100px;margin-top:6px;display:inline-block}
.mrow-tag.s1{background:rgba(224,60,47,.15);color:var(--r400)}
.mrow-tag.s2{background:rgba(217,119,6,.15);color:var(--a400)}
.mrow-tag.s3{background:rgba(76,175,100,.15);color:var(--g400)}

/* ── PROJEÇÃO ── */
.compare-grid{display:flex;flex-direction:column;gap:8px;margin-bottom:32px}
.cmp{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:8px;padding:16px;background:var(--n900);border:1px solid rgba(255,255,255,.06);border-radius:10px}
.cmp-lbl{font-size:11px;color:var(--n600);letter-spacing:.05em;text-transform:uppercase;margin-bottom:3px}
.cmp-vb{font-family:var(--serif);font-size:15px;color:var(--r400);font-weight:600}
.cmp-va{font-family:var(--serif);font-size:15px;color:var(--g400);font-weight:600;text-align:right}
.cmp-lbl-r{text-align:right}
.cmp-arrow{color:var(--g500);font-size:16px;flex-shrink:0}
.proj-months{display:flex;flex-direction:column;gap:8px;margin-bottom:32px}
.pm{padding:16px 20px;background:var(--n900);border:1px solid rgba(255,255,255,.06);border-radius:10px}
.pm-header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px}
.pm-label{font-size:12px;font-weight:600;color:var(--n300);letter-spacing:.04em}
.pm-total{font-family:var(--serif);font-size:20px;font-weight:600;color:var(--g400)}
.pm-bar-wrap{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.pm-bar-item{display:flex;flex-direction:column;gap:5px}
.pm-bar-lbl{font-size:10px;color:var(--n600);text-transform:uppercase;letter-spacing:.06em}
.pm-track{height:6px;background:rgba(255,255,255,.08);border-radius:100px;overflow:hidden}
.pm-fill-ads{background:rgba(59,130,246,.5);height:100%;border-radius:100px;transition:width 1s ease}
.pm-fill-org{background:rgba(76,175,100,.6);height:100%;border-radius:100px;transition:width 1s ease}
.pm-nums{font-size:12px;color:var(--n500)}
.roi-box{padding:32px 24px;background:rgba(76,175,100,.07);border:1px solid rgba(76,175,100,.18);border-radius:14px;margin-bottom:32px}
.roi-box h3{font-family:var(--serif);font-size:20px;font-weight:400;color:var(--n100);margin-bottom:16px}
.roi-row{display:flex;justify-content:space-between;align-items:baseline;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.05);font-size:14px}
.roi-row:last-child{border-bottom:none;font-weight:600;font-size:16px}
.roi-row span:first-child{color:var(--n400)}
.roi-row span:last-child{font-family:var(--serif);color:var(--g400)}

/* ── INVESTIMENTO ── */
.inv-cards{display:flex;flex-direction:column;gap:16px;margin-bottom:32px}
.inv-main{background:var(--n900);border:2px solid rgba(76,175,100,.35);border-radius:16px;padding:32px 24px;position:relative}
.inv-secondary{background:var(--n900);border:1px solid rgba(255,255,255,.08);border-radius:16px;padding:28px 24px;position:relative}
.inv-badge{position:absolute;top:-13px;left:24px;font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;background:var(--g500);color:#fff;padding:4px 14px;border-radius:100px}
.inv-price{font-family:var(--serif);font-size:clamp(40px,9vw,56px);font-weight:600;color:var(--n50);line-height:1;margin-bottom:4px}
.inv-note{font-size:13px;color:var(--n500);margin-bottom:24px}
.inv-list{list-style:none;display:flex;flex-direction:column;gap:10px;margin-bottom:24px}
.inv-list li{font-size:14px;color:var(--n400);display:flex;align-items:flex-start;gap:10px;line-height:1.5}
.inv-list li::before{content:'✓';color:var(--g500);flex-shrink:0;font-weight:600}
.inv-verba{padding:16px;background:rgba(59,130,246,.08);border:1px solid rgba(59,130,246,.2);border-radius:10px;font-size:13px;color:var(--n400);line-height:1.7}
.inv-verba strong{color:var(--b400)}
.diff-table{display:flex;flex-direction:column;gap:2px;border-radius:12px;overflow:hidden;border:1px solid rgba(255,255,255,.07);margin-bottom:32px}
.diff-head{display:grid;grid-template-columns:1fr 1fr 1fr;background:var(--n800);padding:10px 14px;gap:8px}
.diff-head span{font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--n500)}
.diff-row{display:grid;grid-template-columns:1fr 1fr 1fr;padding:13px 14px;background:var(--n900);gap:8px;border-top:1px solid rgba(255,255,255,.04)}
.diff-row span{font-size:13px;line-height:1.5}
.diff-row span:first-child{color:var(--n300);font-weight:500}
.diff-row span:nth-child(2){color:var(--r400)}
.diff-row span:nth-child(3){color:var(--g400)}

/* ── PRÓXIMOS PASSOS ── */
.steps{display:flex;flex-direction:column;gap:8px}
.step{display:grid;grid-template-columns:60px 1fr;gap:16px;padding:16px;background:var(--n900);border:1px solid rgba(255,255,255,.06);border-radius:10px}
.step-when{font-size:11px;font-weight:600;color:var(--g500);letter-spacing:.06em;text-transform:uppercase;padding-top:3px;line-height:1.4}
.step strong{display:block;font-size:14px;font-weight:600;color:var(--n100);margin-bottom:3px}
.step span{font-size:13px;color:var(--n500)}
.step.urgent{border-color:rgba(224,60,47,.25);background:rgba(224,60,47,.05)}
.step.urgent .step-when{color:var(--r400)}

/* ── CTA ── */
.cta-sec{padding:72px 0;text-align:center;background:linear-gradient(180deg,transparent,rgba(76,175,100,.07) 50%,transparent)}
.cta-sec h2{font-family:var(--serif);font-size:clamp(26px,6vw,44px);font-weight:400;margin-bottom:14px}
.cta-sec p{font-size:15px;color:var(--n400);margin-bottom:40px;max-width:460px;margin-left:auto;margin-right:auto}
.cta-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;background:var(--g500);color:#fff;font-family:var(--sans);font-size:15px;font-weight:600;padding:18px 40px;border-radius:100px;border:none;cursor:pointer;width:100%;max-width:360px;transition:background .25s;-webkit-tap-highlight-color:transparent}
.cta-btn:active{background:var(--g600);transform:scale(.98)}

/* ── FOOTER ── */
footer{padding:40px 20px;text-align:center;border-top:1px solid rgba(255,255,255,.05)}
.foot-logos{font-family:var(--serif);font-size:18px;color:var(--n400);margin-bottom:6px}
.foot-sub{font-size:12px;color:var(--n700)}

/* ── OVERLAY ── */
.overlay{display:none;position:fixed;inset:0;z-index:500;background:rgba(12,10,8,.97);overflow-y:auto;-webkit-overflow-scrolling:touch}
.overlay.on{display:block}
.confetti-c{position:fixed;inset:0;pointer-events:none;z-index:501}
.ov-inner{position:relative;z-index:502;max-width:480px;margin:0 auto;padding:64px 20px 48px;text-align:center}
.check-ring{width:72px;height:72px;border-radius:50%;background:rgba(76,175,100,.15);border:2px solid var(--g400);display:flex;align-items:center;justify-content:center;margin:0 auto 24px;animation:popIn .5s cubic-bezier(.175,.885,.32,1.275) forwards}
.check-ring svg{width:32px;height:32px;stroke:var(--g400);stroke-width:2.5;fill:none;stroke-dasharray:50;stroke-dashoffset:50;animation:dash .5s ease forwards .35s}
.ov-title{font-family:var(--serif);font-size:32px;font-weight:400;margin-bottom:10px;opacity:0;animation:fadeUp .5s ease forwards .5s}
.ov-sub{font-size:15px;color:var(--n400);margin-bottom:40px;opacity:0;animation:fadeUp .5s ease forwards .65s}
.form-wrap{text-align:left;opacity:0;animation:fadeUp .5s ease forwards .8s}
.fg{margin-bottom:16px}
.fg label{display:block;font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--n500);margin-bottom:7px}
.fg input,.fg textarea{width:100%;background:var(--n800);border:1px solid rgba(255,255,255,.1);border-radius:8px;color:var(--n100);font-family:var(--sans);font-size:15px;padding:14px 16px;outline:none;transition:border-color .2s;-webkit-appearance:none}
.fg input:focus,.fg textarea:focus{border-color:var(--g400)}
.fg textarea{resize:vertical;min-height:80px}
.check-lbl{display:flex;align-items:flex-start;gap:12px;padding:16px;background:rgba(76,175,100,.07);border:1px solid rgba(76,175,100,.2);border-radius:12px;margin-bottom:24px;cursor:pointer}
.check-lbl input{width:18px;height:18px;flex-shrink:0;margin-top:3px;accent-color:var(--g400);cursor:pointer}
.check-txt{font-size:13px;color:var(--n500);line-height:1.6}
.check-txt strong{color:var(--n100)}
.sub-btn{width:100%;background:var(--g500);color:#fff;font-family:var(--sans);font-size:15px;font-weight:600;padding:16px;border-radius:100px;border:none;cursor:pointer;transition:background .25s;-webkit-tap-highlight-color:transparent}
.sub-btn:active{background:var(--g600)}
.sub-btn:disabled{opacity:.45;cursor:not-allowed}
.success-box{display:none;padding:32px;background:rgba(76,175,100,.08);border:1px solid rgba(76,175,100,.2);border-radius:16px;text-align:center}
.success-box.on{display:block}
.success-box h3{font-family:var(--serif);font-size:24px;font-weight:400;color:var(--g400);margin-bottom:8px}
.success-box p{font-size:14px;color:var(--n500)}
.back-btn{background:none;border:none;color:var(--n600);font-size:13px;font-family:var(--sans);cursor:pointer;margin-top:20px;padding:8px 0;display:block;margin-left:auto;margin-right:auto}

/* ── ANIM ── */
@keyframes fadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
@keyframes popIn{from{transform:scale(.4);opacity:0}to{transform:scale(1);opacity:1}}
@keyframes dash{to{stroke-dashoffset:0}}
@keyframes pulse{0%,100%{opacity:.35}50%{opacity:1}}

/* ── DESKTOP ── */
@media(min-width:640px){
  .wrap{padding:0 40px}
  nav{padding:20px 40px}
  .hero{padding:120px 40px 64px}
  .tech-grid{grid-template-columns:repeat(4,1fr)}
  .inv-cards{flex-direction:row}
  .inv-main,.inv-secondary{flex:1}
  .cta-btn{width:auto}
  .step{grid-template-columns:80px 1fr}
}
</style>
</head>
<body>

