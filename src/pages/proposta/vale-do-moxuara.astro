---
// Proposta comercial — Vale do Moxuara
// URL: organum.com.br/proposta/vale-do-moxuara
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Diagnóstico SEO — Vale do Moxuara × Organum</title>
<meta name="robots" content="noindex,nofollow">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
/* ─── RESET & TOKENS ─────────────────────────────── */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --serif:'Playfair Display',Georgia,serif;
  --sans:'DM Sans',system-ui,sans-serif;
  --g400:#4caf64;--g500:#2e9147;--g600:#1d7a35;
  --n950:#0c0a08;--n900:#141210;--n800:#211f1b;--n700:#2f2d28;
  --n600:#4a4741;--n500:#6b6860;--n400:#8c8a83;--n300:#b0ada4;
  --n200:#d4d1c8;--n100:#eceae4;--n50:#f8f6f0;
  --red:#e03c2f;--amber:#d97706;
  --sp4:4px;--sp8:8px;--sp12:12px;--sp16:16px;--sp20:20px;
  --sp24:24px;--sp32:32px;--sp40:40px;--sp48:48px;--sp64:64px;
  --r8:8px;--r12:12px;--r16:16px;
}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{font-family:var(--sans);background:var(--n950);color:var(--n100);font-size:16px;line-height:1.7;overflow-x:hidden}

/* ─── TYPOGRAPHY ─────────────────────────────────── */
.eyebrow{font-size:11px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--g400)}
.display{font-family:var(--serif);font-weight:400;line-height:1.1}
.display em{font-style:italic;color:var(--g400)}
.lead{font-size:17px;font-weight:300;color:var(--n300);line-height:1.75}
.muted{color:var(--n500)}

/* ─── LAYOUT ─────────────────────────────────────── */
.wrap{width:100%;max-width:680px;margin:0 auto;padding:0 var(--sp20)}
section{padding:var(--sp64) 0}
.divider{height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.07),transparent)}

/* ─── NAV ────────────────────────────────────────── */
nav{
  position:fixed;top:0;left:0;right:0;z-index:200;
  padding:var(--sp16) var(--sp20);
  display:flex;justify-content:space-between;align-items:center;
  transition:background .4s,backdrop-filter .4s;
}
nav.scrolled{background:rgba(12,10,8,.9);backdrop-filter:blur(20px);border-bottom:1px solid rgba(255,255,255,.06)}
.nav-logo{font-family:var(--serif);font-size:17px;color:var(--n100)}
.nav-pill{
  font-size:12px;font-weight:600;letter-spacing:.04em;
  color:var(--g400);padding:8px 18px;
  border:1px solid rgba(76,175,100,.35);border-radius:100px;
  text-decoration:none;transition:background .25s;
  -webkit-tap-highlight-color:transparent;
}
.nav-pill:active{background:rgba(76,175,100,.12)}

/* ─── HERO ───────────────────────────────────────── */
.hero{
  min-height:100svh;
  display:flex;flex-direction:column;justify-content:center;
  padding:calc(80px + var(--sp40)) var(--sp20) var(--sp64);
  text-align:center;
  position:relative;overflow:hidden;
}
.hero::before{
  content:'';position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(ellipse 120% 60% at 50% -10%,rgba(76,175,100,.14) 0%,transparent 65%);
}
/* animated noise grain */
.hero::after{
  content:'';position:absolute;inset:-50%;
  width:200%;height:200%;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.04'/%3E%3C/svg%3E");
  opacity:.4;pointer-events:none;animation:grain 8s steps(10) infinite;
}
@keyframes grain{0%,100%{transform:translate(0,0)}10%{transform:translate(-2%,-3%)}20%{transform:translate(3%,2%)}30%{transform:translate(-1%,4%)}40%{transform:translate(2%,-1%)}50%{transform:translate(-3%,3%)}60%{transform:translate(1%,-2%)}70%{transform:translate(-2%,1%)}80%{transform:translate(3%,-3%)}90%{transform:translate(-1%,2%)}}

.hero-eyebrow{margin-bottom:var(--sp24);opacity:0;animation:fadeUp .7s ease forwards .1s}
.hero-h1{font-size:clamp(36px,9vw,72px);margin-bottom:var(--sp20);opacity:0;animation:fadeUp .7s ease forwards .25s}
.hero-lead{max-width:520px;margin:0 auto var(--sp40);opacity:0;animation:fadeUp .7s ease forwards .4s}

/* KPI strip */
.kpi-strip{
  display:grid;grid-template-columns:1fr 1fr;gap:2px;
  background:rgba(255,255,255,.06);border-radius:var(--r16);overflow:hidden;
  border:1px solid rgba(255,255,255,.08);
  opacity:0;animation:fadeUp .7s ease forwards .55s;
}
.kpi-cell{
  background:var(--n900);padding:var(--sp20) var(--sp16);text-align:center;
}
.kpi-val{
  font-family:var(--serif);font-size:clamp(26px,6vw,38px);font-weight:600;
  color:#f87171;display:block;line-height:1;margin-bottom:6px;
}
.kpi-val.good{color:var(--g400)}
.kpi-lbl{font-size:11px;letter-spacing:.07em;text-transform:uppercase;color:var(--n500)}

.scroll-cue{
  position:absolute;bottom:var(--sp24);left:50%;transform:translateX(-50%);
  display:flex;flex-direction:column;align-items:center;gap:6px;
  color:var(--n600);font-size:10px;letter-spacing:.12em;text-transform:uppercase;
  opacity:0;animation:fadeUp .8s ease forwards 1s;
}
.scroll-line{width:1px;height:32px;background:linear-gradient(to bottom,var(--n600),transparent);animation:pulse 2s ease infinite}

/* ─── PERGUNTA PROVOCATIVA ───────────────────────── */
.provoca{
  padding:var(--sp64) var(--sp20);
  background:linear-gradient(180deg,var(--n950) 0%,rgba(76,175,100,.05) 50%,var(--n950) 100%);
}
.provoca-q{
  font-family:var(--serif);font-size:clamp(22px,5vw,40px);font-weight:400;
  line-height:1.3;text-align:center;max-width:600px;margin:0 auto var(--sp32);
}
.provoca-q mark{
  background:none;color:var(--g400);
  border-bottom:2px solid rgba(76,175,100,.4);
  padding-bottom:2px;
}
.ai-demo{
  max-width:560px;margin:0 auto;
  background:var(--n900);border:1px solid rgba(255,255,255,.08);
  border-radius:var(--r16);overflow:hidden;
}
.ai-header{
  display:flex;align-items:center;gap:10px;
  padding:var(--sp12) var(--sp16);
  background:var(--n800);border-bottom:1px solid rgba(255,255,255,.06);
}
.ai-dot{width:8px;height:8px;border-radius:50%;background:var(--g500)}
.ai-name{font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--n400)}
.ai-query{
  padding:var(--sp16);
  font-size:14px;color:var(--n400);
  border-bottom:1px solid rgba(255,255,255,.04);
  font-style:italic;
}
.ai-answer{padding:var(--sp16);font-size:14px;line-height:1.7;color:var(--n300)}
.ai-missing{
  display:inline-block;background:rgba(224,60,47,.15);
  color:#f87171;border-radius:4px;padding:1px 6px;
  text-decoration:line-through;font-style:italic;
}
.ai-present{color:var(--g400);font-weight:500}

/* ─── SECTION HEADER ─────────────────────────────── */
.sec-head{margin-bottom:var(--sp40)}
.sec-head .eyebrow{margin-bottom:var(--sp12)}
.sec-head h2{font-family:var(--serif);font-size:clamp(24px,5vw,40px);font-weight:400;line-height:1.2;margin-bottom:var(--sp12)}
.sec-head p{font-size:15px;color:var(--n400);line-height:1.75}

/* ─── SCORE CARDS ────────────────────────────────── */
.score-stack{display:flex;flex-direction:column;gap:2px;border-radius:var(--r16);overflow:hidden;border:1px solid rgba(255,255,255,.06)}
.score-row{
  display:flex;align-items:flex-start;gap:var(--sp16);
  padding:var(--sp20);background:var(--n900);
  transition:background .2s;
  cursor:default;
}
.score-row:active{background:var(--n800)}
.score-icon{
  width:40px;height:40px;border-radius:var(--r8);flex-shrink:0;
  display:flex;align-items:center;justify-content:center;
  font-size:18px;
}
.ic-red{background:rgba(224,60,47,.12)}
.ic-amber{background:rgba(217,119,6,.12)}
.ic-blue{background:rgba(29,111,184,.12)}
.score-body{flex:1;min-width:0}
.score-tag{
  display:inline-flex;align-items:center;gap:4px;
  font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;
  padding:3px 9px;border-radius:100px;margin-bottom:6px;
}
.tag-r{background:rgba(224,60,47,.15);color:#f87171;border:1px solid rgba(224,60,47,.2)}
.tag-a{background:rgba(217,119,6,.15);color:#fbbf24;border:1px solid rgba(217,119,6,.2)}
.tag-b{background:rgba(29,111,184,.15);color:#60a5fa;border:1px solid rgba(29,111,184,.2)}
.score-body h3{font-size:15px;font-weight:600;color:var(--n100);margin-bottom:4px}
.score-body p{font-size:13px;color:var(--n500);line-height:1.6}
.score-num{font-family:var(--serif);font-size:11px;color:var(--n700);flex-shrink:0;padding-top:4px}

/* ─── METRO METRICS ──────────────────────────────── */
.metro-grid{display:grid;grid-template-columns:1fr 1fr;gap:var(--sp8);margin-bottom:var(--sp32)}
.metro{
  padding:var(--sp20) var(--sp16);
  background:var(--n900);border-radius:var(--r12);
  border:1px solid rgba(255,255,255,.06);
  text-align:center;
}
.metro.bad{border-color:rgba(224,60,47,.3);background:rgba(224,60,47,.06)}
.metro.good{border-color:rgba(76,175,100,.3);background:rgba(76,175,100,.06)}
.metro-val{font-family:var(--serif);font-size:clamp(24px,6vw,34px);font-weight:600;display:block;line-height:1;margin-bottom:4px}
.metro.bad .metro-val{color:#f87171}
.metro.good .metro-val{color:var(--g400)}
.metro-lbl{font-size:11px;color:var(--n500);letter-spacing:.06em;text-transform:uppercase}

/* ─── PROBLEMA ITEMS ─────────────────────────────── */
.prob-list{display:flex;flex-direction:column;gap:var(--sp8)}
.prob{
  display:grid;grid-template-columns:32px 1fr;gap:var(--sp12);
  padding:var(--sp16);background:var(--n900);
  border:1px solid rgba(255,255,255,.06);border-radius:var(--r12);
  opacity:0;transform:translateX(-16px);
  transition:opacity .5s ease,transform .5s ease;
}
.prob.vis{opacity:1;transform:none}
.prob-n{
  font-family:var(--serif);font-size:20px;font-weight:600;color:var(--n700);
  line-height:1;padding-top:4px;text-align:center;
}
.prob strong{display:block;font-size:14px;font-weight:600;color:var(--n100);margin-bottom:4px}
.prob span{font-size:13px;color:var(--n500);line-height:1.6;display:block;margin-bottom:8px}
.prob-badge{
  display:inline-block;font-size:9px;font-weight:700;
  letter-spacing:.1em;text-transform:uppercase;
  padding:3px 8px;border-radius:100px;
}
.pb-r{background:rgba(224,60,47,.15);color:#f87171}
.pb-a{background:rgba(217,119,6,.15);color:#fbbf24}

/* ─── PERGUNTA 2 ─────────────────────────────────── */
.interlude{
  padding:var(--sp64) var(--sp20);
  text-align:center;
}
.interlude-q{
  font-family:var(--serif);font-size:clamp(20px,5vw,36px);
  font-weight:400;line-height:1.4;
  max-width:540px;margin:0 auto var(--sp24);
}
.interlude-q strong{color:var(--g400)}
.interlude-note{font-size:14px;color:var(--n500);max-width:440px;margin:0 auto}

/* ─── TABLE ──────────────────────────────────────── */
.tbl-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;margin-bottom:var(--sp32);border-radius:var(--r12);border:1px solid rgba(255,255,255,.07)}
table{width:100%;border-collapse:collapse;font-size:13px;min-width:400px}
th{text-align:left;font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--n500);padding:12px var(--sp16);background:var(--n900);border-bottom:1px solid rgba(255,255,255,.07)}
td{padding:13px var(--sp16);color:var(--n300);border-bottom:1px solid rgba(255,255,255,.04)}
tr:last-child td{border-bottom:none}
tr:hover td{background:rgba(255,255,255,.015)}
.cr{color:#f87171;font-family:var(--serif)}
.ca{color:#fbbf24}
.cg{color:var(--g400)}

/* ─── PERGUNTA 3 — IA ────────────────────────────── */
.ia-provoca{
  padding:var(--sp64) var(--sp20);
  background:var(--n900);border-top:1px solid rgba(255,255,255,.06);
  border-bottom:1px solid rgba(255,255,255,.06);
}
.ia-provoca-inner{max-width:640px;margin:0 auto}
.ia-q{
  font-family:var(--serif);font-size:clamp(22px,5vw,38px);
  font-weight:400;line-height:1.3;margin-bottom:var(--sp24);
}
.ia-q mark{background:none;color:var(--g400);border-bottom:2px solid rgba(76,175,100,.35);padding-bottom:2px}
.ia-p{font-size:15px;color:var(--n400);line-height:1.8;margin-bottom:var(--sp24)}
.ia-stat{
  display:flex;align-items:flex-start;gap:var(--sp16);
  padding:var(--sp16);
  background:rgba(224,60,47,.07);
  border-left:3px solid #f87171;
  border-radius:0 var(--r8) var(--r8) 0;
  margin-bottom:var(--sp12);
}
.ia-stat-num{font-family:var(--serif);font-size:28px;font-weight:600;color:#f87171;line-height:1;flex-shrink:0}
.ia-stat-txt{font-size:13px;color:var(--n400);line-height:1.6;padding-top:4px}
.ia-stat.pos{background:rgba(76,175,100,.07);border-left-color:var(--g400)}
.ia-stat.pos .ia-stat-num{color:var(--g400)}

/* ─── PROJEÇÃO ────────────────────────────────────── */
.proj-cards{display:flex;flex-direction:column;gap:var(--sp8)}
.proj-item2{
  display:grid;grid-template-columns:1fr auto 1fr;
  align-items:center;gap:var(--sp8);
  padding:var(--sp16);background:var(--n900);
  border:1px solid rgba(255,255,255,.06);border-radius:var(--r12);
}
.pj-before,.pj-after{display:flex;flex-direction:column}
.pj-lbl{font-size:10px;color:var(--n600);letter-spacing:.06em;text-transform:uppercase;margin-bottom:3px}
.pj-val-b{font-family:var(--serif);font-size:15px;color:#f87171;font-weight:600}
.pj-val-a{font-family:var(--serif);font-size:15px;color:var(--g400);font-weight:600;text-align:right}
.pj-lbl-a{text-align:right}
.pj-arrow{color:var(--g500);font-size:18px;line-height:1;flex-shrink:0}

/* ─── MÉTODO ─────────────────────────────────────── */
.timeline{position:relative;padding-left:var(--sp32)}
.timeline::before{content:'';position:absolute;left:0;top:0;bottom:0;width:1px;background:linear-gradient(to bottom,var(--g500) 0%,transparent 100%)}
.tl-step{
  position:relative;padding:0 0 var(--sp40) var(--sp24);
  opacity:0;transform:translateY(16px);
  transition:opacity .6s ease,transform .6s ease;
}
.tl-step.vis{opacity:1;transform:none}
.tl-step::before{
  content:'';position:absolute;left:-4px;top:6px;
  width:9px;height:9px;border-radius:50%;
  background:var(--g400);border:2px solid var(--n950);
}
.tl-num{font-size:10px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--g500);margin-bottom:6px}
.tl-step h3{font-size:17px;font-weight:600;color:var(--n100);margin-bottom:6px}
.tl-step p{font-size:14px;color:var(--n500);line-height:1.7;margin-bottom:10px}
.tl-tag{display:inline-block;font-size:10px;font-weight:600;letter-spacing:.08em;padding:3px 10px;border-radius:100px;background:rgba(76,175,100,.1);color:var(--g400);border:1px solid rgba(76,175,100,.2)}

/* ─── INVESTIMENTO ───────────────────────────────── */
.inv-cards{display:flex;flex-direction:column;gap:var(--sp16);margin-bottom:var(--sp32)}
.inv-card{
  background:var(--n900);border:1px solid rgba(255,255,255,.07);
  border-radius:var(--r16);padding:var(--sp32) var(--sp24);
  position:relative;
}
.inv-card.feat{border-color:rgba(76,175,100,.35);background:rgba(76,175,100,.04)}
.inv-badge{
  position:absolute;top:-13px;left:var(--sp24);
  font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;
  background:var(--g500);color:#fff;padding:4px 14px;border-radius:100px;
}
.inv-price{font-family:var(--serif);font-size:clamp(34px,8vw,46px);font-weight:600;color:var(--n50);line-height:1;margin-bottom:4px}
.inv-note{font-size:12px;color:var(--n500);margin-bottom:var(--sp20)}
.inv-card h3{font-size:15px;font-weight:600;color:var(--n300);margin-bottom:var(--sp16)}
.inv-list{list-style:none;display:flex;flex-direction:column;gap:10px}
.inv-list li{font-size:13px;color:var(--n500);display:flex;align-items:flex-start;gap:10px;line-height:1.5}
.inv-list li::before{content:'→';color:var(--g500);flex-shrink:0;margin-top:1px}

/* ─── CALLOUT ────────────────────────────────────── */
.callout{
  padding:var(--sp32) var(--sp24);
  background:rgba(76,175,100,.06);
  border:1px solid rgba(76,175,100,.15);
  border-radius:var(--r16);
}
.callout h3{font-family:var(--serif);font-size:20px;font-weight:400;color:var(--n100);margin-bottom:10px}
.callout p{font-size:14px;color:var(--n400);line-height:1.8}
.callout p strong{color:var(--g400)}

/* ─── CTA SECTION ────────────────────────────────── */
.cta-sec{
  padding:var(--sp64) var(--sp20);
  text-align:center;
  background:linear-gradient(180deg,transparent 0%,rgba(76,175,100,.07) 50%,transparent 100%);
}
.cta-sec h2{font-family:var(--serif);font-size:clamp(26px,6vw,44px);font-weight:400;margin-bottom:var(--sp12)}
.cta-sec p{font-size:15px;color:var(--n400);margin-bottom:var(--sp40);max-width:480px;margin-left:auto;margin-right:auto}
.cta-btn{
  display:inline-flex;align-items:center;justify-content:center;gap:10px;
  background:var(--g500);color:#fff;
  font-family:var(--sans);font-size:15px;font-weight:600;letter-spacing:.02em;
  padding:18px var(--sp40);border-radius:100px;border:none;cursor:pointer;
  width:100%;max-width:360px;
  transition:background .25s,transform .2s,box-shadow .25s;
  -webkit-tap-highlight-color:transparent;
}
.cta-btn:active{background:var(--g600);transform:scale(.98)}

/* ─── FOOTER ─────────────────────────────────────── */
footer{padding:var(--sp40) var(--sp20);text-align:center;border-top:1px solid rgba(255,255,255,.05)}
.foot-logo{font-family:var(--serif);font-size:20px;color:var(--n400);margin-bottom:6px}
.foot-sub{font-size:12px;color:var(--n700)}

/* ─── ACCEPT OVERLAY ─────────────────────────────── */
.overlay{
  display:none;position:fixed;inset:0;z-index:500;
  background:rgba(12,10,8,.97);
  overflow-y:auto;
  -webkit-overflow-scrolling:touch;
}
.overlay.on{display:block}
.confetti-c{position:fixed;inset:0;pointer-events:none;z-index:501}
.ov-inner{
  position:relative;z-index:502;
  max-width:480px;margin:0 auto;
  padding:var(--sp64) var(--sp20) var(--sp40);
  text-align:center;
}
.check-ring{
  width:72px;height:72px;border-radius:50%;
  background:rgba(76,175,100,.15);border:2px solid var(--g400);
  display:flex;align-items:center;justify-content:center;
  margin:0 auto var(--sp24);
  animation:popIn .5s cubic-bezier(.175,.885,.32,1.275) forwards;
}
.check-ring svg{width:32px;height:32px;stroke:var(--g400);stroke-width:2.5;fill:none;stroke-dasharray:50;stroke-dashoffset:50;animation:dash .5s ease forwards .35s}
.ov-title{font-family:var(--serif);font-size:32px;font-weight:400;margin-bottom:10px;opacity:0;animation:fadeUp .5s ease forwards .5s}
.ov-sub{font-size:15px;color:var(--n400);margin-bottom:var(--sp40);opacity:0;animation:fadeUp .5s ease forwards .65s}
.form-wrap{text-align:left;opacity:0;animation:fadeUp .5s ease forwards .8s}
.fg{margin-bottom:var(--sp16)}
.fg label{display:block;font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--n500);margin-bottom:7px}
.fg input,.fg textarea{
  width:100%;background:var(--n800);
  border:1px solid rgba(255,255,255,.1);border-radius:var(--r8);
  color:var(--n100);font-family:var(--sans);font-size:15px;
  padding:14px var(--sp16);outline:none;
  transition:border-color .2s;
  -webkit-appearance:none;
}
.fg input:focus,.fg textarea:focus{border-color:var(--g400)}
.fg textarea{resize:vertical;min-height:80px}
.check-lbl{
  display:flex;align-items:flex-start;gap:12px;
  padding:var(--sp16);
  background:rgba(76,175,100,.07);
  border:1px solid rgba(76,175,100,.2);border-radius:var(--r12);
  margin-bottom:var(--sp24);cursor:pointer;
}
.check-lbl input{width:18px;height:18px;flex-shrink:0;margin-top:3px;accent-color:var(--g400);cursor:pointer}
.check-txt{font-size:13px;color:var(--n500);line-height:1.6}
.check-txt strong{color:var(--n100)}
.sub-btn{
  width:100%;background:var(--g500);color:#fff;
  font-family:var(--sans);font-size:15px;font-weight:600;
  padding:16px;border-radius:100px;border:none;cursor:pointer;
  transition:background .25s;-webkit-tap-highlight-color:transparent;
}
.sub-btn:active{background:var(--g600)}
.sub-btn:disabled{opacity:.45;cursor:not-allowed}
.success-box{display:none;padding:var(--sp32);background:rgba(76,175,100,.08);border:1px solid rgba(76,175,100,.2);border-radius:var(--r16);text-align:center}
.success-box.on{display:block}
.success-box h3{font-family:var(--serif);font-size:24px;font-weight:400;color:var(--g400);margin-bottom:8px}
.success-box p{font-size:14px;color:var(--n500)}
.back-btn{background:none;border:none;color:var(--n600);font-size:13px;font-family:var(--sans);cursor:pointer;margin-top:var(--sp20);padding:var(--sp8) 0}

/* ─── ANIMATIONS ─────────────────────────────────── */
@keyframes fadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
@keyframes popIn{from{transform:scale(.4);opacity:0}to{transform:scale(1);opacity:1}}
@keyframes dash{to{stroke-dashoffset:0}}
@keyframes pulse{0%,100%{opacity:.35}50%{opacity:1}}

/* ─── SCROLL REVEAL ──────────────────────────────── */
.rev{opacity:0;transform:translateY(24px);transition:opacity .65s ease,transform .65s ease}
.rev.vis{opacity:1;transform:none}

/* ─── DESKTOP UPGRADES (>640px) ─────────────────── */
@media(min-width:640px){
  .wrap{padding:0 var(--sp40)}
  section{padding:var(--sp64) 0}
  .kpi-strip{grid-template-columns:repeat(4,1fr)}
  .metro-grid{grid-template-columns:repeat(4,1fr)}
  .inv-cards{flex-direction:row}
  .inv-card{flex:1}
  .cta-btn{width:auto}
  nav{padding:var(--sp20) var(--sp40)}
  .hero{padding:calc(80px + var(--sp64)) var(--sp40) var(--sp64)}
  .proj-item2{padding:var(--sp20) var(--sp24)}
  .pj-val-b,.pj-val-a{font-size:18px}
}
</style>
