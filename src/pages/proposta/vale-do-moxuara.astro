<!-- ══════════ CTA ══════════ -->
<section class="cta-sec">
  <div class="wrap">
    <h2>Pronto para ser<br>encontrado?</h2>
    <p>Clique abaixo para aceitar formalmente esta proposta. O formulário registra data, hora e dados para formalização do contrato.</p>
    <button class="cta-btn" onclick="openAccept()">Aceitar proposta →</button>
  </div>
</section>

<footer>
  <div class="foot-logo">Organum</div>
  <div class="foot-sub">SEO Orgânico B2B e GEO · organum.com.br · Pedro Aureliano · Junho 2026</div>
</footer>

<!-- ══════════ OVERLAY ══════════ -->
<div class="overlay" id="overlay">
  <canvas class="confetti-c" id="confettiC"></canvas>
  <div class="ov-inner">
    <div class="check-ring">
      <svg viewBox="0 0 36 36"><polyline points="4,18 14,28 32,8"/></svg>
    </div>
    <h2 class="ov-title">Proposta aceita.</h2>
    <p class="ov-sub">Preencha seus dados para formalizar o engajamento. Você receberá o contrato em até 24 horas.</p>
    <div class="form-wrap" id="formWrap">
      <div class="fg"><label>Nome completo</label><input type="text" id="f_nome" placeholder="Seu nome completo" autocomplete="name"></div>
      <div class="fg"><label>E-mail</label><input type="email" id="f_email" placeholder="seu@email.com" autocomplete="email"></div>
      <div class="fg"><label>Telefone / WhatsApp</label><input type="tel" id="f_tel" placeholder="(27) 99999-9999" autocomplete="tel"></div>
      <div class="fg"><label>CNPJ</label><input type="text" id="f_cnpj" placeholder="00.000.000/0000-00"></div>
      <div class="fg"><label>Razão social</label><input type="text" id="f_razao" placeholder="Nome jurídico da empresa" autocomplete="organization"></div>
      <div class="fg"><label>Observações (opcional)</label><textarea id="f_obs" placeholder="Algum detalhe adicional..."></textarea></div>
      <label class="check-lbl">
        <input type="checkbox" id="f_aceite">
        <span class="check-txt"><strong>Li e aceito os termos desta proposta.</strong> Estou ciente de que o preenchimento e envio constituem aceite formal da proposta comercial da Organum, incluindo valores, escopo e condições aqui descritos. Aceite registrado em: <span id="ts"></span></span>
      </label>
      <button class="sub-btn" id="subBtn" onclick="submitForm()">Confirmar aceite e enviar</button>
    </div>
    <div class="success-box" id="successBox">
      <h3>Confirmado.</h3>
      <p>Pedro Aureliano entrará em contato em até 24 horas para enviar o contrato e confirmar o início do engajamento.</p>
    </div>
    <button class="back-btn" onclick="closeAccept()">← Voltar à proposta</button>
  </div>
</div>

<script>
/* NAV */
const nav=document.getElementById('nav');
window.addEventListener('scroll',()=>nav.classList.toggle('scrolled',scrollY>50),{passive:true});

/* SCROLL REVEAL */
const io=new IntersectionObserver((entries)=>{
  entries.forEach((e,i)=>{
    if(e.isIntersecting){
      setTimeout(()=>e.target.classList.add('vis'),i*60);
      io.unobserve(e.target);
    }
  });
},{threshold:.08,rootMargin:'0px 0px -40px 0px'});
document.querySelectorAll('.rev,.tl-step,.prob').forEach(el=>io.observe(el));

/* ACCEPT */
function openAccept(){
  document.getElementById('overlay').classList.add('on');
  document.body.style.overflow='hidden';
  document.getElementById('ts').textContent=new Date().toLocaleString('pt-BR',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit',second:'2-digit'});
  startConfetti();setTimeout(stopConfetti,3800);
}
function closeAccept(){
  document.getElementById('overlay').classList.remove('on');
  document.body.style.overflow='';
}

/* FORM */
function submitForm(){
  const nome=document.getElementById('f_nome').value.trim();
  const email=document.getElementById('f_email').value.trim();
  const tel=document.getElementById('f_tel').value.trim();
  const cnpj=document.getElementById('f_cnpj').value.trim();
  const razao=document.getElementById('f_razao').value.trim();
  const obs=document.getElementById('f_obs').value.trim();
  const aceite=document.getElementById('f_aceite').checked;
  const ts=document.getElementById('ts').textContent;
  if(!nome||!email||!cnpj||!razao){alert('Preencha nome, e-mail, CNPJ e razão social.');return;}
  if(!aceite){alert('Marque o checkbox de aceite para continuar.');return;}
  const btn=document.getElementById('subBtn');
  btn.disabled=true;btn.textContent='Enviando...';
  const sub=encodeURIComponent('[ACEITE] Proposta Organum — Vale do Moxuara');
  const body=encodeURIComponent(
    'ACEITE DE PROPOSTA COMERCIAL\n================================\n'+
    'Data/Hora: '+ts+'\n\n'+
    'Nome: '+nome+'\nE-mail: '+email+'\nTelefone: '+tel+'\nCNPJ: '+cnpj+'\nRazão Social: '+razao+'\nObservações: '+(obs||'—')+'\n\n'+
    'PROPOSTA ACEITA\nCliente: Vale do Moxuara\nSetup: R$5.000 (2x no cartão)\nRetainer: R$1.000/mês a partir do mês 3\nEscopo: Método Organum — 5 camadas sequenciais'
  );
  window.location.href='mailto:pedro@organum.com.br?subject='+sub+'&body='+body;
  setTimeout(()=>{
    document.getElementById('formWrap').style.display='none';
    document.getElementById('successBox').classList.add('on');
  },1000);
}

/* CONFETTI */
let confettiAF,confettiParts=[];
function startConfetti(){
  const c=document.getElementById('confettiC');
  const ctx=c.getContext('2d');
  c.width=window.innerWidth;c.height=window.innerHeight;
  confettiParts=Array.from({length:120},()=>({
    x:Math.random()*c.width,y:Math.random()*c.height-c.height,
    w:6+Math.random()*6,h:10+Math.random()*6,
    color:['#4caf64','#2e9147','#a8e6b8','#f0faf2','#fff'][Math.floor(Math.random()*5)],
    r:Math.random()*360,dr:(Math.random()-0.5)*6,
    vy:2+Math.random()*4,vx:(Math.random()-0.5)*2
  }));
  (function loop(){
    ctx.clearRect(0,0,c.width,c.height);
    confettiParts.forEach(p=>{
      ctx.save();ctx.translate(p.x+p.w/2,p.y+p.h/2);
      ctx.rotate(p.r*Math.PI/180);ctx.fillStyle=p.color;
      ctx.fillRect(-p.w/2,-p.h/2,p.w,p.h);ctx.restore();
      p.x+=p.vx;p.y+=p.vy;p.r+=p.dr;
      if(p.y>c.height){p.y=-p.h;p.x=Math.random()*c.width;}
    });
    confettiAF=requestAnimationFrame(loop);
  })();
}
function stopConfetti(){
  cancelAnimationFrame(confettiAF);
  const c=document.getElementById('confettiC');
  c.getContext('2d').clearRect(0,0,c.width,c.height);
}
</script>
</body>
</html>
