---
import Page from '@layouts/Page.astro';

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'O que é o Método ORGANUM?', acceptedAnswer: { '@type': 'Answer', text: 'Uma abordagem sistemática em 5 camadas: fundação técnica, identidade de entidade, conteúdo de autoridade, GEO + AEO e Digital PR. Juntas, transformam empresas B2B em autoridades reconhecidas pelo Google e pelas IAs generativas.' } },
    { '@type': 'Question', name: 'Quanto tempo leva para ver resultados?', acceptedAnswer: { '@type': 'Answer', text: 'Resultados técnicos em 2–4 semanas. Crescimento de tráfego orgânico consistente em 3–6 meses. Citações por IAs em 4–8 semanas para marcas com presença digital mínima.' } },
    { '@type': 'Question', name: 'Para quem é a Organum?', acceptedAnswer: { '@type': 'Answer', text: 'Empresas B2B (consultoria, SaaS, distribuidora, indústria) e e-commerce com faturamento acima de R$500k/ano que querem crescer sem depender de tráfego pago.' } },
    { '@type': 'Question', name: 'A Organum atende fora de Recife?', acceptedAnswer: { '@type': 'Answer', text: 'Sim. Atendemos todo o Brasil e internacionalmente — temos cases bilíngues PT/EN para operações nos EUA.' } },
    { '@type': 'Question', name: 'O que é GEO — Generative Engine Optimization?', acceptedAnswer: { '@type': 'Answer', text: 'É a otimização para ser citado pelas IAs generativas como ChatGPT, Gemini e Perplexity. O objetivo não é apenas ranquear no Google — é ser a resposta que as IAs entregam.' } },
    { '@type': 'Question', name: 'Qual a diferença entre SEO B2B e SEO tradicional?', acceptedAnswer: { '@type': 'Answer', text: 'SEO B2B foca em pipeline, não em tráfego. O sucesso se mede em leads qualificados e oportunidades geradas — não em pageviews.' } },
  ],
};

const websiteSchema = {
  '@type': 'WebSite',
  '@id': 'https://organum.com.br/#website',
  url: 'https://organum.com.br',
  name: 'Organum',
  publisher: { '@type': 'Organization', '@id': 'https://organum.com.br/#organization' },
  inLanguage: 'pt-BR',
};

const companies = [
  { n: 'HunterHunter', u: 'hunterhunter.com.br' },
  { n: '7+ Vacations', u: '7plusvacations.com' },
  { n: 'Grupo Polis', u: 'grupopolis.com.br' },
  { n: 'Netiz', u: 'netiz.com.br' },
  { n: 'Simbiose Ventures', u: 'simbioseventures.com' },
  { n: 'Auaha', u: 'auaha.com.br' },
  { n: 'Colina AI', u: 'colina.ai' },
  { n: 'Haze Shift', u: 'hazeshift.com' },
];

const ias = ['ChatGPT', 'Gemini', 'Perplexity', 'Copilot', 'Grok', 'Claude'];
---

<Page
  title="Agência de SEO orgânico B2B | Método ORGANUM — Recife"
  description="Transformamos empresas B2B em autoridades no Google e nas IAs com o Método ORGANUM — as 5 camadas que geram pipeline comercial sem tráfego pago."
  ogType="website"
  schemaExtra={[websiteSchema, faqSchema]}
>

<!-- ══════════ HERO ══════════ -->
<section class="hero">
  <div class="hero-grid" aria-hidden="true"></div>
  
  <div class="wrap" style="position:relative;z-index:2;padding-block:clamp(5rem,12vh,9rem) clamp(3rem,8vh,6rem);">
    <div style="max-width:min(90%,1280px);margin-inline:auto;display:grid;grid-template-columns:1fr;gap:clamp(3rem,6vw,5rem);align-items:center;">
      
      <div>
        <p class="hero-eye anim-fade-up d1">Método ORGANUM — 5 camadas comprovadas</p>
        <h1 class="hero-title anim-fade-up d2">
          SEO orgânico que gera pipeline B2B — <em>não apenas cliques</em>
        </h1>
        <p class="hero-sub anim-fade-up d3">Do zero técnico à citação por IA. Sem anúncios. Sem dependência de algoritmo de mídia social.</p>
        <div class="hero-actions anim-fade-up d4">
          <a href="#typeform-section" class="btn btn-green">Solicitar auditoria gratuita</a>
          <a href="/metodo" class="btn btn-outline">Ver o método →</a>
        </div>
      </div>

      <div class="anim-fade-in d5" style="display:grid;place-items:center;">
        <svg viewBox="0 0 480 320" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:100%;max-width:520px;" aria-label="Gráfico: pipeline orgânico cresce 127% enquanto tráfego pago cessa ao longo de 12 meses">
          <line x1="48" y1="30" x2="460" y2="30" stroke="rgba(255,255,255,.05)" stroke-width="1"/>
          <line x1="48" y1="85" x2="460" y2="85" stroke="rgba(255,255,255,.05)" stroke-width="1"/>
          <line x1="48" y1="140" x2="460" y2="140" stroke="rgba(255,255,255,.05)" stroke-width="1"/>
          <line x1="48" y1="195" x2="460" y2="195" stroke="rgba(255,255,255,.05)" stroke-width="1"/>
          <line x1="48" y1="250" x2="460" y2="250" stroke="rgba(255,255,255,.08)" stroke-width="1"/>
          <line x1="48" y1="30" x2="48" y2="250" stroke="rgba(255,255,255,.08)" stroke-width="1"/>
          <text x="48" y="268" fill="rgba(255,255,255,.25)" font-size="9" text-anchor="middle" font-family="DM Sans,sans-serif">Mês 0</text>
          <text x="152" y="268" fill="rgba(255,255,255,.25)" font-size="9" text-anchor="middle" font-family="DM Sans,sans-serif">Mês 3</text>
          <text x="256" y="268" fill="rgba(255,255,255,.25)" font-size="9" text-anchor="middle" font-family="DM Sans,sans-serif">Mês 6</text>
          <text x="360" y="268" fill="rgba(255,255,255,.25)" font-size="9" text-anchor="middle" font-family="DM Sans,sans-serif">Mês 9</text>
          <text x="460" y="268" fill="rgba(255,255,255,.25)" font-size="9" text-anchor="middle" font-family="DM Sans,sans-serif">Mês 12</text>
          <polyline points="48,250 152,242 256,220 360,180 460,123" stroke="var(--g400)" stroke-width="2.5" fill="none" stroke-dasharray="1000" stroke-dashoffset="1000" style="animation:drawLine 2.5s ease forwards;animation-delay:.8s;"/>
          <circle cx="460" cy="123" r="4" fill="var(--g400)" opacity="0" style="animation:popIn .4s ease forwards;animation-delay:3.3s;"/>
          <polyline points="48,195 152,190 256,185 360,250 460,250" stroke="rgba(255,100,100,.6)" stroke-width="2" fill="none" stroke-dasharray="2,4"/>
          <text x="470" y="128" fill="var(--g400)" font-size="11" font-weight="600" font-family="DM Sans,sans-serif" opacity="0" style="animation:fadeIn .4s ease forwards;animation-delay:3.4s;">+127%</text>
          <text x="470" y="254" fill="rgba(255,100,100,.6)" font-size="10" font-family="DM Sans,sans-serif">Paid ads</text>
          <text x="76" y="128" fill="var(--g400)" font-size="10" font-family="DM Sans,sans-serif">Orgânico</text>
        </svg>
      </div>

    </div>
  </div>

  <!-- Ticker carrossel "Confiam no método" -->
  <div style="background:rgba(255,255,255,.02);border-top:1px solid rgba(255,255,255,.06);overflow:hidden;position:relative;padding-block:.875rem;">
    <p style="font-size:.65rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:rgba(255,255,255,.35);text-align:center;margin-bottom:.625rem;">Confiam no método</p>
    <div class="ticker-track">
      {[...companies, ...companies].map(c => (
        <div class="ticker-item">
          <span class="ticker-name">{c.n}</span>
          <span class="ticker-url">{c.u}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══════════ STATEMENT ══════════ -->
<section style="background:var(--n950);color:#fff;padding-block:clamp(3rem,8vw,6rem);">
  <div class="wrap">
    <div style="display:grid;grid-template-columns:auto 1fr;gap:2rem;align-items:center;max-width:min(90%,820px);margin-inline:auto;">
      <div style="width:1px;height:clamp(60px,8vw,96px);background:linear-gradient(to bottom,transparent,var(--g500),transparent);"></div>
      <div>
        <p style="font-size:.7rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.4);margin-bottom:.75rem;">Por que a Organum</p>
        <h2 style="font-family:var(--serif);font-size:clamp(1.5rem,3.5vw,2.25rem);font-weight:700;line-height:1.2;letter-spacing:-.02em;color:#fff;">
          Nenhuma agência brasileira entrega <em style="font-style:italic;color:var(--g400);">GEO sistematicamente.</em> Nós entregamos com dados.
        </h2>
      </div>
    </div>
  </div>
</section>

<!-- ══════════ TICKER "CITADA PELAS IAs" ══════════ -->
<section style="background:var(--n950);border-top:1px solid rgba(255,255,255,.05);padding-block:1.25rem;overflow:hidden;">
  <p style="font-size:.65rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:rgba(255,255,255,.3);text-align:center;margin-bottom:.875rem;">Citada pelas IAs</p>
  <div class="ticker-track-slow">
    {[...ias, ...ias, ...ias].map(ia => (
      <div style="display:inline-flex;align-items:center;gap:.625rem;padding:.5rem 1.25rem;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.08);border-radius:2rem;white-space:nowrap;margin-right:.75rem;">
        <div style="width:6px;height:6px;background:var(--g400);border-radius:50%;"></div>
        <span style="font-size:.8125rem;color:rgba(255,255,255,.7);font-weight:500;">{ia}</span>
      </div>
    ))}
  </div>
</section>

<!-- ══════════ SEÇÃO 3 — O PROBLEMA ══════════ -->
<section style="background:var(--n50);padding-block:clamp(4rem,10vw,8rem);">
  <div class="wrap">
    <p class="sec-eye reveal">O problema que você tem</p>
    <h2 class="reveal reveal-d1" style="font-family:var(--serif);font-size:clamp(1.75rem,4vw,3rem);font-weight:700;line-height:1.1;letter-spacing:-.025em;color:var(--n950);max-width:24ch;margin-bottom:3rem;">
      Você investe em anúncios e para de crescer quando para de pagar.
    </h2>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:clamp(1.5rem,3vw,2rem);">
      {[
        { t: 'Tráfego pago não escala sem orçamento', p: 'Cada real novo exige mais investimento. O custo por lead sobe. A margem comprime. Você está num ciclo que nunca para.', s: '+340% no CAC em 3 anos', c: 'var(--g600)' },
        { t: 'Seu site não existe para as IAs generativas', p: 'ChatGPT, Gemini e Perplexity respondem às perguntas do seu ICP todos os dias. Se sua empresa não é citada, seus concorrentes são.', s: '73% das pesquisas B2B usam IA', c: 'var(--g600)' },
        { t: 'SEO genérico não funciona para B2B', p: 'Agências entregam posts e backlinks. O Google pode até ranquear. Mas nenhum lead qualificado chega. SEO B2B é sobre pipeline, não tráfego.', s: '89% dos leads B2B pesquisam antes', c: 'var(--g600)' },
        { t: 'Sua empresa não é uma entidade reconhecida', p: 'Google, IAs e compradores verificam a existência da sua empresa antes de confiar. Sem Knowledge Graph, sem Wikidata — você é invisível para as IAs.', s: 'Entidade = credibilidade automática', c: 'var(--g600)' },
      ].map((prob, i) => (
        <div class="prob-card reveal" style={`transition-delay:${i * 0.1}s`}>
          <div style="display:flex;align-items:center;gap:.75rem;margin-bottom:1rem;">
            <div style={`width:clamp(32px,5vw,40px);height:clamp(32px,5vw,40px);background:${prob.c};border-radius:50%;display:grid;place-items:center;flex-shrink:0;`}>
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"><path d="M10 6v8M6 10h8"/></svg>
            </div>
            <h3 style="font-size:clamp(.95rem,2vw,1.125rem);font-weight:700;color:var(--n900);line-height:1.3;">{prob.t}</h3>
          </div>
          <p style="font-size:.9375rem;color:var(--n700);line-height:1.65;margin-bottom:1.25rem;">{prob.p}</p>
          <div style="display:inline-block;padding:.375rem .875rem;background:rgba(29,122,53,.08);border:1px solid rgba(29,122,53,.2);border-radius:.25rem;">
            <p style="font-size:.75rem;font-weight:700;color:var(--g600);letter-spacing:.02em;">{prob.s}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══════════ SEÇÃO 4 — IDENTIDADE DE ENTIDADE ══════════ -->
<section class="entidade-section">
  <div class="wrap">
    <p class="sec-eye reveal" style="color:rgba(255,255,255,.35);">O conceito que separa os líderes</p>
    <h2 class="reveal reveal-d1" style="font-family:var(--serif);font-size:clamp(1.75rem,4vw,3.25rem);font-weight:700;line-height:1.05;letter-spacing:-.025em;color:#fff;max-width:24ch;">
      Identidade de entidade: o que as IAs precisam para te recomendar
    </h2>
    <p class="reveal reveal-d2" style="font-size:clamp(1rem,2vw,1.125rem);color:rgba(255,255,255,.6);line-height:1.7;max-width:65ch;margin-top:1.5rem;">
      Uma entidade digital é a representação verificável da sua empresa no grafo de conhecimento da internet. Google e IAs a usam para decidir quem é confiável — e quem ignorar.
    </p>

    <!-- Diagrama comparativo -->
    <div class="reveal reveal-d3" style="margin-top:3rem;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:2rem;">
      
      <!-- Sem entidade -->
      <div style="background:rgba(255,100,100,.03);border:1px solid rgba(255,100,100,.15);padding:clamp(1.5rem,4vw,2.5rem);border-radius:.5rem;">
        <div style="display:flex;align-items:center;gap:.75rem;margin-bottom:1.5rem;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="rgba(255,100,100,.7)" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
          <h3 style="font-size:1.125rem;font-weight:700;color:rgba(255,100,100,.9);">Empresa sem entidade</h3>
        </div>
        <p style="font-size:.875rem;color:rgba(255,255,255,.5);margin-bottom:1.25rem;line-height:1.6;">Como as IAs veem sua empresa hoje</p>
        <ul style="list-style:none;padding:0;display:flex;flex-direction:column;gap:.875rem;">
          {['Não aparece no Knowledge Graph — não existe como entidade verificada', 'Sem perfil no Wikidata — IAs não conseguem confirmar sua existência', 'LinkedIn sem Schema markup — sinais de autoridade desperdiçados', 'Sem menções cruzadas — desconhecida para o grafo de conhecimento', 'Resultado: ChatGPT ignora sua marca mesmo com bom conteúdo'].map(item => (
            <li style="display:flex;align-items:start;gap:.625rem;">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="rgba(255,100,100,.6)" stroke-width="2" style="flex-shrink:0;margin-top:.25rem;"><line x1="4" y1="8" x2="12" y2="8"/></svg>
              <span style="font-size:.875rem;color:rgba(255,255,255,.7);line-height:1.5;">{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Com entidade -->
      <div style="background:rgba(76,175,100,.04);border:1px solid rgba(76,175,100,.25);padding:clamp(1.5rem,4vw,2.5rem);border-radius:.5rem;">
        <div style="display:flex;align-items:center;gap:.75rem;margin-bottom:1.5rem;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--g400)" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="9 12 11 14 15 10"/></svg>
          <h3 style="font-size:1.125rem;font-weight:700;color:var(--g400);">Empresa com entidade — Organum</h3>
        </div>
        <p style="font-size:.875rem;color:rgba(255,255,255,.5);margin-bottom:1.25rem;line-height:1.6;">Como as IAs veem após o Método ORGANUM</p>
        <ul style="list-style:none;padding:0;display:flex;flex-direction:column;gap:.875rem;">
          {['Knowledge Graph ativo — Google confirma sua empresa como entidade real', 'Wikidata estruturado — IAs verificam e reconhecem sua marca automaticamente', 'Schema Organization + Person — autoridade do fundador ligada à empresa', 'sameAs cruzados — LinkedIn, site, Wikidata e portais confirmam a mesma entidade', 'Resultado: HunterHunter citada pelo ChatGPT em 90 dias'].map(item => (
            <li style="display:flex;align-items:start;gap:.625rem;">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="var(--g400)" stroke-width="2" style="flex-shrink:0;margin-top:.25rem;"><polyline points="3 8 6 11 13 4"/></svg>
              <span style="font-size:.875rem;color:rgba(255,255,255,.8);line-height:1.5;">{item}</span>
            </li>
          ))}
        </ul>
      </div>

    </div>
  </div>
</section>

<!-- ══════════ ELEMENTO: COMO A ORGANUM CONSTRÓI ══════════ -->
<section style="background:var(--n950);border-top:1px solid rgba(255,255,255,.05);padding-block:clamp(4rem,10vw,7rem);">
  <div class="wrap">
    <h2 class="reveal" style="font-family:var(--serif);font-size:clamp(1.5rem,3.5vw,2.5rem);font-weight:700;line-height:1.15;letter-spacing:-.025em;color:#fff;text-align:center;margin-bottom:3rem;">
      Como a Organum constrói sua identidade de entidade
    </h2>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:1.5rem;margin-bottom:3rem;">
      {[
        { i: '🔷', t: 'Knowledge Graph', p: 'Google confirma sua empresa como entidade real e confiável' },
        { i: '📖', t: 'Wikidata', p: 'Base de dados verificável que as IAs consultam para confirmar existência' },
        { i: '💼', t: 'LinkedIn + Schema', p: 'Perfil estruturado com markup que conecta empresa e fundador' },
        { i: '🔗', t: 'Menções cruzadas', p: 'Portais de nicho, assessoria digital e co-citações editoriais' },
      ].map((blk, i) => (
        <div class="reveal" style={`background:rgba(255,255,255,.02);border:1px solid rgba(255,255,255,.08);padding:1.5rem;transition-delay:${i * 0.1}s`}>
          <div style="font-size:2rem;margin-bottom:.75rem;">{blk.i}</div>
          <h3 style="font-size:1.05rem;font-weight:700;color:#fff;margin-bottom:.5rem;">{blk.t}</h3>
          <p style="font-size:.875rem;color:rgba(255,255,255,.6);line-height:1.6;">{blk.p}</p>
        </div>
      ))}
    </div>

    <div class="reveal reveal-d4" style="max-width:820px;margin-inline:auto;background:rgba(29,122,53,.15);border:1.5px solid rgba(76,175,100,.4);padding:2rem;text-align:center;">
      <p style="font-size:.7rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.5);margin-bottom:.625rem;">Resultado</p>
      <p style="font-family:var(--serif);font-size:clamp(1.25rem,3vw,1.75rem);font-weight:700;color:#fff;margin-bottom:1rem;">Sua empresa — Entidade verificada</p>
      <p style="font-size:.9375rem;color:rgba(255,255,255,.7);line-height:1.6;margin-bottom:1.5rem;">Reconhecida pelo Google, pelas IAs e pelos seus compradores</p>
      <div style="display:inline-block;padding:.5rem 1rem;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:.25rem;">
        <p style="font-size:.8125rem;color:rgba(255,255,255,.8);"><strong style="color:var(--g400);">↓ alimenta</strong> → Citada pelas IAs</p>
      </div>
    </div>

    <div class="reveal reveal-d5" style="max-width:820px;margin-inline:auto;margin-top:2rem;background:rgba(255,255,255,.02);border:1px solid rgba(255,255,255,.08);padding:1.5rem;display:flex;align-items:center;gap:1.5rem;overflow:hidden;">
      <div class="ticker-track-ias">
        {[...ias, ...ias, ...ias].map(ia => (
          <span style="display:inline-block;padding:.375rem .875rem;background:rgba(76,175,100,.08);border:1px solid rgba(76,175,100,.2);border-radius:.25rem;font-size:.8125rem;font-weight:600;color:var(--g400);white-space:nowrap;margin-right:.625rem;">{ia}</span>
        ))}
      </div>
    </div>

    <p class="reveal reveal-d6" style="text-align:center;margin-top:1.5rem;font-size:.875rem;color:rgba(255,255,255,.5);">
      <a href="/cases/hunterhunter" style="color:var(--g400);text-decoration:underline;font-weight:600;">HunterHunter em 90 dias →</a>
    </p>
  </div>
</section>

<!-- ══════════ SEÇÃO 5 — 5 CAMADAS ══════════ -->
<section class="layers-section">
  <div class="wrap">
    <p class="sec-eye reveal" style="color:rgba(255,255,255,.35);">O método</p>
    <h2 class="reveal reveal-d1" style="font-family:var(--serif);font-size:clamp(1.75rem,4vw,3.25rem);font-weight:700;line-height:1.05;letter-spacing:-.025em;color:#fff;max-width:20ch;">
      5 camadas. A ordem importa.
    </h2>
    <p class="reveal reveal-d2" style="font-size:clamp(1rem,2vw,1.125rem);color:rgba(255,255,255,.6);line-height:1.7;max-width:65ch;margin-top:1.5rem;">
      A única abordagem sistemática de SEO B2B que vai do zero técnico à citação por IA. Cada camada é pré-requisito da próxima. Pular uma quebra o sistema inteiro.
    </p>

    <div style="margin-top:4rem;display:flex;flex-direction:column;gap:2rem;">
      {[
        { n: '01', t: 'Fundação técnica', s: 'Core Web Vitals, silos, Schema Markup', tag: 'Base obrigatória', txt: 'Core Web Vitals perfeitos, arquitetura de silos semânticos, crawl budget otimizado e Schema Markup completo em JSON-LD. Sem fundação técnica, as outras 4 camadas não funcionam. É o pré-requisito que a maioria das agências ignora.', link: '/metodo/fundacao', anim: 'LCP CLS INP FCP' },
