Object.entries(layerAnims).forEach(([id, svg]) => {
  const el = document.getElementById(id);
  if (el) el.innerHTML = svg;
});

// ── Acordeão de camadas ──
document.querySelectorAll<HTMLElement>('.layer-header').forEach(header => {
  header.addEventListener('click', () => {
    const animId = header.dataset.layer || '';
    const bodyId = `body-${animId}`;
    const body = document.getElementById(bodyId);
    const isOpen = body?.classList.contains('open');
    document.querySelectorAll('.layer-body').forEach(b => b.classList.remove('open'));
    document.querySelectorAll('.layer-header').forEach(h => h.classList.remove('active'));
    if (!isOpen && body) {
      body.classList.add('open');
      header.classList.add('active');
      // Reiniciar animação SVG ao abrir
      const wrap = document.getElementById(animId);
      if (wrap) {
        const html = wrap.innerHTML;
        wrap.innerHTML = '';
        setTimeout(() => { wrap.innerHTML = html; }, 50);
      }
    }
  });
});

