document.querySelectorAll<HTMLElement>('.dor-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const idx = parseInt(btn.dataset.index || '0');
    document.querySelectorAll('.dor-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const box = document.getElementById('dor-answer-box');
    const qEl = document.getElementById('dor-q');
    const aEl = document.getElementById('dor-a');
    if (box) { box.classList.add('fade'); }
    setTimeout(() => {
      if (qEl) qEl.textContent = dorData[idx].q;
      if (aEl) aEl.innerHTML = dorData[idx].a;
      if (box) { box.classList.remove('fade'); }
    }, 200);
  });
});

// ── Typeform ──
const TOTAL_STEPS = 7;
const answers: Record<number, string> = {};

function getProgress(step: number) { return Math.round((step / TOTAL_STEPS) * 100); }

function goTo(step: number) {
  document.querySelectorAll('.tf-step').forEach(s => s.classList.remove('active'));
  const next = document.getElementById(`tf-${step}`);
  if (next) next.classList.add('active');
  const bar = document.getElementById('tf-bar');
  if (bar) bar.style.width = getProgress(step - 1) + '%';
}

function showSuccess() {
  document.querySelectorAll('.tf-step').forEach(s => s.classList.remove('active'));
  const bar = document.getElementById('tf-bar');
  if (bar) bar.style.width = '100%';
  const success = document.getElementById('tf-success');
  if (success) success.classList.add('show');

  // Montar dados para GoHighLevel
  const formData = {
    desafio: answers[1] || '',
    perfil: answers[2] || '',
    faturamento: answers[3] || '',
    seo_anterior: answers[4] || '',
    site: (document.getElementById('tf-site') as HTMLInputElement)?.value || '',
    nome: (document.getElementById('tf-name') as HTMLInputElement)?.value || '',
    email: (document.getElementById('tf-email') as HTMLInputElement)?.value || '',
  };
  console.log('Lead capturado:', formData);
  // TODO: enviar para GoHighLevel via fetch quando Pedro configurar o endpoint
}

// Cliques nas opções
document.querySelectorAll<HTMLElement>('.tf-opt').forEach(opt => {
  opt.addEventListener('click', () => {
    const step = parseInt(opt.dataset.step || '0');
    document.querySelectorAll<HTMLElement>(`.tf-opt[data-step="${step}"]`).forEach(o => o.classList.remove('selected'));
    opt.classList.add('selected');
    answers[step] = opt.textContent || '';
    const nextBtn = document.getElementById(`tf-next-${step}`) as HTMLButtonElement | null;
    if (nextBtn) nextBtn.disabled = false;
  });
});

// Botões próximo
for (let i = 1; i <= 5; i++) {
  const btn = document.getElementById(`tf-next-${i}`) as HTMLButtonElement | null;
  btn?.addEventListener('click', () => { if (!btn.disabled) goTo(i + 1); });
}
document.getElementById('tf-next-6')?.addEventListener('click', () => goTo(7));
document.getElementById('tf-next-7')?.addEventListener('click', () => {
  const email = (document.getElementById('tf-email') as HTMLInputElement)?.value;
  if (email && email.includes('@')) showSuccess();
  else { const el = document.getElementById('tf-email') as HTMLInputElement; if (el) el.style.borderColor = 'rgba(220,80,60,.6)'; }
});

// Botões voltar
document.querySelectorAll<HTMLElement>('.tf-back').forEach(btn => {
  btn.addEventListener('click', () => {
    const goto = parseInt(btn.dataset.goto || '1');
    goTo(goto);
  });
});

// Habilitar próximo nos inputs de texto
['tf-site','tf-name'].forEach((id, i) => {
  const step = i + 5;
  const input = document.getElementById(id) as HTMLInputElement | null;
  const nextBtn = document.getElementById(`tf-next-${step}`) as HTMLButtonElement | null;
  if (input && nextBtn) {
    input.addEventListener('input', () => { nextBtn.disabled = input.value.length < 3; });
    nextBtn.disabled = false; // opcional: liberar sem obrigatoriedade
  }
});
