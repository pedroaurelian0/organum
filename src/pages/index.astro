<!-- ═══════════════════════════════════════════
     CTA FINAL
═══════════════════════════════════════════ -->
<section class="cta-strip">
  <div class="wrap-sm" style="text-align:center;" class="reveal">
    <p style="font-size:.7rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:rgba(255,255,255,.4);margin-bottom:1.5rem;">Próximo passo</p>
    <h2 style="font-family:var(--font-serif);font-size:clamp(2rem,5vw,3.5rem);font-weight:700;color:white;line-height:1.05;letter-spacing:-.02em;">
      Pronto para parar de depender<br/>de tráfego pago?
    </h2>
    <p style="margin-top:1.25rem;font-size:1rem;color:rgba(255,255,255,.5);max-width:40ch;margin-inline:auto;">
