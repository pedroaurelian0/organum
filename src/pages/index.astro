---
import Page from '@layouts/Page.astro';

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'O que é o Método ORGANUM?', acceptedAnswer: { '@type': 'Answer', text: 'Uma abordagem sistemática em 5 camadas: fundação técnica, identidade de entidade, conteúdo de autoridade, GEO + AEO e Digital PR. Juntas, transformam empresas B2B em autoridades reconhecidas pelo Google e pelas IAs generativas.' } },
    { '@type': 'Question', name: 'Quanto tempo leva para ver resultados?', acceptedAnswer: { '@type': 'Answer', text: 'Resultados técnicos em 2–4 semanas. Crescimento de tráfego orgânico consistente em 3–6 meses. Citações por IAs em 4–8 semanas para marcas com presença digital mínima.' } },
    { '@type': 'Question', name: 'Para quem é a Organum?', acceptedAnswer: { '@type': 'Answer', text: 'Empresas B2B (consultoria, SaaS, distribuidora, indústria) e e-commerce com faturamento acima de R$500k/ano que querem crescer sem depender de tráfego pago.' } },
    { '@type': 'Question', name: 'A Organum atende fora de Recife?', acceptedAnswer: { '@type': 'Answer', text: 'Sim. Atendemos todo o Brasil e internacionalmente — temos cases bilíngues PT/EN para operações nos EUA.' } },
    { '@type': 'Question', name: 'O que é GEO — Generative Engine Optimization?', acceptedAnswer: { '@type': 'Answer', text: 'É a otimização para ser citado pelas IAs generativas como ChatGPT, Gemini e Perplexity. O objetivo não é apenas ranquear no Google — é ser a resposta que as IAs entregam.' } },
    { '@type': 'Question', name: 'Qual a diferença entre SEO B2B e SEO tradicional?', acceptedAnswer: { '@type': 'Answer', text: 'SEO B2B foca em pipeline, não em tráfego. O sucesso se mede em leads qualificados e oportunidades geradas — não em pageviews.' } },
  ],
};

const websiteSchema = {
  '@type': 'WebSite',
  '@id': 'https://organum.com.br/#website',
  url: 'https://organum.com.br',
  name: 'Organum',
  publisher: { '@type': 'Organization', '@id': 'https://organum.com.br/#organization' },
  inLanguage: 'pt-BR',
};
---

<Page
  title="Agência de SEO orgânico B2B | Método ORGANUM — Recife | Organum"
  description="Transformamos empresas B2B em autoridades no Google e nas IAs generativas com o Método ORGANUM — 5 camadas que geram pipeline comercial sem tráfego pago."
  canonical="https://organum.com.br/"
  ogType="website"
  schemaExtra={[websiteSchema, faqSchema]}
>

<!-- ═══════════════════════════════════════════════
     PRÉ-LOADER
     ═══════════════════════════════════════════════ -->
<div id="preloader" aria-hidden="true">
  <span id="preloader-logo">Organum</span>
</div>

<!-- ═══════════════════════════════════════════════
     SEÇÃO 1 — HERO
     ═══════════════════════════════════════════════ -->
<section class="hero-cine" id="hero">
  <div class="hero-grid-bg" aria-hidden="true"></div>
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="wrap hero-inner">
    <!-- Coluna de copy -->
    <div class="hero-copy">
      <p class="hero-eye" id="h-eye">MÉTODO ORGANUM — 5 CAMADAS COMPROVADAS</p>
      <h1 class="hero-title">
        <span class="h1-line" id="h1-l1">SEO orgânico</span>
        <span class="h1-line" id="h1-l2">que gera</span>
        <span class="h1-line" id="h1-l3">pipeline B2B</span>
        <em class="h1-em" id="h1-em">não apenas cliques</em>
      </h1>
      <p class="hero-sub" id="h-sub">
        Do zero técnico à citação por IA.<br>
        Sem anúncios. Sem dependência de algoritmo.
      </p>
      <div class="hero-actions" id="h-ctas">
        <a href="/auditoria-gratuita" class="btn-primary" id="cta-auditoria">
          Solicitar auditoria gratuita &rarr;
        </a>
        <a href="/metodo" class="btn-ghost-cine" id="cta-metodo">Ver o método</a>
      </div>
    </div>

    <!-- Coluna do gráfico SVG -->
    <div class="hero-chart-wrap" id="hero-chart-wrap">
      <svg id="hero-chart" viewBox="0 0 480 320" fill="none" xmlns="http://www.w3.org/2000/svg"
           aria-label="Gráfico: pipeline orgânico cresce 127% enquanto tráfego pago cessa ao longo de 12 meses">
        <!-- Grid lines -->
        <line x1="48" y1="30"  x2="460" y2="30"  stroke="rgba(255,255,255,.05)" stroke-width="1"/>
        <line x1="48" y1="85"  x2="460" y2="85"  stroke="rgba(255,255,255,.05)" stroke-width="1"/>
        <line x1="48" y1="140" x2="460" y2="140" stroke="rgba(255,255,255,.05)" stroke-width="1"/>
        <line x1="48" y1="195" x2="460" y2="195" stroke="rgba(255,255,255,.05)" stroke-width="1"/>
        <line x1="48" y1="250" x2="460" y2="250" stroke="rgba(255,255,255,.08)" stroke-width="1"/>
        <line x1="48" y1="30"  x2="48"  y2="250" stroke="rgba(255,255,255,.08)" stroke-width="1"/>
        <!-- X axis labels -->
        <text x="48"  y="268" fill="rgba(255,255,255,.25)" font-size="9" text-anchor="middle" font-family="DM Sans,sans-serif">Mês 0</text>
        <text x="152" y="268" fill="rgba(255,255,255,.25)" font-size="9" text-anchor="middle" font-family="DM Sans,sans-serif">Mês 3</text>
        <text x="256" y="268" fill="rgba(255,255,255,.25)" font-size="9" text-anchor="middle" font-family="DM Sans,sans-serif">Mês 6</text>
        <text x="360" y="268" fill="rgba(255,255,255,.25)" font-size="9" text-anchor="middle" font-family="DM Sans,sans-serif">Mês 9</text>
        <text x="460" y="268" fill="rgba(255,255,255,.25)" font-size="9" text-anchor="middle" font-family="DM Sans,sans-serif">Mês 12</text>
        <!-- Y axis labels -->
        <text x="40" y="254" fill="rgba(255,255,255,.2)" font-size="8" text-anchor="end" font-family="DM Sans,sans-serif">0</text>
        <text x="40" y="144" fill="rgba(255,255,255,.2)" font-size="8" text-anchor="end" font-family="DM Sans,sans-serif">50</text>
        <text x="40" y="34"  fill="rgba(255,255,255,.2)" font-size="8" text-anchor="end" font-family="DM Sans,sans-serif">100</text>
        <text x="48" y="18"  fill="rgba(255,255,255,.25)" font-size="8" font-weight="600" letter-spacing="1" font-family="DM Sans,sans-serif">PIPELINE ORGÂNICO vs. TRÁFEGO PAGO — 12 MESES</text>
        <!-- Paid area + line -->
        <path id="chart-paid-area" d="M48,246 C90,232 115,185 152,158 C175,140 185,155 205,185 C228,218 252,240 290,248 L460,250 Z" fill="rgba(220,80,60,.07)" opacity="0"/>
        <path id="chart-paid-line" d="M48,246 C90,232 115,185 152,158 C175,140 185,155 205,185 C228,218 252,240 290,248 L460,250" fill="none" stroke="rgba(200,90,70,.5)" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="800" stroke-dashoffset="800"/>
        <!-- Organic area + line -->
        <path id="chart-org-area" d="M48,249 C90,247 135,240 185,226 C230,213 278,190 322,160 C368,128 415,90 460,52 L460,250 Z" fill="rgba(46,145,71,.12)" opacity="0"/>
        <path id="chart-org-line" d="M48,249 C90,247 135,240 185,226 C230,213 278,190 322,160 C368,128 415,90 460,52" fill="none" stroke="#4caf64" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="900" stroke-dashoffset="900"/>
        <!-- Endpoint markers -->
        <circle id="chart-dot"  cx="460" cy="52" r="5"  fill="#4caf64" opacity="0"/>
        <circle id="chart-ring" cx="460" cy="52" r="10" fill="none" stroke="rgba(76,175,100,.35)" stroke-width="1.5" opacity="0"/>
        <!-- Labels -->
        <g id="chart-label-org" opacity="0">
          <rect x="340" y="34" width="116" height="20" rx="2" fill="rgba(76,175,100,.12)" stroke="rgba(76,175,100,.35)" stroke-width="1"/>
          <text x="348" y="48" fill="#4caf64" font-size="9" font-weight="600" font-family="DM Sans,sans-serif">SEO orgânico ↑ 127%</text>
        </g>
        <g id="chart-label-paid" opacity="0">
          <rect x="120" y="141" width="108" height="20" rx="2" fill="rgba(220,80,60,.1)" stroke="rgba(200,80,60,.25)" stroke-width="1"/>
          <text x="128" y="155" fill="rgba(210,120,100,1)" font-size="9" font-weight="600" font-family="DM Sans,sans-serif">Tráfego pago — cessa</text>
        </g>
      </svg>
    </div>
  </div>

  <!-- Separador animado -->
  <div class="hero-divider" id="hero-divider" aria-hidden="true"></div>

  <!-- Ticker strip -->
  <div class="hero-ticker" aria-label="Clientes que confiam no método">
    <div class="ticker-inner">
      <span class="ticker-lbl">Confiam no método</span>
      <div class="ticker-sep" aria-hidden="true"></div>
      <div class="ticker-track-wrap">
        <div class="ticker-track">
          {['HunterHunter','7+ Vacations','Global Electronics','Sax Trading','Prime Vacations',
            'HunterHunter','7+ Vacations','Global Electronics','Sax Trading','Prime Vacations'].map(n => (
            <span class="ticker-item">{n}</span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     SEÇÃO 2 — STATEMENT
     ═══════════════════════════════════════════════ -->
<section class="statement-section cinema-reveal" id="statement">
  <div class="wrap statement-grid">
    <div class="statement-accent" aria-hidden="true"></div>
    <div class="statement-body">
      <p class="section-eyebrow">POR QUE A ORGANUM</p>
      <h2 class="statement-headline clip-reveal" id="statement-h2">
        Nenhuma agência brasileira entrega<br>
        GEO sistematicamente.<br>
        <span class="text-green-cine">Nós entregamos — e provamos com dados.</span>
      </h2>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     SEÇÃO 3 — MÉTRICAS
     ═══════════════════════════════════════════════ -->
<section class="metrics-section" id="metrics">
  <div class="wrap metrics-grid">
    {[
      { num: 5,   suffix: '',  label: 'Camadas do método' },
      { num: 90,  suffix: 'd', label: 'Para citação por IA' },
      { num: 340, suffix: '%', label: 'Crescimento orgânico' },
      { num: 48,  suffix: 'h', label: 'Para o diagnóstico' },
    ].map((m, i) => (
      <div class="metric-item" data-target={m.num} data-suffix={m.suffix} data-delay={i * 0.15}>
        <span class="metric-num" data-val={m.num} data-sfx={m.suffix}>0{m.suffix}</span>
        <span class="metric-label">{m.label}</span>
      </div>
    ))}
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     SEÇÃO 4 — PROBLEMA
     ═══════════════════════════════════════════════ -->
<section class="prob-section" id="problema">
  <div class="wrap">
    <div class="section-header cinema-reveal">
      <p class="section-eyebrow dark">O PROBLEMA QUE VOCÊ TEM</p>
      <h2 class="section-h2">Você investe em anúncios e para de crescer<br>quando para de pagar.</h2>
    </div>

    <div class="prob-grid" id="prob-cards">
      {[
        { title: 'Tráfego pago não escala sem orçamento', stat: '+340% no CAC em 3 anos', icon: '📈' },
        { title: 'Seu site não existe para as IAs generativas', stat: '73% das pesquisas B2B usam IA', icon: '🤖' },
        { title: 'SEO genérico não funciona para B2B', stat: '89% dos leads B2B pesquisam antes', icon: '🔍' },
        { title: 'Sua empresa não é uma entidade reconhecida', stat: 'Entidade = credibilidade automática', icon: '🏛️' },
        { title: 'Concorrentes aparecem primeiro nas buscas estratégicas', stat: '78% das decisões B2B começam no Google', icon: '⚡' },
        { title: 'Seu pipeline depende de indicações e rede', stat: 'CAC orgânico cai 70% em 12 meses', icon: '🌱' },
      ].map((card) => (
        <div class="prob-card cinema-stagger">
          <span class="prob-icon" aria-hidden="true">{card.icon}</span>
          <h3 class="prob-title">{card.title}</h3>
          <p class="prob-stat">{card.stat}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     SEÇÃO 5 — IDENTIDADE DE ENTIDADE (PIN)
     ═══════════════════════════════════════════════ -->
<section class="entidade-section" id="entidade">
  <div class="wrap">
    <div class="section-header cinema-reveal">
      <p class="section-eyebrow">IDENTIDADE DE ENTIDADE</p>
      <h2 class="section-h2 white">O que as IAs precisam para te recomendar</h2>
    </div>

    <div class="entidade-grid">
      <!-- Sem entidade -->
      <div class="entidade-card entidade-card-no" id="entidade-no">
        <div class="entidade-card-header">
          <span class="entidade-icon-x" aria-hidden="true">✕</span>
          <span class="entidade-card-label red">Empresa sem entidade</span>
        </div>
        <ul class="entidade-list">
          <li><span class="ent-x" aria-hidden="true">✕</span> Sem página na Wikipedia</li>
          <li><span class="ent-x" aria-hidden="true">✕</span> Sem item no Wikidata</li>
          <li><span class="ent-x" aria-hidden="true">✕</span> Sem Knowledge Panel no Google</li>
          <li><span class="ent-x" aria-hidden="true">✕</span> Sem sameAs cruzados</li>
          <li><span class="ent-x" aria-hidden="true">✕</span> Invisível para ChatGPT e Gemini</li>
          <li><span class="ent-x" aria-hidden="true">✕</span> Dependente de anúncios para existir</li>
        </ul>
      </div>

      <!-- Com entidade (Organum) -->
      <div class="entidade-card entidade-card-yes" id="entidade-yes">
        <div class="entidade-card-header">
          <span class="entidade-icon-check" aria-hidden="true">✓</span>
          <span class="entidade-card-label green">Com Organum — entidade estruturada</span>
        </div>
        <ul class="entidade-list">
          <li><span class="ent-check" aria-hidden="true">✓</span> Presença verificável no Wikidata</li>
          <li><span class="ent-check" aria-hidden="true">✓</span> Knowledge Graph ativo</li>
          <li><span class="ent-check" aria-hidden="true">✓</span> sameAs cruzados LinkedIn, G.Business</li>
          <li><span class="ent-check" aria-hidden="true">✓</span> Menções editoriais qualificadas</li>
          <li><span class="ent-check" aria-hidden="true">✓</span> Citada por ChatGPT, Gemini, Perplexity</li>
          <li><span class="ent-check" aria-hidden="true">✓</span> Pipeline orgânico crescente sem anúncios</li>
        </ul>
      </div>
    </div>

    <!-- Ticker IAs -->
    <div class="ia-ticker-wrap">
      <span class="ia-ticker-label">Citada pelas IAs</span>
      <div class="ia-ticker-track-wrap">
        <div class="ia-ticker-track">
          {['ChatGPT','Gemini','Perplexity','Copilot','Grok',
            'ChatGPT','Gemini','Perplexity','Copilot','Grok'].map(ia => (
            <span class="ia-ticker-item">{ia}</span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     SEÇÃO 6 — MÉTODO 5 CAMADAS
     ═══════════════════════════════════════════════ -->
<section class="metodo-section" id="metodo">
  <div class="wrap">
    <div class="section-header cinema-reveal">
      <p class="section-eyebrow dark">O MÉTODO</p>
      <h2 class="section-h2">5 camadas. A ordem importa.</h2>
    </div>

    <div class="layers-accordion" id="layers-accordion">
      {[
        { num: '01', name: 'Fundação técnica', sub: 'Core Web Vitals, silos, Schema Markup', tag: 'Base obrigatória', tagClass: 'tag-base',
          text: 'Core Web Vitals perfeitos, arquitetura de silos semânticos, crawl budget otimizado e Schema Markup completo em JSON-LD. <strong>Sem fundação técnica, as outras 4 camadas não funcionam.</strong> É o pré-requisito que a maioria das agências ignora.' },
        { num: '02', name: 'Identidade de entidade', sub: 'Knowledge Graph, Wikidata, sameAs cruzados', tag: 'Diferencial Organum', tagClass: 'tag-diff',
          text: 'Construímos sua empresa como <strong>entidade verificável pelo Google e pelas IAs</strong>: Knowledge Graph, Wikidata, LinkedIn estruturado, menções cruzadas. Sem isso, o ChatGPT não te recomenda — independente do seu conteúdo.' },
        { num: '03', name: 'Conteúdo de autoridade', sub: 'Clusters semânticos por ICP, E-E-A-T profundo', tag: 'Fonte para IA', tagClass: 'tag-geo',
          text: 'Artigos de 2.000+ palavras organizados em clusters semânticos por ICP. <strong>E-E-A-T profundo</strong> documentado. Conteúdo que serve como fonte primária para IAs generativas.' },
        { num: '04', name: 'GEO + AEO', sub: 'ChatGPT, Gemini, Perplexity, featured snippets', tag: 'Ninguém entrega isso', tagClass: 'tag-geo',
          text: '<strong>Generative Engine Optimization</strong>: otimização para ser citado por ChatGPT, Gemini, Perplexity, Copilot e Grok. Answer Engine Optimization para featured snippets e busca por voz. Nenhuma agência brasileira entrega isso sistematicamente.' },
        { num: '05', name: 'Digital PR', sub: 'Link building editorial, assessoria de imprensa digital', tag: 'Autoridade externa', tagClass: 'tag-base',
          text: 'Link building editorial de qualidade em portais de nicho B2B. Assessoria de imprensa digital. <strong>Domain Authority crescente mês a mês.</strong> Cada menção externa reforça a entidade e alimenta as Camadas 02 e 04.' },
      ].map((layer, i) => (
        <div class="layer-item cinema-stagger" data-layer={i}>
          <button class="layer-header" id={`layer-header-${i}`} aria-expanded="false" aria-controls={`layer-body-${i}`}>
            <span class="layer-num">{layer.num}</span>
            <span class="layer-info">
              <span class="layer-name">{layer.name}</span>
              <span class="layer-sub">{layer.sub}</span>
            </span>
            <span class={`layer-tag ${layer.tagClass}`}>{layer.tag}</span>
            <span class="layer-arrow" aria-hidden="true">+</span>
          </button>
          <div class="layer-body" id={`layer-body-${i}`} role="region" aria-labelledby={`layer-header-${i}`}>
            <div class="layer-body-inner" set:html={layer.text} />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     SEÇÃO 7 — DIFERENCIAL
     ═══════════════════════════════════════════════ -->
<section class="diff-section" id="diferencial">
  <div class="wrap">
    <div class="section-header cinema-reveal">
      <p class="section-eyebrow">COMPARATIVO</p>
      <h2 class="section-h2 white">O que nenhuma outra agência entrega<br>— e nós entregamos.</h2>
    </div>

    <div class="diff-grid">
      <div class="diff-col diff-col-no" id="diff-no">
        <div class="diff-col-head">
          <span class="diff-icon-x" aria-hidden="true">✕</span>
          <span class="diff-col-title">Agência genérica</span>
        </div>
        <ul class="diff-list">
          <li class="diff-item diff-item-no"><span aria-hidden="true">✕</span> SEO técnico básico sem estratégia</li>
          <li class="diff-item diff-item-no"><span aria-hidden="true">✕</span> Conteúdo genérico sem ICP definido</li>
          <li class="diff-item diff-item-no"><span aria-hidden="true">✕</span> Relatórios de pageviews, não de pipeline</li>
          <li class="diff-item diff-item-no"><span aria-hidden="true">✕</span> Ignora GEO e citação por IA</li>
          <li class="diff-item diff-item-no"><span aria-hidden="true">✕</span> Não constrói identidade de entidade</li>
          <li class="diff-item diff-item-no"><span aria-hidden="true">✕</span> Sem Digital PR editorial</li>
          <li class="diff-item diff-item-no"><span aria-hidden="true">✕</span> Resultados param quando você para de pagar</li>
        </ul>
      </div>

      <div class="diff-col diff-col-yes" id="diff-yes">
        <div class="diff-col-head">
          <span class="diff-icon-check" aria-hidden="true">✓</span>
          <span class="diff-col-title green-text">Organum</span>
        </div>
        <ul class="diff-list">
          <li class="diff-item diff-item-yes"><span aria-hidden="true">✓</span> <strong>5 camadas integradas</strong> com foco em pipeline</li>
          <li class="diff-item diff-item-yes"><span aria-hidden="true">✓</span> Conteúdo calibrado para o <strong>ICP exato</strong></li>
          <li class="diff-item diff-item-yes"><span aria-hidden="true">✓</span> Relatórios de <strong>leads e oportunidades</strong></li>
          <li class="diff-item diff-item-yes"><span aria-hidden="true">✓</span> <strong>GEO sistematizado</strong> — único no Brasil</li>
          <li class="diff-item diff-item-yes"><span aria-hidden="true">✓</span> <strong>Entidade digital</strong> verificável e citável</li>
          <li class="diff-item diff-item-yes"><span aria-hidden="true">✓</span> Link building <strong>editorial de alta qualidade</strong></li>
          <li class="diff-item diff-item-yes"><span aria-hidden="true">✓</span> Ativo orgânico que <strong>cresce mês a mês</strong></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     SEÇÃO 8 — DORES INTERATIVAS
     ═══════════════════════════════════════════════ -->
<section class="dores-section" id="dores">
  <div class="wrap">
    <div class="section-header cinema-reveal">
      <p class="section-eyebrow">RECONHECE?</p>
      <h2 class="section-h2 white">Reconhece alguma dessas situações?</h2>
    </div>

    <div class="dores-layout">
      <div class="dores-buttons" id="dores-buttons">
        {[
          { q: '"Meu site aparece no Google mas não gera leads qualificados."', a: 'Tráfego sem intenção de compra. A Camada 03 resolve: <strong>conteúdo que captura o ICP certo</strong> no momento exato da jornada de decisão.' },
          { q: '"Quando paro os anúncios, o pipeline seca."', a: 'Dependência total de paid. O Método ORGANUM constrói <strong>um ativo orgânico que cresce sem custo incremental</strong> mês a mês — permanentemente.' },
          { q: '"Meu concorrente aparece no ChatGPT. Eu não."', a: 'GEO ausente. A Camada 04 posiciona sua marca como <strong>fonte confiável para as IAs generativas</strong> em 4 a 8 semanas.' },
          { q: '"Já investi em SEO antes e nunca funcionou."', a: 'SEO genérico para B2B falha. O Método é diferente: <strong>5 camadas integradas com foco em pipeline</strong>, não em pageviews ou posições.' },
          { q: '"Minha empresa não é citada pelas IAs."', a: 'Entidade digital ausente. A Camada 02 constrói <strong>sua presença verificável no Knowledge Graph</strong> — pré-requisito para citação por IA.' },
