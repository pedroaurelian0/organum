const obs = new IntersectionObserver(
  es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } }),
  { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
);
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

// ── Contagem animada ──
const countObs = new IntersectionObserver(es => {
  es.forEach(e => {
    if (!e.isIntersecting) return;
    const el = e.target as HTMLElement;
    const target = parseInt(el.dataset.target || '0');
    const suffix = el.dataset.suffix || '';
    const t0 = performance.now();
    const tick = (now: number) => {
      const p = Math.min((now - t0) / 1400, 1);
      const ease = 1 - Math.pow(1 - p, 3);
      el.textContent = Math.round(ease * target) + suffix;
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
    countObs.unobserve(el);
  });
}, { threshold: 0.5 });
document.querySelectorAll('.metric-num[data-target]').forEach(el => countObs.observe(el));

// ── Gráfico hero animado ──
const chartObs = new IntersectionObserver(es => {
  es.forEach(e => {
    if (!e.isIntersecting) return;
    const set = (id: string, delay: number, prop: string, val: string, trans: string) => {
      const el = document.getElementById(id);
      if (!el) return;
      setTimeout(() => { (el.style as any)[prop] = val; el.style.transition = trans; }, delay);
    };
    const paid = document.getElementById('chart-paid-line') as SVGPathElement | null;
    if (paid) setTimeout(() => { paid.style.transition = 'stroke-dashoffset 1.4s 200ms cubic-bezier(.16,1,.3,1)'; paid.style.strokeDashoffset = '0'; }, 200);
    setTimeout(() => { const el = document.getElementById('chart-paid-area'); if(el){el.style.transition='opacity .6s ease';el.style.opacity='1';} }, 500);
    const org = document.getElementById('chart-org-line') as SVGPathElement | null;
    if (org) setTimeout(() => { org.style.transition = 'stroke-dashoffset 2s 0ms cubic-bezier(.16,1,.3,1)'; org.style.strokeDashoffset = '0'; }, 700);
    setTimeout(() => {
      ['chart-org-area','chart-dot','chart-ring','chart-label-org','chart-label-paid'].forEach(id => {
        const el = document.getElementById(id); if(el){el.style.transition='opacity .4s ease';el.style.opacity='1';}
      });
    }, 2500);
    chartObs.unobserve(e.target);
  });
}, { threshold: 0.3 });
const hc = document.getElementById('hero-chart');
if (hc) chartObs.observe(hc);

