<script>
// ── Scroll reveals ──
const observer = new IntersectionObserver(
  entries => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } }),
  { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
);
document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

// ── Contagem animada de métricas ──
const countEls = document.querySelectorAll('.metric-num[data-target]');
const countObs = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (!e.isIntersecting) return;
    const el = e.target as HTMLElement;
    const target = parseInt(el.dataset.target || '0');
    const suffix = el.dataset.suffix || '';
    const dur = 1400;
    const t0 = performance.now();
    const tick = (now: number) => {
      const p = Math.min((now - t0) / dur, 1);
      const ease = 1 - Math.pow(1 - p, 3);
      el.textContent = Math.round(ease * target) + suffix;
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
    countObs.unobserve(el);
  });
}, { threshold: 0.5 });
countEls.forEach(el => countObs.observe(el));

// ── Gráfico hero animado ──
const chartObs = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (!e.isIntersecting) return;
    const animate = (id: string, delay: number, dur: number) => {
      const el = document.getElementById(id);
      if (!el) return;
      setTimeout(() => {
        el.style.transition = `opacity ${dur}ms ease`;
        el.style.opacity = '1';
        if (el.style.strokeDashoffset !== undefined) {
          (el as SVGPathElement).style.animation = `drawLine ${dur}ms ${delay}ms cubic-bezier(.16,1,.3,1) forwards`;
        }
      }, delay);
    };
    const line = (id: string, delay: number) => {
      const el = document.getElementById(id) as SVGPathElement | null;
      if (!el) return;
      setTimeout(() => {
        el.style.strokeDashoffset = '0';
        el.style.transition = `stroke-dashoffset 1.8s ${delay}ms cubic-bezier(.16,1,.3,1)`;
      }, 100);
    };
    setTimeout(() => {
      const paid = document.getElementById('chart-paid-line') as SVGPathElement | null;
      if (paid) { paid.style.transition = 'stroke-dashoffset 1.4s 200ms cubic-bezier(.16,1,.3,1)'; paid.style.strokeDashoffset = '0'; }
    }, 200);
    setTimeout(() => {
      const pArea = document.getElementById('chart-paid-area') as SVGPathElement | null;
      if (pArea) { pArea.style.transition = 'opacity 0.6s ease'; pArea.style.opacity = '1'; }
    }, 400);
    setTimeout(() => {
      const org = document.getElementById('chart-org-line') as SVGPathElement | null;
      if (org) { org.style.transition = 'stroke-dashoffset 2s 0ms cubic-bezier(.16,1,.3,1)'; org.style.strokeDashoffset = '0'; }
    }, 600);
    setTimeout(() => {
      const oArea = document.getElementById('chart-org-area') as SVGPathElement | null;
      if (oArea) { oArea.style.transition = 'opacity 0.8s ease'; oArea.style.opacity = '1'; }
      const dot = document.getElementById('chart-dot');
      const ring = document.getElementById('chart-ring');
      const lOrg = document.getElementById('chart-label-org');
      const lPaid = document.getElementById('chart-label-paid');
      [dot, ring, lOrg, lPaid].forEach(el => {
        if (el) { el.style.transition = 'opacity 0.4s ease'; el.style.opacity = '1'; }
      });
    }, 2400);
    chartObs.unobserve(e.target);
  });
}, { threshold: 0.3 });
const heroChart = document.getElementById('hero-chart');
if (heroChart) chartObs.observe(heroChart);

// ── Diagrama de entidade animado ──
const entObs = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (!e.isIntersecting) return;
    const ids = ['ent-center','ent-center-t1','ent-center-t2','ent-n1','ent-n2','ent-n3','ent-n4','ent-n5','ent-l1','ent-l2','ent-l3','ent-l4','ent-l5'];
    ids.forEach((id, i) => {
      const el = document.getElementById(id);
      if (!el) return;
      setTimeout(() => {
        el.style.transition = 'opacity 0.5s ease, transform 0.5s cubic-bezier(.16,1,.3,1)';
        el.style.opacity = '1';
      }, i * 120);
    });
    entObs.unobserve(e.target);
  });
}, { threshold: 0.3 });
