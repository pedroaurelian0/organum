---
import Page from '@layouts/Page.astro';

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'O que é o Método ORGANUM?',
      acceptedAnswer: { '@type': 'Answer', text: 'Uma abordagem sistemática em 5 camadas: fundação técnica, identidade de entidade, conteúdo de autoridade, GEO + AEO e Digital PR. Juntas, transformam empresas B2B em autoridades reconhecidas pelo Google e pelas IAs generativas.' } },
    { '@type': 'Question', name: 'Quanto tempo leva para ver resultados?',
      acceptedAnswer: { '@type': 'Answer', text: 'Resultados técnicos em 2–4 semanas. Crescimento de tráfego orgânico consistente em 3–6 meses. Citações por IAs em 4–8 semanas para marcas com presença digital mínima.' } },
    { '@type': 'Question', name: 'Para quem é a Organum?',
      acceptedAnswer: { '@type': 'Answer', text: 'Empresas B2B (consultoria, SaaS, distribuidora, indústria) e e-commerce com faturamento acima de R$500k/ano que querem crescer sem depender de tráfego pago.' } },
    { '@type': 'Question', name: 'A Organum atende fora de Recife?',
      acceptedAnswer: { '@type': 'Answer', text: 'Sim. Atendemos todo o Brasil e internacionalmente — o case 7+ Vacations é um exemplo de atendimento bilíngue PT/EN para operação na Flórida.' } },
  ],
};

const websiteSchema = {
  '@type': 'WebSite',
  '@id': 'https://organum.com.br/#website',
  url: 'https://organum.com.br',
  name: 'Organum',
  publisher: { '@type': 'Organization', '@id': 'https://organum.com.br/#organization' },
  inLanguage: 'pt-BR',
};

const layers = [
  { num: '01', name: 'Fundação técnica',      desc: 'Core Web Vitals perfeitos, arquitetura de silos, crawl budget otimizado e Schema Markup completo em JSON-LD.', href: '/metodo/fundacao' },
  { num: '02', name: 'Identidade de entidade', desc: 'Google Knowledge Graph, Wikidata, LinkedIn estruturado e menções cruzadas — o que as IAs precisam para reconhecer sua marca.', href: '/metodo/entidade' },
  { num: '03', name: 'Conteúdo de autoridade', desc: 'Clusters semânticos por ICP, artigos 2.000+ palavras, E-E-A-T profundo. Conteúdo que serve como fonte primária para IAs generativas.', href: '/metodo/conteudo' },
  { num: '04', name: 'GEO + AEO',              desc: 'Otimização para ser citado por ChatGPT, Gemini, Perplexity, Copilot e Grok. Featured snippets e busca por voz.', href: '/metodo/geo-aeo' },
  { num: '05', name: 'Digital PR',             desc: 'Link building editorial de qualidade, assessoria de imprensa digital, menções em portais de nicho, Domain Authority crescente.', href: '/metodo/digital-pr' },
];

const icps = [
  { icon: '◈', title: 'E-commerce',         range: 'R$500k – R$30M/ano',   ticket: 'R$3.500 – R$9.000/mês',  desc: 'Categoria, produto e blog otimizados para capturar demanda orgânica nos momentos de compra.' },
  { icon: '◉', title: 'B2B: consultoria, SaaS, indústria', range: 'R$250k – R$2M/mês', ticket: 'R$5.000 – R$8.000/mês', desc: 'Pipeline orgânico para ciclos de venda longos com múltiplos decisores.' },
  { icon: '◎', title: 'Operação internacional', range: 'Qualquer porte',    ticket: 'Sob consulta',            desc: 'SEO bilíngue PT/EN. Autoridade de entidade em múltiplas regiões e idiomas.' },
];

const faqs = [
  { q: 'O que é o Método ORGANUM?',   a: 'Uma abordagem em 5 camadas — fundação técnica, identidade de entidade, conteúdo, GEO/AEO e Digital PR — que transforma empresas B2B em autoridades no Google e nas IAs.' },
  { q: 'Quanto tempo leva para ver resultado?', a: 'Resultados técnicos em 2–4 semanas. Tráfego orgânico consistente em 3–6 meses. Citações por IAs em 4–8 semanas para marcas com presença digital mínima.' },
  { q: 'Para quem é a Organum?',     a: 'Empresas B2B (consultoria, SaaS, distribuidora, indústria) e e-commerce acima de R$500k/ano que querem crescer sem depender de tráfego pago.' },
  { q: 'Vocês atendem fora de Recife?', a: 'Sim. Atendemos todo o Brasil e internacionalmente — temos cases bilíngues PT/EN para operações nos EUA.' },
];
---

<Page
  title="Agência de SEO orgânico B2B | Método ORGANUM — Recife"
  description="Transformamos empresas B2B em autoridades no Google e nas IAs com o Método ORGANUM — as 5 camadas que geram pipeline comercial sem tráfego pago."
  ogType="website"
  schemaExtra={[websiteSchema, faqSchema]}
>

<!-- ═══════════════════════════════════════════
     HERO
═══════════════════════════════════════════ -->
<section class="hero">
  <div class="hero-grid"></div>

  <div class="hero-content">
    <!-- Coluna esquerda: texto -->
    <div>
      <p class="hero-eyebrow anim-fade-up d1">Método ORGANUM — 5 camadas comprovadas</p>
      <h1 class="hero-title anim-fade-up d2">
        SEO orgânico<br/>
        que gera<br/>
        pipeline B2B —<br/>
        <em>não apenas cliques</em>
      </h1>
      <p class="hero-sub anim-fade-up d3">
        O Método ORGANUM leva sua empresa do zero técnico à citação por IA. Sem tráfego pago. Sem dependência de algoritmos de mídia social.
      </p>
      <div class="hero-actions anim-fade-up d4">
        <a href="/auditoria-gratuita" class="btn btn-green" style="padding:.875rem 2rem;font-size:.875rem;">
          Solicitar auditoria gratuita
        </a>
        <a href="/metodo" class="btn btn-outline" style="padding:.875rem 2rem;font-size:.875rem;border-color:rgba(255,255,255,.2);color:rgba(255,255,255,.6);">
          Ver o método →
        </a>
      </div>
    </div>

    <!-- Coluna direita: gráfico SVG animado -->
    <div class="anim-fade-in d5" style="width:100%;max-width:520px;margin-inline:auto;">
      <svg viewBox="0 0 520 380" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;" aria-label="Gráfico comparativo: crescimento orgânico vs tráfego pago ao longo do tempo">

        <!-- Grid lines -->
        <line x1="60" y1="40"  x2="500" y2="40"  stroke="rgba(255,255,255,.06)" stroke-width="1"/>
        <line x1="60" y1="100" x2="500" y2="100" stroke="rgba(255,255,255,.06)" stroke-width="1"/>
        <line x1="60" y1="160" x2="500" y2="160" stroke="rgba(255,255,255,.06)" stroke-width="1"/>
        <line x1="60" y1="220" x2="500" y2="220" stroke="rgba(255,255,255,.06)" stroke-width="1"/>
        <line x1="60" y1="280" x2="500" y2="280" stroke="rgba(255,255,255,.06)" stroke-width="1"/>
        <line x1="60" y1="320" x2="500" y2="320" stroke="rgba(255,255,255,.08)" stroke-width="1"/>

        <!-- Axis -->
        <line x1="60" y1="320" x2="500" y2="320" stroke="rgba(255,255,255,.15)" stroke-width="1"/>
        <line x1="60" y1="40"  x2="60"  y2="320" stroke="rgba(255,255,255,.15)" stroke-width="1"/>

        <!-- X labels -->
        <text x="60"  y="338" fill="rgba(255,255,255,.3)" font-size="10" text-anchor="middle" font-family="DM Sans, sans-serif">Mês 0</text>
        <text x="170" y="338" fill="rgba(255,255,255,.3)" font-size="10" text-anchor="middle" font-family="DM Sans, sans-serif">Mês 3</text>
        <text x="280" y="338" fill="rgba(255,255,255,.3)" font-size="10" text-anchor="middle" font-family="DM Sans, sans-serif">Mês 6</text>
        <text x="390" y="338" fill="rgba(255,255,255,.3)" font-size="10" text-anchor="middle" font-family="DM Sans, sans-serif">Mês 9</text>
        <text x="500" y="338" fill="rgba(255,255,255,.3)" font-size="10" text-anchor="middle" font-family="DM Sans, sans-serif">Mês 12</text>

        <!-- Y labels -->
        <text x="50" y="324" fill="rgba(255,255,255,.25)" font-size="9" text-anchor="end" font-family="DM Sans, sans-serif">0</text>
        <text x="50" y="224" fill="rgba(255,255,255,.25)" font-size="9" text-anchor="end" font-family="DM Sans, sans-serif">50</text>
        <text x="50" y="124" fill="rgba(255,255,255,.25)" font-size="9" text-anchor="end" font-family="DM Sans, sans-serif">100</text>
        <text x="50" y="54"  fill="rgba(255,255,255,.25)" font-size="9" text-anchor="end" font-family="DM Sans, sans-serif">130</text>

        <!-- Área tráfego pago (vermelho/laranja — sobe e cai) -->
        <path
          d="M60,310 C120,290 150,220 170,180 C190,140 200,160 220,200 C250,250 280,290 320,310 L500,310"
          fill="rgba(220,80,60,.1)"
          stroke="none"
        />
        <path
          d="M60,310 C120,290 150,220 170,180 C190,140 200,160 220,200 C250,250 280,290 320,310 L500,310"
          fill="none"
          stroke="rgba(220,100,70,.6)"
          stroke-width="1.5"
          stroke-dasharray="1000"
          stroke-dashoffset="1000"
          style="animation: drawLine 2s .3s cubic-bezier(.16,1,.3,1) forwards;"
        />

        <!-- Área orgânico (verde — sobe consistentemente) -->
        <path
          d="M60,318 L60,318 C120,315 170,305 220,285 C270,260 320,220 370,175 C420,130 460,85 500,55 L500,320 Z"
          fill="rgba(46,145,71,.15)"
          stroke="none"
        />
        <path
          d="M60,318 C120,315 170,305 220,285 C270,260 320,220 370,175 C420,130 460,85 500,55"
          fill="none"
          stroke="#4caf64"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-dasharray="1000"
          stroke-dashoffset="1000"
          style="animation: drawLine 2.2s .5s cubic-bezier(.16,1,.3,1) forwards;"
        />

        <!-- Dot final orgânico -->
        <circle cx="500" cy="55" r="5" fill="#4caf64" opacity="0" style="animation: popIn .4s 2.5s forwards;"/>
        <circle cx="500" cy="55" r="10" fill="rgba(76,175,100,.2)" opacity="0" style="animation: popIn .4s 2.6s forwards;"/>

        <!-- Labels -->
        <g opacity="0" style="animation: fadeIn .4s 2.7s forwards;">
          <rect x="360" y="38" width="130" height="22" rx="2" fill="rgba(76,175,100,.15)" stroke="rgba(76,175,100,.4)" stroke-width="1"/>
          <text x="368" y="53" fill="#4caf64" font-size="10" font-weight="600" font-family="DM Sans, sans-serif">SEO orgânico ↑ 127%</text>
        </g>

        <g opacity="0" style="animation: fadeIn .4s 2.2s forwards;">
          <rect x="155" y="163" width="118" height="22" rx="2" fill="rgba(220,80,60,.12)" stroke="rgba(220,100,70,.3)" stroke-width="1"/>
          <text x="163" y="178" fill="rgba(220,130,100,1)" font-size="10" font-weight="600" font-family="DM Sans, sans-serif">Tráfego pago — cessa</text>
        </g>

        <!-- Título do gráfico -->
        <text x="60" y="22" fill="rgba(255,255,255,.35)" font-size="10" font-weight="600" letter-spacing="1" font-family="DM Sans, sans-serif" text-anchor="start">PIPELINE ORGÂNICO vs. TRÁFEGO PAGO — 12 MESES</text>
      </svg>
    </div>
  </div>

  <!-- Ticker de clientes no rodapé do hero -->
  <div style="position:relative;z-index:2;border-top:1px solid rgba(255,255,255,.07);padding:1.25rem clamp(1rem,4vw,3rem);">
    <div style="max-width:1280px;margin-inline:auto;display:flex;align-items:center;gap:2rem;flex-wrap:wrap;">
      <span style="font-size:.65rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:rgba(255,255,255,.25);white-space:nowrap;">Confiam no método</span>
      {['HunterHunter', '7+ Vacations', 'Global Electronics', 'Nexxo Digital'].map((name) => (
        <span style="font-size:.875rem;font-weight:500;color:rgba(255,255,255,.35);transition:color .2s;" onmouseover="this.style.color='rgba(255,255,255,.7)'" onmouseout="this.style.color='rgba(255,255,255,.35)'">{name}</span>
      ))}
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════
     MÉTRICAS
═══════════════════════════════════════════ -->
<div class="metrics-strip">
  <div class="metrics-grid wrap">
    {[
      { num: '5',    suffix: '',  label: 'Camadas do método' },
      { num: '90',   suffix: 'd', label: 'Para citação por IA' },
      { num: '340',  suffix: '%', label: 'Crescimento orgânico' },
      { num: '48',   suffix: 'h', label: 'Para o diagnóstico' },
    ].map((m, i) => (
      <div class="metric-item reveal" style={`transition-delay:${i * .1}s`}>
        <span class="metric-num" data-target={m.num}>{m.num}{m.suffix}</span>
        <span class="metric-label">{m.label}</span>
      </div>
    ))}
  </div>
</div>

<!-- ═══════════════════════════════════════════
     STATEMENT
═══════════════════════════════════════════ -->
<section class="section">
  <div class="wrap-md">
    <div style="display:grid;grid-template-columns:1fr 2fr;gap:4rem;align-items:start;" class="statement-grid reveal">
      <div>
        <div style="width:2px;height:48px;background:var(--color-g-500);margin-bottom:1.5rem;"></div>
        <p style="font-size:.7rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--color-n-400);">Por que a Organum</p>
      </div>
      <p class="statement">
        Nenhuma agência brasileira entrega <em>GEO sistematicamente.</em> Nós entregamos — e provamos com dados.
      </p>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════
     MÉTODO — 5 CAMADAS
═══════════════════════════════════════════ -->
<section class="section-alt section">
  <div class="wrap">
    <div style="display:flex;align-items:baseline;justify-content:space-between;gap:2rem;margin-bottom:3rem;flex-wrap:wrap;">
      <div class="reveal">
        <p style="font-size:.7rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--color-n-400);margin-bottom:.75rem;">O Método ORGANUM</p>
