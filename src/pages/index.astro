      </div>
      <a href="/metodo" style="font-size:.75rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--color-g-600);white-space:nowrap;flex-shrink:0;" class="reveal reveal-d2">
        Ver método completo →
      </a>
    </div>

    <div class="layers-grid reveal">
      {layers.map((l, i) => (
        <a href={l.href} class="layer-item">
          <span class="layer-num">{l.num}</span>
          <div>
            <p class="layer-name">{l.name}</p>
            <p class="layer-desc">{l.desc}</p>
            <span class="layer-arrow">Saiba mais →</span>
          </div>
        </a>
      ))}
      <!-- Card CTA 6º slot -->
      <a href="/metodo" style="padding:2.5rem;background:var(--color-n-950);display:flex;flex-direction:column;justify-content:space-between;text-decoration:none;border-bottom:1px solid var(--color-n-200);transition:background .2s;" onmouseover="this.style.background='var(--color-g-800)'" onmouseout="this.style.background='var(--color-n-950)'">
        <p style="font-family:var(--font-serif);font-size:1.5rem;font-weight:700;color:white;line-height:1.2;">Ver o<br/>método completo</p>
        <span style="font-size:2rem;color:var(--color-g-400);">→</span>
      </a>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════
     PARA QUEM É — ICPs
═══════════════════════════════════════════ -->
<section class="section">
  <div class="wrap">
    <div style="margin-bottom:3rem;" class="reveal">
