<!-- ═══════════════════════════════════════════════
     CINEMATOGRAPHIC SCRIPT
     ═══════════════════════════════════════════════ -->
<script is:inline>
(function() {
  'use strict';

  // ── Esperar libs carregarem ──────────────────────────────────
  function waitForGSAP(cb) {
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined' && typeof Lenis !== 'undefined') {
      cb();
    } else {
      setTimeout(function() { waitForGSAP(cb); }, 50);
    }
  }

  // ── PRÉ-LOADER ───────────────────────────────────────────────
  var preloader = document.getElementById('preloader');
  var preloaderLogo = document.getElementById('preloader-logo');

  if (preloader && preloaderLogo) {
    document.body.style.overflow = 'hidden';

    // Silêncio de 200ms, depois logo emerge
    setTimeout(function() {
      preloaderLogo.style.willChange = 'opacity, letter-spacing';
      preloaderLogo.style.transition = 'opacity 600ms cubic-bezier(.16,1,.3,1), letter-spacing 600ms cubic-bezier(.16,1,.3,1)';
      preloaderLogo.style.opacity = '1';
      preloaderLogo.style.letterSpacing = '-0.02em';

      // Após 600ms visível + 400ms pausa → sobe e some
      setTimeout(function() {
        preloaderLogo.style.transition = 'opacity 400ms ease, transform 500ms cubic-bezier(.4,0,.2,1)';
        preloaderLogo.style.opacity = '0';
        preloaderLogo.style.transform = 'translateY(-60px)';

        setTimeout(function() {
          preloader.style.transition = 'opacity 300ms ease';
          preloader.style.opacity = '0';
          preloader.style.pointerEvents = 'none';
          document.body.style.overflow = '';

          setTimeout(function() {
            preloader.style.display = 'none';
            waitForGSAP(initCinema);
          }, 300);
        }, 450);
      }, 1000);
    }, 200);
  } else {
    waitForGSAP(initCinema);
  }

  // ── MAIN INIT ────────────────────────────────────────────────
  function initCinema() {
    gsap.registerPlugin(ScrollTrigger);

    // ── Lenis smooth scroll ───────────────────────────────────
    var lenis = new Lenis({
      duration: 1.4,
      easing: function(t) { return Math.min(1, 1.001 - Math.pow(2, -10 * t)); },
      orientation: 'vertical',
      gestureOrientation: 'vertical',
      smoothWheel: true,
      wheelMultiplier: 0.8,
      smoothTouch: false,
    });

    lenis.on('scroll', ScrollTrigger.update);

    gsap.ticker.add(function(time) {
      lenis.raf(time * 1000);
    });
    gsap.ticker.lagSmoothing(0);

    ScrollTrigger.defaults({
      ease: 'power3.out',
    });

    // ── HERO ENTRANCE ─────────────────────────────────────────
    var heroTl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    var eye  = document.getElementById('h-eye');
    var l1   = document.getElementById('h1-l1');
    var l2   = document.getElementById('h1-l2');
    var l3   = document.getElementById('h1-l3');
    var em   = document.getElementById('h1-em');
    var sub  = document.getElementById('h-sub');
    var ctas = document.getElementById('h-ctas');
    var div  = document.getElementById('hero-divider');
    var chart = document.getElementById('hero-chart-wrap');

    if (eye)  { eye.style.willChange = 'transform, opacity'; }
    if (l1)   { l1.style.willChange = 'transform, opacity'; }
    if (l2)   { l2.style.willChange = 'transform, opacity'; }
    if (l3)   { l3.style.willChange = 'transform, opacity'; }
    if (em)   { em.style.willChange = 'transform, opacity'; }
    if (sub)  { sub.style.willChange = 'transform, opacity'; }
    if (ctas) { ctas.style.willChange = 'transform, opacity'; }

    heroTl
      .fromTo(eye,  { y: 20, opacity: 0 }, { y: 0, opacity: 1, duration: 0.8 }, 0.1)
      .fromTo(l1,   { y: 60, opacity: 0 }, { y: 0, opacity: 1, duration: 1.0 }, 0.2)
      .fromTo(l2,   { y: 60, opacity: 0 }, { y: 0, opacity: 1, duration: 1.0 }, 0.35)
      .fromTo(l3,   { y: 60, opacity: 0 }, { y: 0, opacity: 1, duration: 1.0 }, 0.5)
      .fromTo(em,   { y: 40, opacity: 0 }, { y: 0, opacity: 1, duration: 0.9 }, 0.5)
      .fromTo(sub,  { y: 30, opacity: 0 }, { y: 0, opacity: 1, duration: 0.8 }, 0.7)
      .fromTo(ctas, { y: 20, opacity: 0 }, { y: 0, opacity: 1, duration: 0.7 }, 0.9)
      .fromTo(div,  { scaleX: 0, transformOrigin: 'left center' }, { scaleX: 1, duration: 1.4, ease: 'power2.inOut' }, 1.0)
      .fromTo(chart,{ x: 40, opacity: 0 }, { x: 0, opacity: 1, duration: 1.2 }, 0.4)
      .add(function() {
        // Limpar will-change após entrada
        [eye,l1,l2,l3,em,sub,ctas].forEach(function(el) { if (el) el.style.willChange = 'auto'; });
      });

    // ── SVG CHART ANIMATION ───────────────────────────────────
    heroTl.add(function() {
      var orgLine   = document.getElementById('chart-org-line');
      var orgArea   = document.getElementById('chart-org-area');
      var paidLine  = document.getElementById('chart-paid-line');
      var paidArea  = document.getElementById('chart-paid-area');
      var dot       = document.getElementById('chart-dot');
      var ring      = document.getElementById('chart-ring');
      var labelOrg  = document.getElementById('chart-label-org');
      var labelPaid = document.getElementById('chart-label-paid');

      if (!orgLine) return;

      var chartTl = gsap.timeline({ delay: 0.2 });
      chartTl
        .to(orgLine,   { strokeDashoffset: 0, duration: 1.8, ease: 'power2.inOut' })
        .to(paidLine,  { strokeDashoffset: 0, duration: 1.4, ease: 'power2.inOut' }, '-=1.4')
        .to([orgArea, paidArea], { opacity: 1, duration: 0.6 }, '-=0.8')
        .to([dot, ring, labelOrg, labelPaid], { opacity: 1, duration: 0.5, stagger: 0.1 });
    }, '-=0.6');

    // ── STATEMENT — CLIP REVEAL ───────────────────────────────
    var stH2 = document.getElementById('statement-h2');
    if (stH2) {
      stH2.style.willChange = 'clip-path';
      gsap.fromTo(stH2,
        { clipPath: 'inset(0 100% 0 0)' },
        {
          clipPath: 'inset(0 0% 0 0)',
          duration: 1.2,
          ease: 'power3.inOut',
          scrollTrigger: {
            trigger: stH2,
            start: 'top 80%',
            toggleActions: 'play none none none',
            onComplete: function() { stH2.style.willChange = 'auto'; }
          }
        }
      );
    }

    // ── METRICS COUNTER ───────────────────────────────────────
    var metricItems = document.querySelectorAll('.metric-item');
    metricItems.forEach(function(item, i) {
      var numEl  = item.querySelector('.metric-num');
      var target = parseInt(item.dataset.target || '0', 10);
      var suffix = item.dataset.suffix || '';
      var delay  = parseFloat(item.dataset.delay || '0');

      item.style.willChange = 'transform, opacity';

      gsap.fromTo(item,
        { y: 50, opacity: 0 },
        {
          y: 0, opacity: 1, duration: 0.9,
          ease: 'power3.out',
          delay: delay,
          scrollTrigger: {
            trigger: item,
            start: 'top 85%',
            toggleActions: 'play none none none',
            onEnter: function() {
              if (!numEl) return;
              var start = 0;
              var duration = 1800;
              var startTime = null;
              function step(ts) {
                if (!startTime) startTime = ts;
                var progress = Math.min((ts - startTime) / duration, 1);
                var ease = 1 - Math.pow(1 - progress, 3);
                var val = Math.round(ease * target);
                numEl.textContent = val + suffix;
                if (progress < 1) requestAnimationFrame(step);
              }
              setTimeout(function() { requestAnimationFrame(step); }, delay * 1000);
              item.style.willChange = 'auto';
            }
          }
        }
      );
    });

    // ── GENERIC CINEMA REVEAL ─────────────────────────────────
    gsap.utils.toArray('.cinema-reveal').forEach(function(el) {
      el.style.willChange = 'transform, opacity';
      gsap.fromTo(el,
        { y: 50, opacity: 0 },
        {
          y: 0, opacity: 1, duration: 1.0, ease: 'power3.out',
          scrollTrigger: {
            trigger: el,
            start: 'top 82%',
            toggleActions: 'play none none none',
            onComplete: function() { el.style.willChange = 'auto'; }
          }
        }
      );
    });

    // ── STAGGER CARDS ─────────────────────────────────────────
    var staggerGroups = {};
    document.querySelectorAll('.cinema-stagger').forEach(function(el) {
      var parent = el.parentElement;
      var key = parent ? parent.id || parent.className : 'root';
      if (!staggerGroups[key]) staggerGroups[key] = [];
      staggerGroups[key].push(el);
    });

    Object.values(staggerGroups).forEach(function(group) {
      group.forEach(function(el) { el.style.willChange = 'transform, opacity'; });
      gsap.fromTo(group,
        { y: 40, opacity: 0 },
        {
          y: 0, opacity: 1, duration: 0.8, ease: 'power3.out',
          stagger: 0.1,
          scrollTrigger: {
            trigger: group[0],
            start: 'top 82%',
            toggleActions: 'play none none none',
            onComplete: function() { group.forEach(function(el) { el.style.willChange = 'auto'; }); }
          }
        }
      );
    });

    // ── ENTIDADE PIN + REVEAL ─────────────────────────────────
    var entNo  = document.getElementById('entidade-no');
    var entYes = document.getElementById('entidade-yes');

    if (entNo && entYes) {
      entNo.style.willChange  = 'transform, opacity';
      entYes.style.willChange = 'transform, opacity';

      var entTl = gsap.timeline({
        scrollTrigger: {
          trigger: '.entidade-section',
          start: 'top 75%',
          toggleActions: 'play none none none',
          onComplete: function() {
            entNo.style.willChange  = 'auto';
            entYes.style.willChange = 'auto';
          }
        }
      });
      entTl
        .fromTo(entNo,  { x: -60, opacity: 0 }, { x: 0, opacity: 1, duration: 0.9, ease: 'power3.out' })
        .fromTo(entYes, { x:  60, opacity: 0 }, { x: 0, opacity: 1, duration: 0.9, ease: 'power3.out' }, '-=0.6');
    }

    // ── DIFF COLUMNS ─────────────────────────────────────────
    var diffNo  = document.getElementById('diff-no');
    var diffYes = document.getElementById('diff-yes');

    if (diffNo && diffYes) {
      diffNo.style.willChange  = 'transform, opacity';
      diffYes.style.willChange = 'transform, opacity';

      var diffTl = gsap.timeline({
        scrollTrigger: {
          trigger: '.diff-section',
          start: 'top 75%',
          toggleActions: 'play none none none',
          onComplete: function() {
            diffNo.style.willChange  = 'auto';
            diffYes.style.willChange = 'auto';
          }
        }
      });
      diffTl
        .fromTo(diffNo,  { x: -60, opacity: 0 }, { x: 0, opacity: 1, duration: 1.0, ease: 'power3.out' })
        .fromTo(diffYes, { x:  60, opacity: 0 }, { x: 0, opacity: 1, duration: 1.0, ease: 'power3.out' }, '-=0.7');
    }

    // ── LAYERS ACCORDION (GSAP height) ───────────────────────
    document.querySelectorAll('.layer-header').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var layerItem  = btn.closest('.layer-item');
        var body       = layerItem ? layerItem.querySelector('.layer-body') : null;
        var inner      = body ? body.querySelector('.layer-body-inner') : null;
        var arrow      = btn.querySelector('.layer-arrow');
        var isOpen     = layerItem && layerItem.classList.contains('open');
        var expanded   = btn.getAttribute('aria-expanded') === 'true';

        // Fechar todos
        document.querySelectorAll('.layer-item').forEach(function(item) {
          var b = item.querySelector('.layer-body');
          var a = item.querySelector('.layer-arrow');
          var h = item.querySelector('.layer-header');
          item.classList.remove('open');
          if (h) h.setAttribute('aria-expanded', 'false');
          if (a) a.textContent = '+';
          if (b) {
            gsap.to(b, { height: 0, duration: 0.4, ease: 'power2.inOut',
              onComplete: function() { b.style.overflow = 'hidden'; } });
          }
        });

        // Abrir o clicado se estava fechado
        if (!expanded && layerItem && body && inner) {
          layerItem.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
          if (arrow) arrow.textContent = '−';

          var targetH = inner.scrollHeight;
          body.style.overflow = 'hidden';
          gsap.fromTo(body,
            { height: 0 },
            { height: targetH, duration: 0.5, ease: 'power2.out',
              onComplete: function() { body.style.height = 'auto'; body.style.overflow = 'visible'; } }
          );
        }
      });
    });

    // ── DORES INTERATIVAS ─────────────────────────────────────
    var dorData = [
      { q: '"Meu site aparece no Google mas não gera leads qualificados."', a: 'Tráfego sem intenção de compra. A Camada 03 resolve: <strong>conteúdo que captura o ICP certo</strong> no momento exato da jornada de decisão.' },
      { q: '"Quando paro os anúncios, o pipeline seca."', a: 'Dependência total de paid. O Método ORGANUM constrói <strong>um ativo orgânico que cresce sem custo incremental</strong> mês a mês — permanentemente.' },
      { q: '"Meu concorrente aparece no ChatGPT. Eu não."', a: 'GEO ausente. A Camada 04 posiciona sua marca como <strong>fonte confiável para as IAs generativas</strong> em 4 a 8 semanas.' },
      { q: '"Já investi em SEO antes e nunca funcionou."', a: 'SEO genérico para B2B falha. O Método é diferente: <strong>5 camadas integradas com foco em pipeline</strong>, não em pageviews ou posições.' },
      { q: '"Minha empresa não é citada pelas IAs."', a: 'Entidade digital ausente. A Camada 02 constrói <strong>sua presença verificável no Knowledge Graph</strong> — pré-requisito para citação por IA.' },
      { q: '"Quero crescer sem depender de tráfego pago."', a: 'Esse é exatamente o perfil que o Método ORGANUM serve. <strong>Pipeline orgânico B2B previsível</strong> — sem anúncios, sem dependência de algoritmo.' },
    ];

    document.querySelectorAll('.dor-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var idx = parseInt(btn.dataset.index || '0', 10);

        document.querySelectorAll('.dor-btn').forEach(function(b) {
          b.classList.remove('active');
          b.setAttribute('aria-expanded', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-expanded', 'true');

        // Desktop
        var box  = document.getElementById('dor-answer-box');
        var qEl  = document.getElementById('dor-q');
        var aEl  = document.getElementById('dor-a');
        if (box) {
          gsap.to(box, { opacity: 0, duration: 0.15, onComplete: function() {
            if (qEl) qEl.textContent = dorData[idx].q;
            if (aEl) aEl.innerHTML  = dorData[idx].a;
            gsap.to(box, { opacity: 1, duration: 0.25 });
          }});
        }

        // Mobile inline
        document.querySelectorAll('.dor-inline-answer').forEach(function(el) {
          el.style.display = 'none';
          el.setAttribute('aria-hidden', 'true');
        });
        var inline = document.getElementById('dor-inline-' + idx);
        if (inline) {
          inline.style.display = 'block';
          inline.setAttribute('aria-hidden', 'false');
        }
      });
    });

    // ── FAQ ARROW UPDATE ──────────────────────────────────────
    document.querySelectorAll('.faq-item').forEach(function(details) {
      var arrow = details.querySelector('.faq-arrow');
      details.addEventListener('toggle', function() {
        if (arrow) arrow.textContent = details.open ? '−' : '+';
      });
    });

  } // end initCinema

})();
</script>

