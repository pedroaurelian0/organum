<script is:inline src="https://cdn.jsdelivr.net/npm/@studio-freight/lenis@1.0.42/bundled/lenis.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

<!-- ══════════════════════════════════════════════════════════
     SCRIPT PRINCIPAL
     ══════════════════════════════════════════════════════════ -->
<script is:inline>
(function(){
'use strict';

/* ─── CURSOR ──────────────────────────────────────────────────────────── */
var curDot  = document.getElementById('cur-dot');
var curRing = document.getElementById('cur-ring');
var mouseX=0, mouseY=0, ringX=0, ringY=0;

document.addEventListener('mousemove', function(e){
  mouseX = e.clientX; mouseY = e.clientY;
  if(curDot){ curDot.style.transform = 'translate('+(mouseX-3)+'px,'+(mouseY-3)+'px)'; }
});

function lerpCursor(){
  ringX += (mouseX - ringX) * 0.12;
  ringY += (mouseY - ringY) * 0.12;
  if(curRing) curRing.style.transform = 'translate('+(ringX-16)+'px,'+(ringY-16)+'px)';
  requestAnimationFrame(lerpCursor);
}
lerpCursor();

document.querySelectorAll('a,button').forEach(function(el){
  el.addEventListener('mouseenter', function(){ if(curRing) curRing.classList.add('expand'); });
  el.addEventListener('mouseleave', function(){ if(curRing) curRing.classList.remove('expand'); });
});

/* ─── PRÉ-LOADER ──────────────────────────────────────────────────────── */
var PL  = document.getElementById('preloader');
var PLO = document.getElementById('pl-logo');
var PLB = document.getElementById('pl-bar');

function hidePL(cb){
  if(!PL){ cb(); return; }
  document.body.style.overflow = 'hidden';

  // Barra de progresso
  if(PLB){
    PLB.style.transition = 'width 1.0s cubic-bezier(.16,1,.3,1)';
    setTimeout(function(){ PLB.style.width='100%'; }, 100);
  }

  // Logo emerge após 200ms
  setTimeout(function(){
    if(PLO){
      PLO.style.opacity = '1';
      PLO.style.letterSpacing = '-0.02em';
    }
    // Logo sobe e some após 1.2s total
    setTimeout(function(){
      if(PLO){
        PLO.style.opacity = '0';
        PLO.style.transform = 'translateY(-100px) scale(.9)';
      }
      setTimeout(function(){
        if(PL){
          PL.style.opacity = '0';
          PL.style.pointerEvents = 'none';
        }
        document.body.style.overflow = '';
        setTimeout(function(){
          if(PL) PL.style.display = 'none';
          cb();
        }, 400);
      }, 500);
    }, 1000);
  }, 200);
}

/* ─── HELPERS ─────────────────────────────────────────────────────────── */
function q(s){ return document.querySelector(s); }
function qa(s){ return Array.from(document.querySelectorAll(s)); }

/* ─── MAIN ─────────────────────────────────────────────────────────────── */
function initCine(){
  if(typeof gsap === 'undefined'){ return; }
  gsap.registerPlugin(ScrollTrigger);

  /* ── Lenis ──────────────────────────────────────────────────────────── */
  try{
    var LC = window.Lenis || (typeof Lenis!=='undefined'?Lenis:null);
    if(LC){
      var lenis = new LC({ duration:1.4, easing:function(t){return Math.min(1,1.001-Math.pow(2,-10*t));}, smoothWheel:true, wheelMultiplier:0.85, smoothTouch:false });
      lenis.on('scroll', ScrollTrigger.update);
      function rf(t){ lenis.raf(t); requestAnimationFrame(rf); }
      requestAnimationFrame(rf);
    }
  }catch(e){}

  /* ── HERO ENTRANCE ──────────────────────────────────────────────────── */
  var els = {
    badge: q('#h-badge'), hl1:q('#hl1'), hl2:q('#hl2'), hl3:q('#hl3'), hl4:q('#hl4'),
    sub:q('#h-sub'), ctas:q('#h-ctas'), proof:q('#h-proof'),
    dashboard:q('#hero-dashboard'), floatBadge:q('#float-badge'),
  };

  gsap.set([els.badge,els.hl1,els.hl2,els.hl3,els.hl4,els.sub,els.ctas,els.proof], {opacity:0,y:40});
  gsap.set(els.dashboard, {opacity:0,x:60,rotateY:8});
  gsap.set(els.floatBadge, {opacity:0,y:20,scale:.9});

  var htl = gsap.timeline({defaults:{ease:'power3.out'}});
  htl
    .to(els.badge,     {opacity:1,y:0,duration:.7}, 0.1)
    .to(els.hl1,       {opacity:1,y:0,duration:1.0}, 0.2)
    .to(els.hl2,       {opacity:1,y:0,duration:1.0}, 0.32)
    .to(els.hl3,       {opacity:1,y:0,duration:1.0}, 0.44)
    .to(els.hl4,       {opacity:1,y:0,duration:.9},  0.44)
    .to(els.sub,       {opacity:1,y:0,duration:.8},  0.62)
    .to(els.ctas,      {opacity:1,y:0,duration:.7},  0.78)
    .to(els.proof,     {opacity:1,y:0,duration:.6},  0.90)
    .to(els.dashboard, {opacity:1,x:0,rotateY:0,duration:1.2,ease:'power2.out'}, 0.3)
    .to(els.floatBadge,{opacity:1,y:0,scale:1,duration:.6,ease:'back.out(1.7)'}, 1.1)
    .add(function(){ animChart(); animDashStats(); });

  /* ── SVG CHART ──────────────────────────────────────────────────────── */
  function animChart(){
    var ol=q('#c-org-line'), pl=q('#c-paid-line'), oa=q('#c-org-area'), pa=q('#c-paid-area');
    var dot=q('#c-dot'), ring=q('#c-ring'), lbl=q('#c-lbl'), lbl2=q('#c-lbl2');
    if(!ol) return;
    gsap.timeline({delay:.2})
      .to(ol,  {strokeDashoffset:0, duration:1.8, ease:'power2.inOut'})
      .to(pl,  {strokeDashoffset:0, duration:1.4, ease:'power2.inOut'}, '-=1.4')
      .to([oa,pa], {opacity:1, duration:.6}, '-=.8')
      .to([dot,ring,lbl,lbl2], {opacity:1, duration:.4, stagger:.1});
  }

  /* ── DASHBOARD STATS COUNTER ────────────────────────────────────────── */
  function animDashStats(){
    var stats=[{el:q('#ds1'),from:0,to:340,sfx:'%'},{el:q('#ds2'),from:0,to:90,sfx:'d'},{el:q('#ds3'),from:0,to:47,sfx:'+'}];
    stats.forEach(function(s,i){
      setTimeout(function(){
        if(!s.el) return;
        var start=null, dur=1500;
        function step(ts){
          if(!start) start=ts;
          var p=Math.min((ts-start)/dur,1), e=1-Math.pow(1-p,3);
          s.el.textContent=Math.round(e*s.to)+s.sfx;
          if(p<1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      }, i*200+600);
    });
  }

  /* ── STATEMENT PIN + WORD REVEAL ────────────────────────────────────── */
  var words = qa('#stmt-h2 .w');
  gsap.set(words, {opacity:.15, color:'rgba(255,255,255,.15)'});

  gsap.timeline({
    scrollTrigger:{
      trigger:'#statement', start:'top top', end:'+=700', pin:true, scrub:1,
      pinSpacing:true,
    }
  }).to(words, {opacity:1, color:'rgba(255,255,255,1)', duration:.5, stagger:.12, ease:'none'});

  /* ── MÉTRICAS COUNTER ───────────────────────────────────────────────── */
  qa('.metric-card').forEach(function(card){
    var numEl = card.querySelector('.mc-num');
    var target = parseInt(card.dataset.val||'0',10);
    var suffix = card.dataset.sfx||'';
    var delay  = parseInt(card.dataset.di||'0',10)*0.15;

    gsap.set(card, {opacity:0, y:50, scale:.96});
    gsap.to(card, {
      opacity:1, y:0, scale:1, duration:.9, ease:'power3.out', delay:delay,
      scrollTrigger:{trigger:card, start:'top 85%', toggleActions:'play none none none',
        onEnter:function(){
          setTimeout(function(){
            if(!numEl) return;
            var start=null, dur=1800;
            function step(ts){
              if(!start) start=ts;
              var p=Math.min((ts-start)/dur,1), e=1-Math.pow(1-p,3);
              numEl.textContent=Math.round(e*target)+suffix;
              if(p<1) requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
          }, delay*1000+200);
        }
      }
    });
  });

  /* ── PROB CARDS HORIZONTAL PIN ──────────────────────────────────────── */
  var probTrack = q('#prob-track');
  var probFill  = q('#prob-fill');
  var probCards = qa('.prob-card');

  if(probTrack && probCards.length){
    var cardW   = 340 + 24; // width + gap
    var maxX    = (probCards.length - 2) * cardW;

    ScrollTrigger.create({
      trigger: '#prob-pin',
      start: 'top top',
      end: '+=' + (maxX + 400),
      pin: true,
      pinSpacing: true,
      scrub: 1,
      onUpdate: function(self){
        var x = -self.progress * maxX;
        gsap.set(probTrack, {x:x});
        if(probFill) probFill.style.width = (self.progress*100)+'%';

        // Card ativo
        var activeIdx = Math.round(-x / cardW);
        probCards.forEach(function(c,i){
          c.classList.toggle('active', i===activeIdx);
        });
      }
    });
  }

  /* ── REVEAL GENÉRICO ────────────────────────────────────────────────── */
  qa('.reveal-item').forEach(function(el){
    gsap.set(el, {opacity:0, y:50});
    gsap.to(el, {
      opacity:1, y:0, duration:1.0, ease:'power3.out',
      scrollTrigger:{trigger:el, start:'top 84%', toggleActions:'play none none none'}
    });
  });

  /* ── ENTIDADE CARDS ─────────────────────────────────────────────────── */
  var entNo=q('#ent-no'), entYes=q('#ent-yes');
  if(entNo && entYes){
    gsap.set(entNo,  {opacity:0, x:-80});
    gsap.set(entYes, {opacity:0, x:80});
    var est={trigger:'.entidade-section', start:'top 78%', toggleActions:'play none none none'};
    gsap.to(entNo,  {opacity:1,x:0,duration:1.0,ease:'power3.out',scrollTrigger:est});
    gsap.to(entYes, {opacity:1,x:0,duration:1.0,ease:'power3.out',delay:.15,scrollTrigger:est});
  }

  /* ── DIFF COLS ──────────────────────────────────────────────────────── */
  var dNo=q('#diff-no'), dYes=q('#diff-yes');
  if(dNo && dYes){
    gsap.set(dNo,  {opacity:0, x:-80});
    gsap.set(dYes, {opacity:0, x:80});
    var dst={trigger:'.diff-section', start:'top 78%', toggleActions:'play none none none'};
    gsap.to(dNo,  {opacity:1,x:0,duration:1.0,ease:'power3.out',scrollTrigger:dst});
    gsap.to(dYes, {opacity:1,x:0,duration:1.0,ease:'power3.out',delay:.2,scrollTrigger:dst});
  }

  /* ── PARALLAX HERO BG + ORB ─────────────────────────────────────────── */
  var heroBgImg = q('.hero-bg-img');
  if(heroBgImg){
    gsap.to(heroBgImg, {y:120, ease:'none',
      scrollTrigger:{trigger:'#hero', start:'top top', end:'bottom top', scrub:1}});
  }
  var orb1=q('.hero-orb-1'), orb2=q('.hero-orb-2');
  if(orb1){
    gsap.to(orb1, {y:-120, ease:'none',
      scrollTrigger:{trigger:'#hero', start:'top top', end:'bottom top', scrub:1}});
  }
  if(orb2){
    gsap.to(orb2, {y:-60, ease:'none',
      scrollTrigger:{trigger:'#hero', start:'top top', end:'bottom top', scrub:1.5}});
  }

  /* ── FAQ STAGGER ────────────────────────────────────────────────────── */
  var faqItems=qa('.faq-item');
  gsap.set(faqItems,{opacity:0,y:20});
  gsap.to(faqItems,{opacity:1,y:0,duration:.6,ease:'power3.out',stagger:.08,
    scrollTrigger:{trigger:'#faq-list',start:'top 85%',toggleActions:'play none none none'}});

} // end initCine

/* ─── ACCORDION ───────────────────────────────────────────────────────── */
function initAcc(){
  qa('.layer-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      var item  = btn.closest('.layer-item');
      var body  = item?item.querySelector('.layer-body'):null;
      var inner = body?body.querySelector('.layer-inner'):null;
      var arr   = btn.querySelector('.layer-arr');
      var open  = item&&item.classList.contains('open');

      qa('.layer-item').forEach(function(it){
        var b=it.querySelector('.layer-body');
        var a=it.querySelector('.layer-btn');
        var ar=it.querySelector('.layer-arr');
        it.classList.remove('open');
        if(a) a.setAttribute('aria-expanded','false');
        if(ar) ar.classList.remove('rotated');
        if(b){
          if(typeof gsap!=='undefined') gsap.to(b,{height:0,duration:.4,ease:'power2.inOut'});
          else b.style.height='0';
        }
      });

      if(!open && item && body && inner){
        item.classList.add('open');
        btn.setAttribute('aria-expanded','true');
        if(arr) arr.classList.add('rotated');
        if(typeof gsap!=='undefined'){
          body.style.height='0';
          gsap.to(body,{height:inner.scrollHeight,duration:.45,ease:'power2.out',
            onComplete:function(){ body.style.height='auto'; }});
        } else {
          body.style.height=inner.scrollHeight+'px';
        }
      }
    });
  });
}

/* ─── DORES ───────────────────────────────────────────────────────────── */
function initDores(){
  var dorData=[
    {q:'"Meu site aparece no Google mas não gera leads qualificados."',a:'Tráfego sem intenção de compra. A Camada 03 resolve: <strong>conteúdo que captura o ICP certo</strong> no momento exato da jornada de decisão.'},
    {q:'"Quando paro os anúncios, o pipeline seca."',a:'Dependência total de paid. O Método ORGANUM constrói <strong>um ativo orgânico que cresce sem custo incremental</strong> — permanentemente.'},
    {q:'"Meu concorrente aparece no ChatGPT. Eu não."',a:'GEO ausente. A Camada 04 posiciona sua marca como <strong>fonte confiável para as IAs generativas</strong> em 4 a 8 semanas.'},
    {q:'"Já investi em SEO antes e nunca funcionou."',a:'SEO genérico para B2B falha. O Método é diferente: <strong>5 camadas integradas com foco em pipeline</strong>, não em pageviews.'},
    {q:'"Minha empresa não é citada pelas IAs."',a:'Entidade digital ausente. A Camada 02 constrói <strong>sua presença verificável no Knowledge Graph</strong> — pré-requisito para citação por IA.'},
    {q:'"Quero crescer sem depender de tráfego pago."',a:'Esse é exatamente o perfil que servimos. <strong>Pipeline orgânico B2B previsível</strong> — sem anúncios, sem dependência de algoritmo.'},
  ];

  qa('.dor-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      var idx=parseInt(btn.dataset.i||'0',10);
      qa('.dor-btn').forEach(function(b){ b.classList.remove('active'); b.setAttribute('aria-expanded','false'); });
      btn.classList.add('active'); btn.setAttribute('aria-expanded','true');

      var panel=q('#dor-panel'), dpq=q('#dpq'), dpa=q('#dpa');
      if(panel){
        panel.style.opacity='0';
        setTimeout(function(){
          if(dpq) dpq.textContent=dorData[idx].q;
          if(dpa) dpa.innerHTML=dorData[idx].a;
          panel.style.transition='opacity .25s'; panel.style.opacity='1';
        },180);
      }
      qa('.dor-inline').forEach(function(el){ el.style.display='none'; el.setAttribute('aria-hidden','true'); });
      var inl=document.getElementById('dinl-'+idx);
      if(inl){ inl.style.display='block'; inl.setAttribute('aria-hidden','false'); }
    });
  });
}

/* ─── FAQ ─────────────────────────────────────────────────────────────── */
function initFAQ(){
  qa('.faq-item').forEach(function(d){
    var arr=d.querySelector('.faq-arr');
    d.addEventListener('toggle', function(){ if(arr) arr.textContent=d.open?'−':'+'; });
  });
}

/* ─── BOOT ────────────────────────────────────────────────────────────── */
hidePL(function(){
  initAcc();
  initDores();
  initFAQ();
  initCine();
});

})();
</script>

