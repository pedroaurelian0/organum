---
import Page from '@layouts/Page.astro';

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'O que é o Método ORGANUM?', acceptedAnswer: { '@type': 'Answer', text: 'Uma abordagem sistemática em 5 camadas: fundação técnica, identidade de entidade, conteúdo de autoridade, GEO + AEO e Digital PR.' } },
    { '@type': 'Question', name: 'Quanto tempo leva para ver resultados?', acceptedAnswer: { '@type': 'Answer', text: 'Resultados técnicos em 2–4 semanas. Crescimento de tráfego orgânico consistente em 3–6 meses. Citações por IAs em 4–8 semanas.' } },
    { '@type': 'Question', name: 'Para quem é a Organum?', acceptedAnswer: { '@type': 'Answer', text: 'Empresas B2B com faturamento acima de R$500k/ano que querem crescer sem depender de tráfego pago.' } },
    { '@type': 'Question', name: 'A Organum atende fora de Recife?', acceptedAnswer: { '@type': 'Answer', text: 'Sim. Atendemos todo o Brasil e internacionalmente — temos cases bilíngues PT/EN para operações nos EUA.' } },
    { '@type': 'Question', name: 'O que é GEO?', acceptedAnswer: { '@type': 'Answer', text: 'Generative Engine Optimization — otimização para ser citado por ChatGPT, Gemini e Perplexity.' } },
    { '@type': 'Question', name: 'Qual a diferença entre SEO B2B e SEO tradicional?', acceptedAnswer: { '@type': 'Answer', text: 'SEO B2B foca em pipeline, não em tráfego. O sucesso se mede em leads qualificados — não em pageviews.' } },
  ],
};
const websiteSchema = {
  '@type': 'WebSite',
  '@id': 'https://organum.com.br/#website',
  url: 'https://organum.com.br',
  name: 'Organum',
  publisher: { '@type': 'Organization', '@id': 'https://organum.com.br/#organization' },
  inLanguage: 'pt-BR',
};
---

<Page
  title="Agência de SEO orgânico B2B | Método ORGANUM — Recife | Organum"
  description="Transformamos empresas B2B em autoridades no Google e nas IAs generativas com o Método ORGANUM — 5 camadas que geram pipeline comercial sem tráfego pago."
  canonical="https://organum.com.br/"
  ogType="website"
  schemaExtra={[websiteSchema, faqSchema]}
>

<!-- ══════════════════════════════════════════════════════════
     CURSOR PERSONALIZADO
     ══════════════════════════════════════════════════════════ -->
<div id="cur-dot"  aria-hidden="true"></div>
<div id="cur-ring" aria-hidden="true"></div>

<!-- ══════════════════════════════════════════════════════════
     PRÉ-LOADER
     ══════════════════════════════════════════════════════════ -->
<div id="preloader" aria-hidden="true">
  <div id="pl-particles"></div>
  <div id="pl-center">
    <span id="pl-logo">Organum</span>
    <div id="pl-bar-wrap"><div id="pl-bar"></div></div>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════════
     HERO — fullscreen
     ══════════════════════════════════════════════════════════ -->
<section class="hero" id="hero">
  <!-- Fundo -->
  <div class="hero-bg" aria-hidden="true">
    <img src="/images/hero-bg.jpg" alt="" class="hero-bg-img" aria-hidden="true" loading="eager" decoding="async"/>
    <div class="hero-bg-overlay" aria-hidden="true"></div>
    <div class="hero-noise" aria-hidden="true"></div>
    <div class="hero-orb hero-orb-1" aria-hidden="true"></div>
    <div class="hero-orb hero-orb-2" aria-hidden="true"></div>
    <div class="hero-grid" aria-hidden="true"></div>
  </div>
  <!-- Partículas -->
  <div class="particles" id="particles" aria-hidden="true">
    {Array.from({length:40}).map((_,i) => <div class="particle" style={`--i:${i}`}></div>)}
  </div>

  <div class="wrap hero-inner">
    <!-- Copy -->
    <div class="hero-copy">
      <div class="hero-badge" id="h-badge">
        <span class="badge-dot" aria-hidden="true"></span>
        GEO sistematizado no Brasil — primeiro e único
      </div>

      <h1 class="hero-h1" id="hero-h1">
        <span class="h1-l" id="hl1">SEO orgânico</span>
        <span class="h1-l" id="hl2">que gera</span>
        <span class="h1-l h1-gradient" id="hl3">pipeline B2B</span>
        <span class="h1-l h1-em" id="hl4"><em>não apenas cliques</em></span>
      </h1>

      <p class="hero-sub" id="h-sub">
        Do zero técnico à citação por IA. Sem anúncios.<br>
        Sem dependência de algoritmo.
      </p>

      <div class="hero-ctas" id="h-ctas">
        <a href="/auditoria-gratuita" class="btn-glow" id="cta-main">
          <span>Solicitar auditoria gratuita</span>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="/metodo" class="btn-glass" id="cta-sec">Ver o método</a>
      </div>

      <div class="hero-social-proof" id="h-proof">
        <div class="proof-avatars">
          <span class="proof-av" style="background:#2e9147">P</span>
          <span class="proof-av" style="background:#1d7a35">H</span>
          <span class="proof-av" style="background:#0d3f1a">7</span>
        </div>
        <p class="proof-text">+12 empresas B2B crescendo organicamente</p>
      </div>
    </div>

    <!-- Visual -->
    <div class="hero-visual" id="hero-visual">
      <!-- Dashboard glassmorphism -->
      <div class="hero-dashboard" id="hero-dashboard">
        <div class="dash-header">
          <div class="dash-dots">
            <span style="background:#ff5f57"></span>
            <span style="background:#febc2e"></span>
            <span style="background:#28c840"></span>
          </div>
          <span class="dash-title">Pipeline orgânico — 12 meses</span>
        </div>
        <div class="dash-body">
          <svg id="hero-chart" viewBox="0 0 440 260" fill="none" aria-label="Gráfico de crescimento orgânico vs tráfego pago">
            <!-- Grid -->
            <line x1="40" y1="20"  x2="420" y2="20"  stroke="rgba(255,255,255,.04)" stroke-width="1"/>
            <line x1="40" y1="75"  x2="420" y2="75"  stroke="rgba(255,255,255,.04)" stroke-width="1"/>
            <line x1="40" y1="130" x2="420" y2="130" stroke="rgba(255,255,255,.04)" stroke-width="1"/>
            <line x1="40" y1="185" x2="420" y2="185" stroke="rgba(255,255,255,.04)" stroke-width="1"/>
            <line x1="40" y1="230" x2="420" y2="230" stroke="rgba(255,255,255,.06)" stroke-width="1"/>
            <line x1="40" y1="20"  x2="40"  y2="230" stroke="rgba(255,255,255,.06)" stroke-width="1"/>
            <!-- Labels X -->
            <text x="40"  y="246" fill="rgba(255,255,255,.2)" font-size="8" text-anchor="middle" font-family="DM Sans,sans-serif">0</text>
            <text x="136" y="246" fill="rgba(255,255,255,.2)" font-size="8" text-anchor="middle" font-family="DM Sans,sans-serif">3m</text>
            <text x="232" y="246" fill="rgba(255,255,255,.2)" font-size="8" text-anchor="middle" font-family="DM Sans,sans-serif">6m</text>
            <text x="328" y="246" fill="rgba(255,255,255,.2)" font-size="8" text-anchor="middle" font-family="DM Sans,sans-serif">9m</text>
            <text x="420" y="246" fill="rgba(255,255,255,.2)" font-size="8" text-anchor="middle" font-family="DM Sans,sans-serif">12m</text>
            <!-- Área pago -->
            <path id="c-paid-area" d="M40,226 C80,212 105,175 136,152 C159,136 169,149 189,175 C211,204 234,222 270,228 L420,230 Z" fill="rgba(220,80,60,.06)" opacity="0"/>
            <!-- Linha pago -->
            <path id="c-paid-line" d="M40,226 C80,212 105,175 136,152 C159,136 169,149 189,175 C211,204 234,222 270,228 L420,230" fill="none" stroke="rgba(200,90,70,.45)" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="750" stroke-dashoffset="750"/>
            <!-- Área orgânico -->
            <path id="c-org-area" d="M40,229 C80,227 120,220 165,207 C208,194 255,174 298,146 C343,117 383,82 420,45 L420,230 Z" fill="url(#orgGrad)" opacity="0"/>
            <!-- Linha orgânico -->
            <path id="c-org-line" d="M40,229 C80,227 120,220 165,207 C208,194 255,174 298,146 C343,117 383,82 420,45" fill="none" stroke="#4caf64" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="850" stroke-dashoffset="850"/>
            <!-- Ponto final -->
            <circle id="c-dot"  cx="420" cy="45" r="5"  fill="#4caf64" opacity="0"/>
            <circle id="c-ring" cx="420" cy="45" r="10" fill="none" stroke="rgba(76,175,100,.3)" stroke-width="1.5" opacity="0"/>
            <!-- Label orgânico -->
            <g id="c-lbl" opacity="0">
              <rect x="300" y="26" width="116" height="20" rx="4" fill="rgba(76,175,100,.12)" stroke="rgba(76,175,100,.3)" stroke-width="1"/>
              <text x="308" y="40" fill="#4caf64" font-size="8.5" font-weight="600" font-family="DM Sans,sans-serif">SEO orgânico ↑ 340%</text>
            </g>
            <!-- Label pago -->
            <g id="c-lbl2" opacity="0">
              <rect x="100" y="133" width="112" height="20" rx="4" fill="rgba(220,80,60,.08)" stroke="rgba(200,80,60,.2)" stroke-width="1"/>
              <text x="108" y="147" fill="rgba(210,110,90,1)" font-size="8.5" font-weight="600" font-family="DM Sans,sans-serif">Tráfego pago — cessa</text>
            </g>
            <defs>
              <linearGradient id="orgGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="rgba(76,175,100,.2)"/>
                <stop offset="100%" stop-color="rgba(76,175,100,.0)"/>
              </linearGradient>
            </defs>
          </svg>
          <!-- Stats row -->
          <div class="dash-stats">
            <div class="dash-stat">
              <span class="ds-val" id="ds1">0%</span>
              <span class="ds-lbl">Crescimento</span>
            </div>
            <div class="dash-stat-sep" aria-hidden="true"></div>
            <div class="dash-stat">
              <span class="ds-val" id="ds2">0d</span>
              <span class="ds-lbl">Para citação IA</span>
            </div>
            <div class="dash-stat-sep" aria-hidden="true"></div>
            <div class="dash-stat">
              <span class="ds-val" id="ds3">0+</span>
              <span class="ds-lbl">Posições top 3</span>
            </div>
          </div>
        </div>
      </div>
      <!-- Floating badge -->
      <div class="float-badge" id="float-badge">
        <span class="fb-icon" aria-hidden="true">✓</span>
        <span>Citado pelo ChatGPT em 90 dias</span>
      </div>
    </div>
  </div>

  <!-- Ticker strip -->
  <div class="hero-ticker" aria-label="Empresas que confiam no método">
    <div class="ticker-inner">
      <span class="ticker-label">Confiam no método</span>
      <div class="ticker-line" aria-hidden="true"></div>
      <div class="ticker-wrap">
        <div class="ticker-track t-track-1">
          {['HunterHunter','7+ Vacations','Global Electronics','Sax Trading','Prime Vacations',
            'HunterHunter','7+ Vacations','Global Electronics','Sax Trading','Prime Vacations'].map(n=>(
            <span class="ticker-item">{n}</span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════════════════
     SEÇÃO 2 — STATEMENT PIN (word reveal)
     ══════════════════════════════════════════════════════════ -->
<section class="statement-section" id="statement">
  <div class="statement-pin" id="statement-pin">
    <div class="wrap">
      <p class="stmt-eyebrow">POR QUE A ORGANUM</p>
      <h2 class="stmt-h2" id="stmt-h2" aria-label="Nenhuma agência brasileira entrega GEO sistematicamente. Nós entregamos — e provamos com dados.">
        <span class="w">Nenhuma</span>
        <span class="w">agência</span>
        <span class="w">brasileira</span>
        <span class="w">entrega</span>
        <span class="w wg">GEO</span>
        <span class="w wg">sistematicamente.</span>
        <br>
        <span class="w">Nós</span>
        <span class="w">entregamos</span>
        <span class="w">—</span>
        <span class="w">e</span>
        <span class="w">provamos</span>
        <span class="w">com</span>
        <span class="w wg">dados.</span>
      </h2>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════════════════
     SEÇÃO 3 — MÉTRICAS (glassmorphism cards)
     ══════════════════════════════════════════════════════════ -->
<section class="metrics-section" id="metrics">
  <div class="wrap metrics-grid">
    {[
      { val:5,   sfx:'',  lbl:'Camadas do método',    icon:'⬡', id:'m0' },
      { val:90,  sfx:'d', lbl:'Para citação por IA',  icon:'◎', id:'m1' },
      { val:340, sfx:'%', lbl:'Crescimento orgânico', icon:'↑', id:'m2' },
      { val:48,  sfx:'h', lbl:'Para o diagnóstico',   icon:'◷', id:'m3' },
    ].map((m,i) => (
      <div class="metric-card glass-card" id={m.id} data-val={m.val} data-sfx={m.sfx} data-di={i}>
        <span class="mc-icon" aria-hidden="true">{m.icon}</span>
        <span class="mc-num">{m.val}{m.sfx}</span>
        <span class="mc-lbl">{m.lbl}</span>
        <div class="mc-glow" aria-hidden="true"></div>
      </div>
    ))}
  </div>
</section>

<!-- ══════════════════════════════════════════════════════════
     SEÇÃO 4 — PROBLEMA (cards horizontais com pin)
     ══════════════════════════════════════════════════════════ -->
<section class="prob-section" id="problema">
  <div class="prob-pin" id="prob-pin">
    <div class="wrap">
      <div class="prob-hd">
        <p class="eyebrow dark">O PROBLEMA QUE VOCÊ TEM</p>
        <h2 class="section-h2">Você investe em anúncios e para de<br>crescer quando para de pagar.</h2>
      </div>
    </div>
    <div class="prob-slider-wrap">
      <div class="prob-track" id="prob-track">
        {[
          { icon:'📈', title:'Tráfego pago não escala sem orçamento', stat:'+340% no CAC em 3 anos',
            desc:'Cada real gasto em anúncios tem retorno decrescente. O canal que gera hoje exige mais amanhã.' },
          { icon:'🤖', title:'Seu site não existe para as IAs generativas', stat:'73% das pesquisas B2B usam IA',
            desc:'ChatGPT, Gemini e Perplexity não recomendam empresas que não são entidades verificáveis.' },
          { icon:'🔍', title:'SEO genérico não funciona para B2B', stat:'89% dos leads B2B pesquisam antes',
            desc:'SEO de pageviews não gera pipeline. Você precisa de conteúdo calibrado para o ICP correto.' },
          { icon:'🏛️', title:'Sua empresa não é uma entidade reconhecida', stat:'Entidade = credibilidade automática',
            desc:'Sem Knowledge Graph, Wikidata e sameAs cruzados, o Google e as IAs ignoram sua marca.' },
          { icon:'⚡', title:'Concorrentes aparecem primeiro nas buscas estratégicas', stat:'78% das decisões B2B começam no Google',
            desc:'Posições estratégicas nos momentos de intenção de compra determinam quem fecha o contrato.' },
          { icon:'🌱', title:'Seu pipeline depende de indicações e rede', stat:'CAC orgânico cai 70% em 12 meses',
            desc:'Indicações não escalam. O orgânico cresce enquanto você dorme — e não para quando você para.' },
        ].map((c,i) => (
          <div class="prob-card glass-card" data-card={i}>
            <div class="pc-top">
              <span class="pc-icon" aria-hidden="true">{c.icon}</span>
              <span class="pc-num">{String(i+1).padStart(2,'0')}</span>
            </div>
            <h3 class="pc-title">{c.title}</h3>
            <p class="pc-stat">{c.stat}</p>
            <p class="pc-desc">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
    <div class="prob-progress-wrap" aria-hidden="true">
      <div class="prob-progress-bar"><div class="prob-progress-fill" id="prob-fill"></div></div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════════════════
     SEÇÃO 5 — IDENTIDADE DE ENTIDADE
     ══════════════════════════════════════════════════════════ -->
<section class="entidade-section" id="entidade">
  <div class="wrap">
    <div class="section-hd reveal-item">
      <p class="eyebrow">IDENTIDADE DE ENTIDADE</p>
      <h2 class="section-h2 white">O que as IAs precisam para<br>te recomendar</h2>
    </div>
    <div class="entidade-grid">
      <!-- Sem entidade -->
      <div class="ent-card ent-no glass-card reveal-item" id="ent-no">
        <div class="ent-hd">
          <div class="ent-badge ent-badge-red">✕ Sem entidade</div>
        </div>
        <ul class="ent-list">
          {['Sem página na Wikipedia','Sem item no Wikidata','Sem Knowledge Panel','Sem sameAs cruzados','Invisível para ChatGPT e Gemini','Dependente de anúncios para existir'].map(item=>(
            <li class="ent-item ent-item-no">
              <span class="ent-x" aria-hidden="true">✕</span>{item}
            </li>
          ))}
        </ul>
      </div>
      <!-- Com Organum -->
      <div class="ent-card ent-yes glass-card reveal-item" id="ent-yes">
        <div class="ent-hd">
          <div class="ent-badge ent-badge-green">✓ Com Organum</div>
        </div>
        <ul class="ent-list">
          {['Presença verificável no Wikidata','Knowledge Graph ativo','sameAs cruzados LinkedIn + G.Business','Menções editoriais qualificadas','Citada por ChatGPT, Gemini, Perplexity','Pipeline orgânico crescente sem anúncios'].map(item=>(
            <li class="ent-item ent-item-yes">
              <span class="ent-ok" aria-hidden="true">✓</span>{item}
            </li>
          ))}
        </ul>
      </div>
    </div>
    <!-- IA ticker -->
    <div class="ia-ticker reveal-item">
      <span class="ia-lbl">Citada pelas IAs</span>
      <div class="ia-track-wrap">
        <div class="ia-track">
          {['ChatGPT','Gemini','Perplexity','Copilot','Grok','ChatGPT','Gemini','Perplexity','Copilot','Grok'].map(ia=>(
            <span class="ia-item">{ia}</span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════════════════
     SEÇÃO 6 — MÉTODO 5 CAMADAS
     ══════════════════════════════════════════════════════════ -->
<section class="metodo-section" id="metodo">
  <div class="wrap">
    <div class="section-hd reveal-item">
      <p class="eyebrow dark">O MÉTODO</p>
      <h2 class="section-h2">5 camadas. A ordem importa.</h2>
    </div>
    <div class="layers-wrap" id="layers-wrap">
      {[
        { num:'01', name:'Fundação técnica',       sub:'Core Web Vitals · Silos · Schema Markup',           tag:'Base obrigatória', tc:'tg-base',
          txt:'Core Web Vitals perfeitos, arquitetura de silos semânticos, crawl budget otimizado e Schema Markup completo em JSON-LD. <strong>Sem fundação técnica, as outras 4 camadas não funcionam.</strong>' },
        { num:'02', name:'Identidade de entidade', sub:'Knowledge Graph · Wikidata · sameAs',               tag:'Diferencial Organum', tc:'tg-diff',
          txt:'Construímos sua empresa como <strong>entidade verificável pelo Google e pelas IAs</strong>: Knowledge Graph, Wikidata, LinkedIn estruturado. Sem isso, o ChatGPT não te recomenda.' },
        { num:'03', name:'Conteúdo de autoridade', sub:'Clusters por ICP · E-E-A-T profundo',               tag:'Fonte para IA', tc:'tg-geo',
          txt:'Artigos de 2.000+ palavras em clusters semânticos por ICP. <strong>E-E-A-T profundo</strong> documentado. Conteúdo que serve como fonte primária para IAs generativas.' },
        { num:'04', name:'GEO + AEO',              sub:'ChatGPT · Gemini · Perplexity · Featured Snippets', tag:'Ninguém entrega isso', tc:'tg-geo',
          txt:'<strong>Generative Engine Optimization</strong>: otimização para ser citado por ChatGPT, Gemini, Perplexity, Copilot e Grok. Nenhuma agência brasileira entrega isso sistematicamente.' },
        { num:'05', name:'Digital PR',             sub:'Link building editorial · Assessoria digital',      tag:'Autoridade externa', tc:'tg-base',
          txt:'Link building editorial em portais de nicho B2B. <strong>Domain Authority crescente mês a mês.</strong> Cada menção reforça a entidade e alimenta as Camadas 02 e 04.' },
      ].map((l,i) => (
        <div class="layer-item reveal-item" id={`layer-${i}`}>
          <button class="layer-btn" data-idx={i} aria-expanded="false" aria-controls={`lb-${i}`}>
            <span class="layer-num">{l.num}</span>
            <span class="layer-info">
              <span class="layer-name">{l.name}</span>
              <span class="layer-sub">{l.sub}</span>
            </span>
            <span class={`layer-tag ${l.tc}`}>{l.tag}</span>
            <span class="layer-arr" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M5 7.5l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </button>
          <div class="layer-body" id={`lb-${i}`} style="height:0;overflow:hidden;">
            <div class="layer-inner" set:html={l.txt}/>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════════════════
     SEÇÃO 7 — DIFERENCIAL
     ══════════════════════════════════════════════════════════ -->
<section class="diff-section" id="diferencial">
  <div class="wrap">
    <div class="section-hd reveal-item">
      <p class="eyebrow">COMPARATIVO</p>
      <h2 class="section-h2 white">O que nenhuma outra agência entrega<br>— e nós entregamos.</h2>
    </div>
    <div class="diff-grid">
      <div class="diff-col diff-no glass-card reveal-item" id="diff-no">
        <div class="diff-col-hd">
          <span class="diff-x" aria-hidden="true">✕</span>
          <span class="diff-title">Agência genérica</span>
        </div>
        <ul class="diff-list">
          {['SEO técnico básico sem estratégia','Conteúdo genérico sem ICP definido','Relatórios de pageviews, não de pipeline','Ignora GEO e citação por IA','Não constrói identidade de entidade','Sem Digital PR editorial','Resultados param quando você para de pagar'].map(t=>(
            <li class="di di-no"><span aria-hidden="true">✕</span>{t}</li>
          ))}
        </ul>
      </div>
      <div class="diff-col diff-yes glass-card reveal-item" id="diff-yes">
        <div class="diff-col-hd">
          <span class="diff-ok" aria-hidden="true">✓</span>
          <span class="diff-title green-title">Organum</span>
        </div>
        <ul class="diff-list">
