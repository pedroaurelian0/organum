---
import Page from '@layouts/Page.astro';

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'O que é o Método ORGANUM?', acceptedAnswer: { '@type': 'Answer', text: 'Uma abordagem sistemática em 5 camadas: fundação técnica, identidade de entidade, conteúdo de autoridade, GEO + AEO e Digital PR. Juntas, transformam empresas B2B em autoridades reconhecidas pelo Google e pelas IAs generativas.' } },
    { '@type': 'Question', name: 'Quanto tempo leva para ver resultados?', acceptedAnswer: { '@type': 'Answer', text: 'Resultados técnicos em 2–4 semanas. Crescimento de tráfego orgânico consistente em 3–6 meses. Citações por IAs em 4–8 semanas para marcas com presença digital mínima.' } },
    { '@type': 'Question', name: 'Para quem é a Organum?', acceptedAnswer: { '@type': 'Answer', text: 'Empresas B2B (consultoria, SaaS, distribuidora, indústria) e e-commerce com faturamento acima de R$500k/ano que querem crescer sem depender de tráfego pago.' } },
    { '@type': 'Question', name: 'A Organum atende fora de Recife?', acceptedAnswer: { '@type': 'Answer', text: 'Sim. Atendemos todo o Brasil e internacionalmente — temos cases bilíngues PT/EN para operações nos EUA.' } },
  ],
};

const websiteSchema = {
  '@type': 'WebSite',
  '@id': 'https://organum.com.br/#website',
  url: 'https://organum.com.br',
  name: 'Organum',
  publisher: { '@type': 'Organization', '@id': 'https://organum.com.br/#organization' },
  inLanguage: 'pt-BR',
};

const dores = [
  { q: '"Meu site aparece no Google mas não gera leads qualificados."', a: 'Tráfego sem intenção de compra. A Camada 03 resolve: <strong>conteúdo que captura o ICP certo</strong> no momento exato da jornada de decisão.' },
  { q: '"Quando paro os anúncios, o pipeline seca."', a: 'Dependência total de paid. O Método ORGANUM constrói <strong>um ativo orgânico que cresce sem custo incremental</strong> mês a mês — permanentemente.' },
  { q: '"Meu concorrente aparece no ChatGPT. Eu não."', a: 'GEO ausente. A Camada 04 posiciona sua marca como <strong>fonte confiável para as IAs generativas</strong> em 4 a 8 semanas.' },
  { q: '"Já investi em SEO antes e nunca funcionou."', a: 'SEO genérico para B2B falha. O Método é diferente: <strong>5 camadas integradas com foco em pipeline</strong>, não em pageviews ou posições.' },
  { q: '"Minha empresa não é citada pelas IAs."', a: 'Entidade digital ausente. A Camada 02 constrói <strong>sua presença verificável no Knowledge Graph</strong> — pré-requisito para citação por IA.' },
  { q: '"Quero crescer sem depender de tráfego pago."', a: 'Esse é exatamente o perfil que o Método ORGANUM serve. <strong>Pipeline orgânico B2B previsível</strong> — sem anúncios, sem dependência de algoritmo.' },
];

const layers = [
  {
    num: '01', name: 'Fundação técnica', sub: 'Core Web Vitals, silos, Schema Markup', tag: 'ltag-base', tagLabel: 'Base obrigatória',
    text: 'Core Web Vitals perfeitos, arquitetura de silos semânticos, crawl budget otimizado e Schema Markup completo em JSON-LD. <strong>Sem fundação técnica, as outras 4 camadas não funcionam.</strong> É o pré-requisito que a maioria das agências ignora.',
    animId: 'anim-01'
  },
  {
    num: '02', name: 'Identidade de entidade', sub: 'Knowledge Graph, Wikidata, sameAs cruzados', tag: 'ltag-diff', tagLabel: 'Diferencial Organum',
    text: 'Construímos sua empresa como <strong>entidade verificável pelo Google e pelas IAs</strong>: Knowledge Graph, Wikidata, LinkedIn estruturado, menções cruzadas. Sem isso, o ChatGPT não te recomenda — independente do seu conteúdo.',
    animId: 'anim-02'
  },
  {
    num: '03', name: 'Conteúdo de autoridade', sub: 'Clusters semânticos por ICP, E-E-A-T profundo', tag: 'ltag-base', tagLabel: 'Fonte para IA',
    text: 'Artigos de 2.000+ palavras organizados em clusters semânticos por ICP. <strong>E-E-A-T profundo</strong> — experiência, expertise, autoridade e confiabilidade documentadas. Conteúdo que serve como fonte primária para IAs generativas.',
    animId: 'anim-03'
  },
  {
    num: '04', name: 'GEO + AEO', sub: 'ChatGPT, Gemini, Perplexity, featured snippets', tag: 'ltag-geo', tagLabel: 'Ninguém entrega isso',
    text: '<strong>Generative Engine Optimization</strong>: otimização para ser citado por ChatGPT, Gemini, Perplexity, Copilot e Grok. Answer Engine Optimization para featured snippets e busca por voz. Camada que nenhuma agência brasileira entrega sistematicamente.',
    animId: 'anim-04'
  },
  {
    num: '05', name: 'Digital PR', sub: 'Link building editorial, assessoria de imprensa digital', tag: 'ltag-base', tagLabel: 'Autoridade externa',
    text: 'Link building editorial de qualidade em portais de nicho B2B. Assessoria de imprensa digital. <strong>Domain Authority crescente mês a mês.</strong> Cada menção externa reforça a entidade e alimenta as Camadas 02 e 04.',
    animId: 'anim-05'
  },
];

const icps = [
  { icon: '◈', title: 'E-commerce', range: 'R$500k – R$30M/ano', ticket: 'R$3.500 – R$9.000/mês', desc: 'Categoria, produto e blog otimizados para capturar demanda orgânica nos momentos de compra.' },
  { icon: '◉', title: 'B2B: consultoria, SaaS, indústria', range: 'R$250k – R$2M/mês', ticket: 'R$5.000 – R$8.000/mês', desc: 'Pipeline orgânico para ciclos de venda longos com múltiplos decisores.' },
  { icon: '◎', title: 'Operação internacional', range: 'Qualquer porte', ticket: 'Sob consulta', desc: 'SEO bilíngue PT/EN. Autoridade de entidade em múltiplas regiões e idiomas.' },
];

const faqs = [
  { q: 'O que é o Método ORGANUM?', a: 'Uma abordagem em 5 camadas — fundação técnica, identidade de entidade, conteúdo, GEO/AEO e Digital PR — que transforma empresas B2B em autoridades no Google e nas IAs.' },
  { q: 'Quanto tempo leva para ver resultado?', a: 'Resultados técnicos em 2–4 semanas. Tráfego orgânico consistente em 3–6 meses. Citações por IAs em 4–8 semanas para marcas com presença digital mínima.' },
  { q: 'Para quem é a Organum?', a: 'Empresas B2B (consultoria, SaaS, distribuidora, indústria) e e-commerce acima de R$500k/ano que querem crescer sem depender de tráfego pago.' },
  { q: 'Vocês atendem fora de Recife?', a: 'Sim. Atendemos todo o Brasil e internacionalmente — temos cases bilíngues PT/EN para operações nos EUA.' },
  { q: 'O que é GEO — Generative Engine Optimization?', a: 'É a otimização para ser citado pelas IAs generativas como ChatGPT, Gemini e Perplexity. Diferente do SEO tradicional, o objetivo não é apenas ranquear no Google — é ser a resposta que as IAs entregam.' },
  { q: 'Qual a diferença entre SEO B2B e SEO tradicional?', a: 'SEO B2B foca em pipeline, não em tráfego. Ciclos de compra longos, múltiplos decisores, keywords de intenção comercial alta. O sucesso se mede em leads qualificados e oportunidades geradas — não em pageviews.' },
];
---

<Page
  title="Agência de SEO orgânico B2B | Método ORGANUM — Recife"
  description="Transformamos empresas B2B em autoridades no Google e nas IAs com o Método ORGANUM — as 5 camadas que geram pipeline comercial sem tráfego pago."
  ogType="website"
  schemaExtra={[websiteSchema, faqSchema]}
>

<!-- ══════════ HERO ══════════ -->
<section class="hero">
  <div class="hero-grid-bg"></div>
  <div class="hero-content">
    <div>
      <p class="hero-eye anim-fade-up d1">Método ORGANUM — 5 camadas comprovadas</p>
      <h1 class="hero-title anim-fade-up d2">
        SEO orgânico<br/>
        que gera<br/>
        pipeline B2B —<br/>
        <em>não apenas cliques</em>
      </h1>
      <p class="hero-sub anim-fade-up d3">Do zero técnico à citação por IA. Sem anúncios. Sem dependência de algoritmo de mídia social.</p>
      <div class="hero-actions anim-fade-up d4">
        <a href="/auditoria-gratuita" class="btn btn-green" style="padding:.875rem 2rem;font-size:.875rem;">Solicitar auditoria gratuita</a>
        <a href="/metodo" class="btn btn-outline" style="padding:.875rem 2rem;font-size:.875rem;border-color:rgba(255,255,255,.18);color:rgba(255,255,255,.55);">Ver o método →</a>
      </div>
    </div>

    <!-- Gráfico SVG animado -->
    <div class="anim-fade-in d5">
      <svg id="hero-chart" viewBox="0 0 480 320" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:100%;max-width:520px;" aria-label="Gráfico: pipeline orgânico cresce 127% enquanto tráfego pago cessa ao longo de 12 meses">
        <!-- Grid -->
        <line x1="48" y1="30" x2="460" y2="30" stroke="rgba(255,255,255,.05)" stroke-width="1"/>
        <line x1="48" y1="85" x2="460" y2="85" stroke="rgba(255,255,255,.05)" stroke-width="1"/>
        <line x1="48" y1="140" x2="460" y2="140" stroke="rgba(255,255,255,.05)" stroke-width="1"/>
        <line x1="48" y1="195" x2="460" y2="195" stroke="rgba(255,255,255,.05)" stroke-width="1"/>
        <line x1="48" y1="250" x2="460" y2="250" stroke="rgba(255,255,255,.08)" stroke-width="1"/>
        <line x1="48" y1="30" x2="48" y2="250" stroke="rgba(255,255,255,.08)" stroke-width="1"/>
        <!-- X labels -->
        <text x="48" y="268" fill="rgba(255,255,255,.25)" font-size="9" text-anchor="middle" font-family="DM Sans,sans-serif">Mês 0</text>
        <text x="152" y="268" fill="rgba(255,255,255,.25)" font-size="9" text-anchor="middle" font-family="DM Sans,sans-serif">Mês 3</text>
        <text x="256" y="268" fill="rgba(255,255,255,.25)" font-size="9" text-anchor="middle" font-family="DM Sans,sans-serif">Mês 6</text>
        <text x="360" y="268" fill="rgba(255,255,255,.25)" font-size="9" text-anchor="middle" font-family="DM Sans,sans-serif">Mês 9</text>
        <text x="460" y="268" fill="rgba(255,255,255,.25)" font-size="9" text-anchor="middle" font-family="DM Sans,sans-serif">Mês 12</text>
        <!-- Y labels -->
        <text x="40" y="254" fill="rgba(255,255,255,.2)" font-size="8" text-anchor="end" font-family="DM Sans,sans-serif">0</text>
        <text x="40" y="144" fill="rgba(255,255,255,.2)" font-size="8" text-anchor="end" font-family="DM Sans,sans-serif">50</text>
        <text x="40" y="34" fill="rgba(255,255,255,.2)" font-size="8" text-anchor="end" font-family="DM Sans,sans-serif">100</text>
        <!-- Título -->
        <text x="48" y="18" fill="rgba(255,255,255,.25)" font-size="8" font-weight="600" letter-spacing="1" font-family="DM Sans,sans-serif">PIPELINE ORGÂNICO vs. TRÁFEGO PAGO — 12 MESES</text>
        <!-- Área pago (cai) -->
        <path id="chart-paid-area" d="M48,246 C90,232 115,185 152,158 C175,140 185,155 205,185 C228,218 252,240 290,248 L460,250 Z" fill="rgba(220,80,60,.07)" opacity="0"/>
        <!-- Linha pago -->
        <path id="chart-paid-line" d="M48,246 C90,232 115,185 152,158 C175,140 185,155 205,185 C228,218 252,240 290,248 L460,250" fill="none" stroke="rgba(200,90,70,.5)" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="800" stroke-dashoffset="800"/>
        <!-- Área orgânico (cresce) -->
        <path id="chart-org-area" d="M48,249 C90,247 135,240 185,226 C230,213 278,190 322,160 C368,128 415,90 460,52 L460,250 Z" fill="rgba(46,145,71,.12)" opacity="0"/>
        <!-- Linha orgânico -->
        <path id="chart-org-line" d="M48,249 C90,247 135,240 185,226 C230,213 278,190 322,160 C368,128 415,90 460,52" fill="none" stroke="#4caf64" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="900" stroke-dashoffset="900"/>
        <!-- Dot final -->
        <circle id="chart-dot" cx="460" cy="52" r="5" fill="#4caf64" opacity="0"/>
        <circle id="chart-ring" cx="460" cy="52" r="10" fill="none" stroke="rgba(76,175,100,.35)" stroke-width="1.5" opacity="0"/>
        <!-- Labels -->
        <g id="chart-label-org" opacity="0">
          <rect x="340" y="34" width="116" height="20" rx="2" fill="rgba(76,175,100,.12)" stroke="rgba(76,175,100,.35)" stroke-width="1"/>
          <text x="348" y="48" fill="#4caf64" font-size="9" font-weight="600" font-family="DM Sans,sans-serif">SEO orgânico ↑ 127%</text>
        </g>
        <g id="chart-label-paid" opacity="0">
          <rect x="120" y="141" width="108" height="20" rx="2" fill="rgba(220,80,60,.1)" stroke="rgba(200,80,60,.25)" stroke-width="1"/>
          <text x="128" y="155" fill="rgba(210,120,100,1)" font-size="9" font-weight="600" font-family="DM Sans,sans-serif">Tráfego pago — cessa</text>
        </g>
      </svg>
    </div>
  </div>

  <div class="hero-ticker">
    <div class="ticker-inner">
      <span class="ticker-lbl">Confiam no método</span>
      {['HunterHunter', '7+ Vacations', 'Global Electronics', 'Nexxo Digital'].map(n => (
        <span class="ticker-name">{n}</span>
      ))}
    </div>
  </div>
</section>

<!-- ══════════ MÉTRICAS ══════════ -->
<div class="metrics-strip">
  <div class="metrics-grid wrap">
    {[
      { num: 5,   suffix: '',  label: 'Camadas do método' },
      { num: 90,  suffix: 'd', label: 'Para citação por IA' },
      { num: 340, suffix: '%', label: 'Crescimento orgânico' },
      { num: 48,  suffix: 'h', label: 'Para o diagnóstico' },
    ].map((m, i) => (
      <div class={`metric-item reveal reveal-d${i+1}`}>
        <span class="metric-num" data-target={m.num} data-suffix={m.suffix}>{m.num}{m.suffix}</span>
        <span class="metric-label">{m.label}</span>
      </div>
    ))}
  </div>
</div>

<!-- ══════════ STATEMENT ══════════ -->
<section class="section">
  <div class="wrap-md">
    <div class="statement-grid reveal">
      <div>
        <div style="width:2px;height:48px;background:var(--g500);margin-bottom:1.5rem;"></div>
        <p class="sec-eye" style="margin-bottom:0;">Por que a Organum</p>
      </div>
      <p class="statement">Nenhuma agência brasileira entrega <em>GEO sistematicamente.</em> Nós entregamos — e provamos com dados.</p>
    </div>
  </div>
</section>

<!-- ══════════ DORES DO LEAD ══════════ -->
<section class="section section-alt">
  <div class="wrap">
    <p class="sec-eye reveal">O problema que você tem</p>
    <h2 class="reveal reveal-d1" style="font-size:clamp(1.75rem,3.5vw,3rem);font-weight:700;line-height:1.1;letter-spacing:-.02em;max-width:28ch;">
      Você investe em anúncios e para de crescer quando para de pagar.
    </h2>
    <div class="prob-grid reveal reveal-d2">
      {[
        { t: 'Tráfego pago não escala sem orçamento', p: 'Cada real novo exige mais investimento. O custo por lead sobe. A margem comprime. Você está num ciclo que nunca para.', s: '+340% no CAC em 3 anos' },
        { t: 'Seu site não existe para as IAs generativas', p: 'ChatGPT, Gemini e Perplexity respondem às perguntas do seu ICP todos os dias. Se sua empresa não é citada, seus concorrentes são.', s: '73% das pesquisas B2B usam IA' },
        { t: 'SEO genérico não funciona para B2B', p: 'Agências entregam posts e backlinks. O Google pode até ranquear. Mas nenhum lead qualificado chega. Porque SEO B2B é sobre pipeline, não tráfego.', s: '89% dos leads B2B pesquisam antes' },
        { t: 'Sua empresa não é uma entidade reconhecida', p: 'Google, IAs e compradores verificam a existência da sua empresa antes de confiar. Sem Knowledge Graph, sem Wikidata — você é invisível para as IAs.', s: 'Entidade = credibilidade automática' },
      ].map((c, i) => (
        <div class="prob-card">
          <span class="prob-num">{String(i+1).padStart(2,'0')}</span>
          <p class="prob-title">{c.t}</p>
          <p class="prob-text">{c.p}</p>
          <p class="prob-stat">{c.s}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══════════ IDENTIDADE DE ENTIDADE ══════════ -->
<section class="entidade-section">
  <div class="wrap">
    <p class="sec-eye reveal" style="color:rgba(255,255,255,.35);">O conceito que separa os líderes</p>
    <h2 class="reveal reveal-d1" style="font-size:clamp(1.75rem,4vw,3.25rem);font-weight:700;line-height:1.05;letter-spacing:-.025em;color:#fff;max-width:24ch;">
      Identidade de entidade:<br/><span style="color:var(--g400);font-style:italic;">o que as IAs precisam para te recomendar</span>
    </h2>
    <p class="reveal reveal-d2" style="margin-top:1.25rem;font-size:1rem;color:rgba(255,255,255,.45);max-width:52ch;line-height:1.75;">
      Uma entidade digital é a representação verificável da sua empresa no grafo de conhecimento da internet. Google e IAs a usam para decidir quem é confiável — e quem ignorar.
    </p>

    <div class="entidade-grid">
      <!-- Empresa sem entidade -->
      <div class="entidade-card reveal">
        <span class="entidade-pill pill-invisivel">✕ Empresa sem entidade</span>
        <p class="entidade-card-title">Como as IAs veem sua empresa hoje</p>
        <div class="entidade-row">
          <span class="e-icon-no">✕</span>
          <span class="e-text-no">Não aparece no Google Knowledge Graph — não existe como entidade verificada</span>
        </div>
        <div class="entidade-row">
          <span class="e-icon-no">✕</span>
          <span class="e-text-no">Sem perfil no Wikidata — IAs não conseguem confirmar sua existência</span>
        </div>
        <div class="entidade-row">
          <span class="e-icon-no">✕</span>
          <span class="e-text-no">LinkedIn sem Schema markup — sinais de autoridade desperdiçados</span>
        </div>
        <div class="entidade-row">
          <span class="e-icon-no">✕</span>
          <span class="e-text-no">Sem menções cruzadas — empresa desconhecida para o grafo de conhecimento</span>
        </div>
        <div class="entidade-row">
          <span class="e-icon-no">✕</span>
          <span class="e-text-no">Resultado: ChatGPT ignora sua marca mesmo com bom conteúdo</span>
        </div>
      </div>

      <!-- Empresa com entidade -->
      <div class="entidade-card reveal reveal-d2" style="border-color:rgba(76,175,100,.25);">
        <span class="entidade-pill pill-verificavel">✓ Empresa com entidade — Organum</span>
        <p class="entidade-card-title">Como as IAs veem após o Método ORGANUM</p>
        <div class="entidade-row">
          <span class="e-icon-yes">✓</span>
          <span class="e-text-yes"><strong>Knowledge Graph ativo</strong> — Google confirma sua empresa como entidade real</span>
        </div>
        <div class="entidade-row">
          <span class="e-icon-yes">✓</span>
          <span class="e-text-yes"><strong>Wikidata estruturado</strong> — IAs verificam e reconhecem sua marca automaticamente</span>
        </div>
        <div class="entidade-row">
          <span class="e-icon-yes">✓</span>
          <span class="e-text-yes"><strong>Schema Organization + Person</strong> — autoridade do fundador ligada à empresa</span>
        </div>
        <div class="entidade-row">
          <span class="e-icon-yes">✓</span>
          <span class="e-text-yes"><strong>sameAs cruzados</strong> — LinkedIn, site, Wikidata e portais confirmam a mesma entidade</span>
        </div>
        <div class="entidade-row">
          <span class="e-icon-yes">✓</span>
          <span class="e-text-yes"><strong>Resultado: HunterHunter citada pelo ChatGPT e Perplexity</strong> em 90 dias</span>
        </div>
      </div>
    </div>

    <!-- Diagrama SVG da entidade -->
    <div class="reveal reveal-d3" style="margin-top:3rem;background:rgba(255,255,255,.02);border:1px solid rgba(255,255,255,.06);padding:2.5rem;">
      <p style="font-size:.65rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:rgba(255,255,255,.25);margin-bottom:1.5rem;text-align:center;">DIAGRAMA DE ENTIDADE — como a Organum constrói a sua</p>
      <svg id="entity-diagram" viewBox="0 0 640 220" fill="none" style="width:100%;max-width:680px;display:block;margin:0 auto;" aria-label="Diagrama mostrando como Knowledge Graph, Wikidata, LinkedIn, Schema e menções se conectam para formar a identidade de entidade da empresa">
        <!-- Centro: Empresa -->
        <rect id="ent-center" x="260" y="80" width="120" height="60" rx="2" fill="rgba(29,122,53,.25)" stroke="rgba(76,175,100,.5)" stroke-width="1.5" opacity="0"/>
        <text id="ent-center-t1" x="320" y="105" fill="#4caf64" font-size="11" font-weight="700" text-anchor="middle" font-family="DM Sans,sans-serif" opacity="0">SUA EMPRESA</text>
        <text id="ent-center-t2" x="320" y="122" fill="rgba(76,175,100,.6)" font-size="9" text-anchor="middle" font-family="DM Sans,sans-serif" opacity="0">Entidade verificada</text>
        <!-- Nós satélites -->
        <rect id="ent-n1" x="30" y="20" width="110" height="44" rx="2" fill="rgba(255,255,255,.04)" stroke="rgba(255,255,255,.12)" stroke-width="1" opacity="0"/>
        <text x="85" y="39" fill="rgba(255,255,255,.6)" font-size="10" font-weight="600" text-anchor="middle" font-family="DM Sans,sans-serif">Knowledge</text>
        <text x="85" y="54" fill="rgba(255,255,255,.6)" font-size="10" font-weight="600" text-anchor="middle" font-family="DM Sans,sans-serif">Graph</text>
        <rect id="ent-n2" x="500" y="20" width="110" height="44" rx="2" fill="rgba(255,255,255,.04)" stroke="rgba(255,255,255,.12)" stroke-width="1" opacity="0"/>
        <text x="555" y="39" fill="rgba(255,255,255,.6)" font-size="10" font-weight="600" text-anchor="middle" font-family="DM Sans,sans-serif">Wikidata</text>
        <text x="555" y="54" fill="rgba(255,255,255,.4)" font-size="9" text-anchor="middle" font-family="DM Sans,sans-serif">verificável</text>
        <rect id="ent-n3" x="30" y="156" width="110" height="44" rx="2" fill="rgba(255,255,255,.04)" stroke="rgba(255,255,255,.12)" stroke-width="1" opacity="0"/>
