// ── Typeform ──
const answers: Record<number, string> = {};
function goTo(step: number) {
  document.querySelectorAll('.tf-step').forEach(s => s.classList.remove('active'));
  const next = document.getElementById(`tf-${step}`);
  if (next) next.classList.add('active');
  const bar = document.getElementById('tf-bar');
  if (bar) bar.style.width = Math.round(((step - 1) / 7) * 100) + '%';
}
function showSuccess() {
  document.querySelectorAll('.tf-step').forEach(s => s.classList.remove('active'));
  const bar = document.getElementById('tf-bar');
  if (bar) bar.style.width = '100%';
  const success = document.getElementById('tf-success');
  if (success) success.classList.add('show');
}
document.querySelectorAll<HTMLElement>('.tf-opt').forEach(opt => {
  opt.addEventListener('click', () => {
    const step = parseInt(opt.dataset.step || '0');
    document.querySelectorAll<HTMLElement>(`.tf-opt[data-step="${step}"]`).forEach(o => o.classList.remove('selected'));
    opt.classList.add('selected');
    answers[step] = opt.textContent || '';
    const nextBtn = document.getElementById(`tf-next-${step}`) as HTMLButtonElement | null;
    if (nextBtn) nextBtn.disabled = false;
  });
});
for (let i = 1; i <= 5; i++) {
  const btn = document.getElementById(`tf-next-${i}`) as HTMLButtonElement | null;
  btn?.addEventListener('click', () => { if (!btn.disabled) goTo(i + 1); });
}
document.getElementById('tf-next-6')?.addEventListener('click', () => goTo(7));
document.getElementById('tf-next-7')?.addEventListener('click', () => {
  const email = (document.getElementById('tf-email') as HTMLInputElement)?.value;
  if (email && email.includes('@')) showSuccess();
  else { const el = document.getElementById('tf-email') as HTMLInputElement; if(el) el.style.borderColor='rgba(220,80,60,.6)'; }
});
document.querySelectorAll<HTMLElement>('.tf-back').forEach(btn => {
  btn.addEventListener('click', () => goTo(parseInt(btn.dataset.goto || '1')));
});
</script>

