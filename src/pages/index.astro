<script is:inline src="https://cdn.jsdelivr.net/npm/@studio-freight/lenis@1.0.42/bundled/lenis.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

<!-- ════════════════════════════════════════════
     SCRIPT PRINCIPAL
     ════════════════════════════════════════════ -->
<script is:inline>
(function(){
'use strict';

/* ─── PRÉ-LOADER (puro CSS/JS, sem GSAP) ─────────────────────────────── */
var PL  = document.getElementById('pl');
var PLO = document.getElementById('pl-logo');

function hidePL(cb){
  if(!PL) { cb(); return; }
  document.body.style.overflow = 'hidden';

  // 200ms silêncio → logo emerge
  setTimeout(function(){
    PLO.style.opacity       = '1';
    PLO.style.letterSpacing = '-0.02em';

    // 1000ms logo visível → sobe e some
    setTimeout(function(){
      PLO.style.opacity   = '0';
      PLO.style.transform = 'translateY(-80px)';

      setTimeout(function(){
        PL.style.opacity        = '0';
        PL.style.pointerEvents  = 'none';
        document.body.style.overflow = '';

        setTimeout(function(){
          PL.style.display = 'none';
          cb();
        }, 350);
      }, 500);
    }, 1000);
  }, 200);
}

/* ─── Helpers ─────────────────────────────────────────────────────────── */
function q(sel){ return document.querySelector(sel); }
function qa(sel){ return Array.from(document.querySelectorAll(sel)); }

/* ─── GSAP + Lenis init ──────────────────────────────────────────────── */
function initCine(){
  // Verificar dependências
  if(typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined'){
    console.warn('ORGANUM: GSAP não carregou — conteúdo permanece visível');
    return;
  }

  gsap.registerPlugin(ScrollTrigger);

  /* ── Lenis ──────────────────────────────────────────────────────────── */
  var lenisOk = false;
  var lenis;

  try {
    var LenisClass = window.Lenis || (typeof Lenis !== 'undefined' ? Lenis : null);
    if(LenisClass){
      lenis = new LenisClass({
        duration: 1.4,
        easing: function(t){ return Math.min(1, 1.001 - Math.pow(2, -10*t)); },
        orientation: 'vertical',
        smoothWheel: true,
        wheelMultiplier: 0.8,
        smoothTouch: false,
      });
      lenis.on('scroll', ScrollTrigger.update);
      function raf(time){ lenis.raf(time); requestAnimationFrame(raf); }
      requestAnimationFrame(raf);
      lenisOk = true;
    }
  } catch(e){ console.warn('Lenis error:', e); }

  /* ── HERO ENTRANCE ──────────────────────────────────────────────────── */
  var els = {
    eye:  q('#h-eye'),
    hl1:  q('#hl1'),
    hl2:  q('#hl2'),
    hl3:  q('#hl3'),
    hl4:  q('#hl4'),
    sub:  q('#h-sub'),
    ctas: q('#h-ctas'),
    div:  q('#hero-divider'),
    chart:q('#hero-chart-wrap'),
  };

  // Setar estado inicial ANTES de animar (não via CSS — assim sempre visível sem JS)
  gsap.set([els.eye,els.hl1,els.hl2,els.hl3,els.hl4,els.sub,els.ctas], { opacity:0, y:40 });
  gsap.set(els.div,  { scaleX:0, transformOrigin:'left center' });
  gsap.set(els.chart,{ opacity:0, x:50 });

  var heroTl = gsap.timeline({ defaults:{ ease:'power3.out' } });
  heroTl
    .to(els.eye,  { opacity:1, y:0, duration:0.8 }, 0.1)
    .to(els.hl1,  { opacity:1, y:0, duration:1.0 }, 0.2)
    .to(els.hl2,  { opacity:1, y:0, duration:1.0 }, 0.35)
    .to(els.hl3,  { opacity:1, y:0, duration:1.0 }, 0.5)
    .to(els.hl4,  { opacity:1, y:0, duration:0.9 }, 0.5)
    .to(els.sub,  { opacity:1, y:0, duration:0.8 }, 0.7)
    .to(els.ctas, { opacity:1, y:0, duration:0.7 }, 0.9)
    .to(els.div,  { scaleX:1, duration:1.4, ease:'power2.inOut' }, 1.0)
    .to(els.chart,{ opacity:1, x:0, duration:1.2 }, 0.4)
    .add(animChart, '-=0.4');

  /* ── SVG CHART ──────────────────────────────────────────────────────── */
  function animChart(){
    var orgLine  = q('#c-org-line');
    var paidLine = q('#c-paid-line');
    var orgArea  = q('#c-org-area');
    var paidArea = q('#c-paid-area');
    var dot      = q('#c-dot');
    var ring     = q('#c-ring');
    var lblOrg   = q('#c-lbl-org');
    var lblPaid  = q('#c-lbl-paid');
    if(!orgLine) return;

    gsap.timeline({ delay:0.1 })
      .to(orgLine,  { strokeDashoffset:0, duration:1.8, ease:'power2.inOut' })
      .to(paidLine, { strokeDashoffset:0, duration:1.4, ease:'power2.inOut' }, '-=1.4')
      .to([orgArea,paidArea], { opacity:1, duration:0.6 }, '-=0.8')
      .to([dot,ring,lblOrg,lblPaid], { opacity:1, duration:0.5, stagger:0.12 });
  }

  /* ── STATEMENT CLIP REVEAL ──────────────────────────────────────────── */
  var stH2 = q('#stmt-h2');
  if(stH2){
    gsap.set(stH2, { clipPath:'inset(0 100% 0 0)' });
    gsap.to(stH2, {
      clipPath:'inset(0 0% 0 0)', duration:1.4, ease:'power3.inOut',
      scrollTrigger:{ trigger:stH2, start:'top 82%', toggleActions:'play none none none' }
    });
  }

  /* ── METRICS COUNTER ────────────────────────────────────────────────── */
  qa('.metric-item').forEach(function(item){
    var numEl  = item.querySelector('.metric-num');
    var target = parseInt(item.dataset.val||'0',10);
    var suffix = item.dataset.sfx||'';
    var delay  = parseInt(item.dataset.di||'0',10) * 0.15;

    gsap.set(item, { opacity:0, y:50 });
    gsap.to(item, {
      opacity:1, y:0, duration:0.9, ease:'power3.out', delay:delay,
      scrollTrigger:{
        trigger:item, start:'top 85%', toggleActions:'play none none none',
        onEnter:function(){
          if(!numEl) return;
          var start=null, dur=1800;
          function step(ts){
            if(!start) start=ts;
            var p = Math.min((ts-start)/dur,1);
            var e = 1-Math.pow(1-p,3);
            numEl.textContent = Math.round(e*target)+suffix;
            if(p<1) requestAnimationFrame(step);
          }
          setTimeout(function(){ requestAnimationFrame(step); }, delay*1000+200);
        }
      }
    });
  });

  /* ── SCROLL REVEAL GENÉRICO ─────────────────────────────────────────── */
  qa('.scroll-reveal').forEach(function(el){
    gsap.set(el,{ opacity:0, y:50 });
    gsap.to(el,{
      opacity:1, y:0, duration:1.0, ease:'power3.out',
      scrollTrigger:{ trigger:el, start:'top 82%', toggleActions:'play none none none' }
    });
  });

  /* ── STAGGER GRUPOS ─────────────────────────────────────────────────── */
  // Agrupar .stagger-child por pai
  var groups = {};
  qa('.stagger-child').forEach(function(el){
    var key = el.parentElement ? (el.parentElement.id||el.parentElement.className) : 'r';
    if(!groups[key]) groups[key]=[];
    groups[key].push(el);
  });
  Object.keys(groups).forEach(function(k){
    var group = groups[k];
    gsap.set(group,{ opacity:0, y:40 });
    gsap.to(group,{
      opacity:1, y:0, duration:0.8, ease:'power3.out', stagger:0.1,
      scrollTrigger:{ trigger:group[0], start:'top 82%', toggleActions:'play none none none' }
    });
  });

  /* ── ENTIDADE CARDS ─────────────────────────────────────────────────── */
  var entNo  = q('#ent-no');
  var entYes = q('#ent-yes');
  if(entNo && entYes){
    gsap.set(entNo,  { opacity:0, x:-60 });
    gsap.set(entYes, { opacity:0, x:60 });
    var entST = { trigger:'.entidade-section', start:'top 75%', toggleActions:'play none none none' };
    gsap.to(entNo,  { opacity:1, x:0, duration:0.9, ease:'power3.out', scrollTrigger:entST });
    gsap.to(entYes, { opacity:1, x:0, duration:0.9, ease:'power3.out', delay:0.15, scrollTrigger:entST });
  }

  /* ── DIFERENCIAL COLUNAS ────────────────────────────────────────────── */
  var dNo  = q('#diff-no');
  var dYes = q('#diff-yes');
  if(dNo && dYes){
    gsap.set(dNo,  { opacity:0, x:-60 });
    gsap.set(dYes, { opacity:0, x:60 });
    var dST = { trigger:'.diff-section', start:'top 75%', toggleActions:'play none none none' };
    gsap.to(dNo,  { opacity:1, x:0, duration:1.0, ease:'power3.out', scrollTrigger:dST });
    gsap.to(dYes, { opacity:1, x:0, duration:1.0, ease:'power3.out', delay:0.2, scrollTrigger:dST });
  }

  /* ── FAQ STAGGER ────────────────────────────────────────────────────── */
  var faqItems = qa('.faq-item');
  gsap.set(faqItems, { opacity:0, y:20 });
  gsap.to(faqItems, {
    opacity:1, y:0, duration:0.6, ease:'power3.out', stagger:0.08,
    scrollTrigger:{ trigger:'#faq-list', start:'top 85%', toggleActions:'play none none none' }
  });

} // end initCine

/* ─── ACCORDION ───────────────────────────────────────────────────────── */
function initAccordion(){
  qa('.acc-hd').forEach(function(btn){
    btn.addEventListener('click', function(){
      var item   = btn.closest('.acc-item');
      var body   = item ? item.querySelector('.acc-body') : null;
      var inner  = body ? body.querySelector('.acc-inner') : null;
      var arr    = btn.querySelector('.acc-arr');
      var isOpen = item && item.classList.contains('open');

      // Fechar tudo
      qa('.acc-item').forEach(function(it){
        var b = it.querySelector('.acc-body');
        var a = it.querySelector('.acc-arr');
        var h = it.querySelector('.acc-hd');
        it.classList.remove('open');
        if(h) h.setAttribute('aria-expanded','false');
        if(a) a.textContent = '+';
        if(b) b.style.height='0';
      });

      // Abrir se estava fechado
      if(!isOpen && item && body && inner){
        item.classList.add('open');
        btn.setAttribute('aria-expanded','true');
        if(arr) arr.textContent = '−';

        if(typeof gsap !== 'undefined'){
          body.style.height='0';
          gsap.to(body,{ height:inner.scrollHeight, duration:0.45, ease:'power2.out',
            onComplete:function(){ body.style.height='auto'; } });
        } else {
          body.style.height = inner.scrollHeight+'px';
        }
      }
    });
  });
}

/* ─── DORES ───────────────────────────────────────────────────────────── */
function initDores(){
  var dorData = [
    { q:'"Meu site aparece no Google mas não gera leads qualificados."',
      a:'Tráfego sem intenção de compra. A Camada 03 resolve: <strong>conteúdo que captura o ICP certo</strong> no momento exato da jornada de decisão.' },
    { q:'"Quando paro os anúncios, o pipeline seca."',
      a:'Dependência total de paid. O Método ORGANUM constrói <strong>um ativo orgânico que cresce sem custo incremental</strong> mês a mês — permanentemente.' },
    { q:'"Meu concorrente aparece no ChatGPT. Eu não."',
      a:'GEO ausente. A Camada 04 posiciona sua marca como <strong>fonte confiável para as IAs generativas</strong> em 4 a 8 semanas.' },
    { q:'"Já investi em SEO antes e nunca funcionou."',
      a:'SEO genérico para B2B falha. O Método é diferente: <strong>5 camadas integradas com foco em pipeline</strong>, não em pageviews ou posições.' },
    { q:'"Minha empresa não é citada pelas IAs."',
      a:'Entidade digital ausente. A Camada 02 constrói <strong>sua presença verificável no Knowledge Graph</strong> — pré-requisito para citação por IA.' },
    { q:'"Quero crescer sem depender de tráfego pago."',
      a:'Esse é exatamente o perfil que o Método ORGANUM serve. <strong>Pipeline orgânico B2B previsível</strong> — sem anúncios, sem dependência de algoritmo.' },
  ];

  qa('.dor-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      var idx = parseInt(btn.dataset.i||'0',10);

      qa('.dor-btn').forEach(function(b){
        b.classList.remove('active');
        b.setAttribute('aria-expanded','false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-expanded','true');

      // Desktop
      var box = q('#dor-box');
      var qEl = q('#dor-q');
      var aEl = q('#dor-a');
      if(box){
        box.style.opacity='0';
        setTimeout(function(){
          if(qEl) qEl.textContent = dorData[idx].q;
          if(aEl) aEl.innerHTML  = dorData[idx].a;
          box.style.transition='opacity .25s';
          box.style.opacity='1';
        }, 180);
      }

      // Mobile inline
      qa('.dor-inline').forEach(function(el){
        el.style.display='none';
        el.setAttribute('aria-hidden','true');
      });
      var inline = document.getElementById('dor-inline-'+idx);
      if(inline){
        inline.style.display='block';
        inline.setAttribute('aria-hidden','false');
      }
    });
  });
}

/* ─── FAQ ARROW ───────────────────────────────────────────────────────── */
function initFAQ(){
  qa('.faq-item').forEach(function(d){
    var arr = d.querySelector('.faq-arr');
    d.addEventListener('toggle', function(){
      if(arr) arr.textContent = d.open ? '−' : '+';
    });
  });
}

