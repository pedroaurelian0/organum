---
import Case from '@layouts/Case.astro';

const schema = [
  {
    '@type': 'Article',
    '@id': 'https://organum.com.br/cases/hunterhunter/#article',
    headline: 'HunterHunter: de zero técnico à citação por IA em 90 dias',
    description: 'Como a Organum aplicou o Método ORGANUM na HunterHunter, empresa de headhunting B2B, gerando citações no ChatGPT e leads orgânicos qualificados sem tráfego pago.',
    author: { '@type': 'Person', '@id': 'https://organum.com.br/sobre/pedro-aureliano/#person' },
    publisher: { '@type': 'Organization', '@id': 'https://organum.com.br/#organization' },
    datePublished: '2025-03-01',
    inLanguage: 'pt-BR',
  },
  {
    '@type': 'Review',
    itemReviewed: {
      '@type': 'Service',
      name: 'Método ORGANUM — SEO orgânico B2B',
      provider: { '@type': 'Organization', '@id': 'https://organum.com.br/#organization' },
    },
    reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
    author: { '@type': 'Person', name: 'Pedro Capizane', jobTitle: 'CEO', worksFor: { '@type': 'Organization', name: 'HunterHunter', url: 'https://hunterhunter.com.br' } },
    reviewBody: 'Chegaram leads excelentes esse mês, os melhores de todo mês com certeza. Perguntei a eles como nos acharam e me falaram que pesquisaram no ChatGPT.',
  },
];
---

<Case
  title="HunterHunter: de zero técnico à citação por IA em 90 dias"
  description="Como a Organum transformou a HunterHunter em empresa citada pelo ChatGPT e Perplexity, gerando os melhores leads orgânicos da história da empresa."
  client="HunterHunter"
  sector="Headhunting B2B"
  result="Citada pelo ChatGPT · Leads qualificados de empresas americanas e chinesas"
  metrics={[
    { label: 'Posições conquistadas', value: '47+' },
    { label: 'Crescimento de tráfego', value: '340%' },
    { label: 'Para citação por IA', value: '90 dias' },
    { label: 'Custo por lead', value: 'R$ 0' },
  ]}
  breadcrumbItems={[{ name: 'Cases', url: '/cases' }, { name: 'HunterHunter', url: '/cases/hunterhunter' }]}
  schemaExtra={schema}
>

<!-- ══════════ CONTEXTO ══════════ -->
<section style="padding:clamp(3rem,7vw,5rem) clamp(1rem,4vw,3rem);">
  <div style="max-width:900px;margin-inline:auto;">

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:3rem;margin-bottom:3rem;" class="two-col">
      <div>
        <p style="font-size:.65rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--n400);display:flex;align-items:center;gap:.625rem;margin-bottom:1rem;">
          <span style="width:2px;height:18px;background:var(--g500);display:inline-block;"></span>
          A empresa
        </p>
        <h2 style="font-family:var(--serif);font-size:clamp(1.5rem,3vw,2.25rem);font-weight:700;letter-spacing:-.02em;margin-bottom:1.25rem;">Quem é a HunterHunter</h2>
        <p style="font-size:.9375rem;color:var(--n600);line-height:1.8;margin-bottom:1rem;">
          A <a href="https://hunterhunter.com.br" target="_blank" rel="noopener noreferrer" style="color:var(--g600);font-weight:500;">HunterHunter</a> é uma empresa de headhunting B2B especializada em recrutamento executivo e de profissionais de alta performance. Fundada por Pedro Capizane em Recife, a empresa conecta talentos estratégicos a organizações que precisam dos melhores profissionais para posições de liderança.
        </p>
        <p style="font-size:.9375rem;color:var(--n600);line-height:1.8;">
          Com atuação nacional e visibilidade internacional — sendo buscada por empresas americanas e chinesas — a HunterHunter precisava de uma presença digital que refletisse a qualidade e a abrangência do seu trabalho.
        </p>
      </div>
      <div>
        <p style="font-size:.65rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--n400);display:flex;align-items:center;gap:.625rem;margin-bottom:1rem;">
          <span style="width:2px;height:18px;background:var(--g500);display:inline-block;"></span>
          O desafio
        </p>
        <h2 style="font-family:var(--serif);font-size:clamp(1.5rem,3vw,2.25rem);font-weight:700;letter-spacing:-.02em;margin-bottom:1.25rem;">A situação antes da Organum</h2>
        <div style="display:flex;flex-direction:column;gap:.625rem;">
          {[
            'Core Web Vitals reprovados — LCP acima de 8s',
            'Zero Schema Markup implementado',
            '847 erros de rastreamento no Google Search Console',
            'Sem arquitetura de silos semânticos',
            'Completamente invisível para IAs generativas',
            'Nenhuma entidade verificável no Knowledge Graph',
            'Zero leads orgânicos — dependência total de indicações',
          ].map(item => (
            <div style="display:flex;align-items:flex-start;gap:.75rem;font-size:.875rem;color:var(--n500);">
              <span style="color:rgba(220,80,60,.7);font-weight:700;flex-shrink:0;">✕</span>
              {item}
            </div>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>

<!-- ══════════ AS 5 CAMADAS APLICADAS ══════════ -->
<section style="padding:clamp(3rem,7vw,5rem) clamp(1rem,4vw,3rem);background:var(--n50);">
  <div style="max-width:900px;margin-inline:auto;">
    <p style="font-size:.65rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--n400);display:flex;align-items:center;gap:.625rem;margin-bottom:1rem;">
      <span style="width:2px;height:18px;background:var(--g500);display:inline-block;"></span>
      Execução
    </p>
    <h2 style="font-family:var(--serif);font-size:clamp(1.5rem,3vw,2.25rem);font-weight:700;letter-spacing:-.02em;margin-bottom:2.5rem;">
      As 5 camadas do Método ORGANUM aplicadas
    </h2>
    <div style="display:flex;flex-direction:column;gap:0;border:1px solid var(--n200);">
      {[
        {
          n: '01', name: 'Fundação técnica', tag: 'Semanas 1–3',
          items: [
            'LCP reduzido de 8.2s para 1.1s — de reprovado a aprovado',
            'CLS zerado — eliminação de elementos instáveis',
            'Schema Organization e Person completos em JSON-LD',
            '847 erros de rastreamento corrigidos no Search Console',
            'Arquitetura de silos criada: headhunting executivo, recrutamento B2B e talentos em tecnologia',
          ],
          result: 'Core Web Vitals 100% aprovados no Google PageSpeed',
        },
        {
          n: '02', name: 'Identidade de entidade', tag: 'Semanas 3–6',
          items: [
            'Schema Organization com sameAs cruzados — LinkedIn, site e Google Business',
            'Google Business Profile verificado e otimizado',
            'Knowledge Panel ativado para "HunterHunter headhunting"',
            'Perfil Wikidata criado com dados verificáveis',
            'sameAs unificando todos os perfis como uma única entidade',
          ],
          result: 'HunterHunter reconhecida como entidade verificável pelo Google',
        },
        {
          n: '03', name: 'Conteúdo de autoridade', tag: 'Semanas 4–10',
          items: [
            '8 artigos de 2.000+ palavras nos clusters prioritários do ICP',
            'Cluster "headhunting executivo": 3 artigos com E-E-A-T documentado',
            'Cluster "recrutamento para startups": 3 artigos técnicos',
            'Cluster "talentos em tecnologia": 2 artigos comparativos',
            'FAQPage Schema em todas as páginas de serviço',
          ],
          result: '47+ novas posições no Google em 60 dias',
        },
        {
          n: '04', name: 'GEO + AEO', tag: 'Semanas 6–12',
          items: [
            'Conteúdo reestruturado para resposta direta nas queries do ICP',
            'HowTo Schema implementado para processos de headhunting',
            'Monitoramento semanal das queries no ChatGPT e Perplexity',
            'Primeiras citações verificadas na semana 8',
            'Citações consistentes estabelecidas na semana 12',
          ],
          result: 'Citada pelo ChatGPT e Perplexity para queries sobre headhunting B2B',
        },
        {
          n: '05', name: 'Digital PR', tag: 'A partir da semana 8',
          items: [
            'Menções editoriais em 3 portais de RH e gestão empresarial',
            'Artigo de Pedro Capizane citado em publicação do setor',
            'Link building editorial em portais de nicho B2B',
            'Domain Authority crescente mês a mês',
          ],
          result: 'Autoridade externa estabelecida — sinais que reforçam entidade e GEO',
        },
      ].map((layer, i, arr) => (
        <div style={`display:grid;grid-template-columns:56px 1fr;gap:1.5rem;padding:2.25rem;background:white;${i < arr.length-1 ? 'border-bottom:1px solid var(--n200);' : ''}`}>
          <div style="text-align:center;">
            <span style="font-family:var(--serif);font-size:2.25rem;font-weight:700;color:var(--n200);line-height:1;display:block;">{layer.n}</span>
            <span style="font-size:.6rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--n400);white-space:nowrap;">{layer.tag}</span>
          </div>
          <div>
            <p style="font-family:var(--serif);font-size:1.125rem;font-weight:700;color:var(--n900);margin-bottom:1rem;">{layer.name}</p>
            <div style="display:flex;flex-direction:column;gap:.5rem;margin-bottom:1rem;">
              {layer.items.map(item => (
                <div style="display:flex;align-items:flex-start;gap:.625rem;font-size:.875rem;color:var(--n600);">
                  <span style="color:var(--g500);font-weight:700;flex-shrink:0;margin-top:1px;">→</span>
                  {item}
                </div>
              ))}
            </div>
            <div style="background:var(--g50);border-left:3px solid var(--g500);padding:.75rem 1rem;">
              <p style="font-size:.8125rem;font-weight:600;color:var(--g800);">✓ {layer.result}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══════════ DEPOIMENTO ══════════ -->
<section style="padding:clamp(3rem,7vw,5rem) clamp(1rem,4vw,3rem);background:var(--n950);">
  <div style="max-width:900px;margin-inline:auto;">
    <div style="border:1px solid rgba(76,175,100,.25);padding:3rem;position:relative;">
      <span style="font-family:var(--serif);font-size:5rem;font-weight:900;color:rgba(76,175,100,.15);position:absolute;top:1rem;left:2rem;line-height:1;">"</span>
      <blockquote style="position:relative;z-index:1;">
        <p style="font-family:var(--serif);font-size:clamp(1.25rem,3vw,1.75rem);font-weight:700;color:#fff;line-height:1.35;margin-bottom:2rem;font-style:italic;">
          Chegaram leads excelentes esse mês, os melhores de todo mês com certeza. Perguntei a eles como nos acharam e me falaram que pesquisaram no ChatGPT.
        </p>
        <footer style="display:flex;align-items:center;gap:1rem;">
          <div style="width:44px;height:44px;background:rgba(76,175,100,.15);border:1px solid rgba(76,175,100,.25);border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-weight:700;color:var(--g400);font-size:.875rem;flex-shrink:0;">PC</div>
          <div>
            <p style="font-weight:700;color:#fff;font-size:.9375rem;">Pedro Capizane</p>
            <p style="font-size:.8125rem;color:rgba(255,255,255,.4);">CEO · <a href="https://hunterhunter.com.br" target="_blank" rel="noopener noreferrer" style="color:var(--g400);text-decoration:none;">HunterHunter</a></p>
          </div>
        </footer>
      </blockquote>
    </div>

    <!-- Contexto do depoimento -->
    <div style="margin-top:2rem;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07);padding:1.75rem;">
      <p style="font-size:.65rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:rgba(255,255,255,.3);margin-bottom:.75rem;">Por que isso importa</p>
      <p style="font-size:.9375rem;color:rgba(255,255,255,.5);line-height:1.75;">
        O depoimento de Pedro Capizane confirma o que o Método ORGANUM promete: leads que chegam sem nenhum investimento em anúncios, vindos de pesquisas orgânicas no ChatGPT. Não é tráfego — é <strong style="color:#fff;">pipeline qualificado gerado por IA</strong>. A HunterHunter passou a ser buscada por empresas americanas e chinesas que a encontraram durante pesquisas nas IAs generativas.
      </p>
    </div>
  </div>
</section>

<!-- ══════════ TIMELINE ══════════ -->
<section style="padding:clamp(3rem,7vw,5rem) clamp(1rem,4vw,3rem);">
  <div style="max-width:900px;margin-inline:auto;">
    <p style="font-size:.65rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--n400);display:flex;align-items:center;gap:.625rem;margin-bottom:1rem;">
      <span style="width:2px;height:18px;background:var(--g500);display:inline-block;"></span>
      Timeline
    </p>
    <h2 style="font-family:var(--serif);font-size:clamp(1.5rem,3vw,2.25rem);font-weight:700;letter-spacing:-.02em;margin-bottom:2.5rem;">De zero a citado pelo ChatGPT em 90 dias</h2>
    <div style="position:relative;padding-left:2rem;border-left:2px solid var(--n200);">
      {[
        { week: 'Semana 1', event: 'Auditoria técnica completa', desc: '847 erros identificados, Core Web Vitals reprovados, zero Schema Markup. Diagnóstico completo entregue em 48 horas.' },
        { week: 'Semana 3', event: 'Core Web Vitals aprovados', desc: 'LCP de 8.2s para 1.1s. CLS zerado. Schema Organization implementado. Google começa a reindexar com nova arquitetura.' },
        { week: 'Semana 6', event: 'Entidade verificável ativada', desc: 'Knowledge Panel ativo. Wikidata criado. sameAs cruzados. HunterHunter reconhecida como entidade verificável pelo Google e IAs.' },
        { week: 'Semana 8', event: 'Primeiras citações por IA', desc: 'ChatGPT começa a mencionar a HunterHunter em queries sobre headhunting executivo em Pernambuco. Primeiros leads orgânicos via ChatGPT.' },
        { week: 'Semana 10', event: '47+ posições no Google', desc: 'Cluster de headhunting B2B ranqueado. Tráfego orgânico crescendo 340% em relação ao baseline.' },
        { week: 'Semana 12', event: 'Citações consistentes estabelecidas', desc: 'HunterHunter citada consistentemente pelo ChatGPT e Perplexity. Leads de empresas americanas e chinesas chegando via pesquisa orgânica em IA.' },
      ].map((item, i) => (
        <div style={`padding-left:1.5rem;padding-bottom:${i < 5 ? '2rem' : '0'};position:relative;`}>
          <div style="position:absolute;left:-2.5rem;top:.25rem;width:10px;height:10px;background:var(--g500);border-radius:50%;border:2px solid white;"></div>
          <p style="font-size:.7rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--g600);margin-bottom:.25rem;">{item.week}</p>
          <p style="font-family:var(--serif);font-size:1rem;font-weight:700;color:var(--n900);margin-bottom:.375rem;">{item.event}</p>
          <p style="font-size:.875rem;color:var(--n500);line-height:1.65;">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══════════ RESULTADOS ══════════ -->
<section style="padding:clamp(3rem,7vw,5rem) clamp(1rem,4vw,3rem);background:var(--n50);">
  <div style="max-width:900px;margin-inline:auto;">
    <p style="font-size:.65rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--n400);display:flex;align-items:center;gap:.625rem;margin-bottom:1rem;">
      <span style="width:2px;height:18px;background:var(--g500);display:inline-block;"></span>
      Resultados
    </p>
    <h2 style="font-family:var(--serif);font-size:clamp(1.5rem,3vw,2.25rem);font-weight:700;letter-spacing:-.02em;margin-bottom:2rem;">O que mudou em 90 dias</h2>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;" class="results-grid">
      {[
        { before: 'LCP 8.2 segundos', after: 'LCP 1.1 segundos', label: 'Performance' },
        { before: 'Zero posições no Google', after: '47+ novas posições', label: 'Ranqueamento' },
        { before: 'Invisível para IAs', after: 'Citada pelo ChatGPT e Perplexity', label: 'GEO' },
        { before: 'Zero leads orgânicos', after: 'Leads de EUA e China via IA', label: 'Pipeline' },
      ].map(r => (
        <div style="background:white;border:1px solid var(--n200);padding:1.75rem;">
          <p style="font-size:.65rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--n400);margin-bottom:.875rem;">{r.label}</p>
          <div style="display:grid;grid-template-columns:1fr auto 1fr;gap:.75rem;align-items:center;">
            <div style="background:rgba(220,80,60,.06);border:1px solid rgba(220,80,60,.15);padding:.75rem;border-radius:2px;text-align:center;">
              <p style="font-size:.75rem;font-weight:600;color:rgba(200,70,50,.8);line-height:1.4;">{r.before}</p>
            </div>
            <span style="color:var(--g500);font-weight:700;font-size:1rem;">→</span>
            <div style="background:var(--g50);border:1px solid var(--g200);padding:.75rem;border-radius:2px;text-align:center;">
              <p style="font-size:.75rem;font-weight:700;color:var(--g800);line-height:1.4;">{r.after}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
@media (max-width: 768px) {
  .two-col { grid-template-columns: 1fr !important; }
  .results-grid { grid-template-columns: 1fr !important; }
}
</style>

</Case>
