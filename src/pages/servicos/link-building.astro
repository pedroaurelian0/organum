---
import Page from '@layouts/Page.astro';
---
<Page title="Organum — Em breve" description="Página em construção." canonical="https://organum.com.br/servicos/link-building/" breadcrumbItems={[{name:'Serviços',url:'/servicos'}]}>
<section style="background:var(--n950);padding:clamp(4rem,10vh,7rem) clamp(1rem,4vw,3rem);min-height:60vh;display:flex;align-items:center;">
  <div style="max-width:960px;margin-inline:auto;">
    <h1 style="font-family:var(--serif);font-size:clamp(2rem,5vw,4rem);font-weight:900;color:#fff;margin-bottom:1rem;">Em breve</h1>
    <p style="color:rgba(255,255,255,.5);margin-bottom:2rem;">Esta página está em construção. Enquanto isso, solicite uma auditoria gratuita.</p>
    <a href="/auditoria-gratuita" style="display:inline-flex;align-items:center;gap:.5rem;background:var(--g600);color:#fff;font-family:var(--sans);font-size:.8125rem;font-weight:600;letter-spacing:.04em;text-transform:uppercase;padding:.875rem 2rem;border-radius:2px;text-decoration:none;">Solicitar auditoria gratuita</a>
  </div>
</section>
</Page>
